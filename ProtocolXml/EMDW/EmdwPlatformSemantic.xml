        <ControlSpec id="transferMissionPlan" name="EMDW 임무계획 전송" cdm="Request.MissionPlan.Transfer">
            <Target cdm="Platform.Identifier.Numeric" />
            <Parameters>
                <QuantityProfile cdm="Mission.Identifier">
                    <Range min="0" max="4294967295" />
                    <Resolution>1</Resolution>
                </QuantityProfile>
                <CollectionProfile cdm="MissionPlan.Waypoints" minOccurs="0" maxOccurs="20">
                    <ElementProfile cdm="MissionPlan.Waypoint">
                        <QuantityProfile cdm="MissionPlan.Waypoint.Latitude">
                            <Unit>deg</Unit>
                            <Range min="-90" max="90" />
                            <Resolution>0.0000001</Resolution>
                        </QuantityProfile>
                        <QuantityProfile cdm="MissionPlan.Waypoint.Longitude">
                            <Unit>deg</Unit>
                            <Range min="-180" max="180" />
                            <Resolution>0.0000001</Resolution>
                        </QuantityProfile>
                        <QuantityProfile cdm="MissionPlan.Waypoint.Speed">
                            <Unit>knot</Unit>
                            <Range min="0" max="100" />
                            <Resolution>0.1</Resolution>
                        </QuantityProfile>
                        <QuantityProfile cdm="MissionPlan.Waypoint.Depth">
                            <Unit>cm</Unit>
                            <Resolution>1</Resolution>
                        </QuantityProfile>
                        <ValueSetProfile cdm="MissionPlan.Waypoint.Action">
                            <Values>
                                <Value name="통과" cdm="MissionPlan.Waypoint.Action.PassThrough" />
                                <Value name="대기" cdm="MissionPlan.Waypoint.Action.Wait" />
                            </Values>
                        </ValueSetProfile>
                    </ElementProfile>
                </CollectionProfile>
                <ValueSetProfile cdm="Mission.Type">
                    <Values>
                        <Value name="이동" cdm="Mission.Type.Move" />
                        <Value name="탐색" cdm="Mission.Type.Search" />
                        <Value name="식별" cdm="Mission.Type.Identify" />
                    </Values>
                </ValueSetProfile>
            </Parameters>
            <Reply cdm="Request.MissionPlan.Transfer.Response" bindRef="transferMissionPlanReply" required="true">
                <Results>
                    <ValueSetResult name="처리 결과" cdm="Command.Result">
                        <Values>
                            <Value name="성공" cdm="Command.Result.Success" />
                            <Value name="실패" cdm="Command.Result.Failure" />
                        </Values>
                    </ValueSetResult>
                    <ValueSetResult name="사유 코드" cdm="Command.Result.ReasonCode">
