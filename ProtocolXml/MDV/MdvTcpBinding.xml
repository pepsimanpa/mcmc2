            <Field name="tdsTargetBearing" converter="UInt16Scale10ToDecimalLE"/><Field name="tdsTargetRange" converter="UInt32Scale10ToDecimalLE"/><Field name="tdsTargetDepth" converter="UInt16LE"/><Field name="reserved"/><Field name="tail" converter="UInt32LE"/>
        </MonitorBinding>
