            <Field name="mdvDepth" converter="UInt16LE"/><Field name="mdvHeading" converter="UInt16Scale10ToDecimalLE"/><Field name="mdvLatitude" converter="Int32Scale10000000ToDecimalLE"/><Field name="mdvLongitude" converter="Int32Scale10000000ToDecimalLE"/><Field name="usblTime" converter="UInt32LE"/><Field name="usblAaePosX" converter="UInt32LE"/><Field name="usblAaePosY" converter="UInt32LE"/><Field name="usblAaePosZ" converter="UInt32LE"/><Field name="usblAaeSlantRange" converter="UInt32LE"/><Field name="usblAaeTargetBearing" converter="UInt16Scale10ToDecimalLE"/><Field name="usblAaeCompass" converter="UInt16Scale10ToDecimalLE"/><Field name="usblAaeRoll" converter="UInt16Scale10ToDecimalLE"/><Field name="usblAaePitch" converter="UInt16Scale10ToDecimalLE"/><Field name="usblAaeStatus" converter="UInt16LE"/>
