            <Field name="usblTime" converter="UInt32LE"/><Field name="usblAaePosX" converter="UInt32LE"/><Field name="usblAaePosY" converter="UInt32LE"/><Field name="usblAaePosZ" converter="UInt32LE"/><Field name="usblAaeSlantRange" converter="UInt32LE"/><Field name="usblAaeTargetBearing" converter="UInt16Scale10ToDecimalLE"/><Field name="usblAaeCompass" converter="UInt16Scale10ToDecimalLE"/><Field name="usblAaeRoll" converter="UInt16Scale10ToDecimalLE"/><Field name="usblAaePitch" converter="UInt16Scale10ToDecimalLE"/><Field name="usblAaeStatus" converter="UInt16LE"/><Field name="tdsTargetBearing" converter="UInt16Scale10ToDecimalLE"/><Field name="tdsTargetRange" converter="UInt32Scale10ToDecimalLE"/><Field name="tdsTargetDepth" converter="UInt16LE"/><Field name="reserved"/><Field name="tail" converter="UInt32LE"/>
        </MonitorBinding>
        <MonitorBinding semantic_id="usblTracking">
