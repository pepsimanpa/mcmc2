ec><QuantitySpec id="usblAaePitch" name="USBL Pitch" cdm="Navigation.USBL.AAE.Pitch"><Unit>deg</Unit><Range min="0" max="359.9"/><Resolution>0.1</Resolution></QuantitySpec><QuantitySpec id="usblAaeStatus" name="USBL 상태" cdm="Navigation.USBL.AAE.Status"><Range min="0" max="65535"/><Resolution>1</Resolution></QuantitySpec></GroupSpec><GroupSpec id="targetTracking" name="MDV TDS 표적 추적 상태" cdm="Mission.Target.Tracking"><QuantitySpec id="tdsTargetBearing" name="TDS 목표물 방위각" cdm="Mission.Target.Bearing"><Unit>deg</Unit><Range min="0" max="359.9"/><Resolution>0.1</Resolution></QuantitySpec><QuantitySpec id="tdsTargetRange" name="TDS 목표물 거리" cdm="Mission.Target.Range"><Unit>m</Unit><Range min="0" max="9999.9"/><Resolution>0.1</Resolution></QuantitySpec><QuantitySpec id="tdsTargetDepth" name="TDS 목표물 심도" cdm="Mission.Target.Depth"><Unit>cm</Unit><Resolution>1</Resolution></QuantitySpec></GroupSpec><GroupSpec id="communicationStatus" name="MDV 통신 연동 상태" cdm="Communication.Link"><ValueSetSpec id="consoleLinkStatus" name="MDV 콘솔 연동 상태" cdm="Communication.Link.Console.Status"><Values><Value cdm="Communication.Link.State.Disconnected">0</Value><Value cdm="Communication.Link.State.Connected">1</Value><Value cdm="Communication.Link.State.Unstable">2</Value></Values></ValueSetSpec><ValueSetSpec id="mdvLinkStatus" name="MDV 연동 상태" cdm="Communication.Link.Platform.Status"><Values><Value cdm="Communication.Link.State.Disconnected">0</Value><Value cdm="Communication.Link.State.Connected">1</Value><Value cdm="Communication.Link.State.Unstable">2</Value></Values></ValueSetSpec></GroupSpec><GroupSpec id="healthStatus" name="MDV 건전성 상태" cdm="Health"><ValueSetSpec id="consoleHealthStatus" name="MDV 콘솔 운용 상태" cdm="Health.Console.Status"><Values><Value cdm="Health.State.Normal">0</Value><Value cdm="Health.State.Warning">1</Value><Value cdm="Health.State.Abnormal">2</Value></Values></ValueSetSpec><ValueSetSpec id="mdvHealthStatus" name="MDV 운용 상태" cdm="Health.Platform.Status"><Values><Value cdm="Health.State.Normal">0</Value><Value cdm="Health.State.Warning">1</Value><Value cdm="Health.State.Abnormal">2</Value></Values></ValueSetSpec><QuantitySpec id="statusCode" name="상태 코드" cdm="Platform.Status.ReasonCode"><Range min="0" max="5"/><Resolution>1</Resolution></QuantitySpec></GroupSpec><GroupSpec id="operationModeStatus" name="MDV 현재 운용모드" cdm="Platform.OperationMode"><ValueSetSpec id="operationMode" name="MDV 운용모드" cdm="Platform.OperationMode"><Values><Value cdm="Platform.OperationMode.Legacy">0</Value><Value cdm="Platform.OperationMode.Autonomous">1</Value></Values></ValueSetSpec></GroupSpec><GroupSpec id="missionExecutionStatus" name="MDV 임무 수행 상태" cdm="Mission.Execution"><ValueSetSpec id="missionState" name="임무 수행 상태" cdm="Mission.Execution.State"><Values><Value cdm="Mission.Execution.State.None">0</Value><Value cdm="Mission.Execution.State.PlanReceived">1</Value><Value cdm="Mission.Execution.State.Executing">2</Value><Value cdm="Mission.Execution.State.Paused">3</Value><Value cdm="Mission.Execution.State.Completed">4</Value><Value cdm="Mission.Execution.State.Stopped">5</Value><Value cdm="Mission.Execution.State.Abnormal">6</Value></Values></ValueSetSpec><QuantitySpec id="missionId" name="임무 식별번호" cdm="Mission.Identifier"><Range min="0" max="4294967295"/><Resolution>1</Resolution></QuantitySpec><QuantitySpec id="currentWaypointIndex" name="현재 경유점 인덱스" cdm="MissionPlan.CurrentWaypointIndex"><Range min="0" max="65535"/><Resolution>1</Resolution></QuantitySpec><QuantitySpec id="waypointCount" name="전체 경유점 개수" cdm="MissionPlan.WaypointCount"><Range min="0" max="65535"/><Resolution>1</Resolution></QuantitySpec></GroupSpec><GroupSpec id="guidanceStatusInfo" name="MDV 유도 상태" cdm="Autonomy.Guidance"><ValueSetSpec id="guidanceStatus" name="유도 상태" cdm="Autonomy.Guidance.Status"><Values><Value cdm="Autonomy.Guidance.State.Normal">0</Value><Value cdm="Autonomy.Guidance.State.MissionNotStarted">1</Value><Value cdm="Autonomy.Guidance.State.MissionPaused">2</Value><Value cdm="Autonomy.Guidance.State.MissionCompleted">3</Value><Value cdm="Autonomy.Guidance.State.Fault">4</Value></Values></ValueSetSpec><QuantitySpec id="distanceToWaypoint" name="목표 경유점까지 거리" cdm="Autonomy.Guidance.DistanceToWaypoint"><Unit>m</Unit><Range min="0"/></QuantitySpec><QuantitySpec id="targetHeading" name="목표 헤딩" cdm="Autonomy.Guidance.TargetHeading"><Unit>deg</Unit><Range min="0" max="359.9"/></QuantitySpec><QuantitySpec id="targetPitch" name="목표 피치" cdm="Autonomy.Guidance.TargetPitch"><Unit>deg</Unit><Range min="-90" max="90"/></QuantitySpec></GroupSpec><GroupSpec id="transmitHeartbeat" name="MDV 하트비트 송신" cdm="Communication.Heartbeat">
            <QuantitySpec id="sourceDeviceId" name="송신장비 ID" cdm="Communication.Endpoint.Source.Identifier">
                <Range min="0" max="65535"/>
