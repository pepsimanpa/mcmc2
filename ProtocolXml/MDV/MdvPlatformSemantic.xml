                </QuantityProfile>
                <QuantityProfile cdm="Mission.Target.Depth">
                    <Unit>cm</Unit>
                    <Resolution>1</Resolution>
                </QuantityProfile>
            </Parameters>
        </ControlSpec>
    </ControlSpecs>
</PlatformSpec>
