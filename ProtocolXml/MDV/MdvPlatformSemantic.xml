    <ControlSpecs id="control">
        <ControlSpec id="stopMission" name="MDV 임무 정지" cdm="Control.Mission.Stop"><Target cdm="Platform.Identifier.Numeric"/><Parameters><QuantityProfile cdm="Mission.Identifier"><Range min="0" max="4294967295"/><Resolution>1</Resolution></QuantityProfile></Parameters><Reply cdm="Control.Mission.Stop.Response" bindRef="stopMissionReply" required="true"/></ControlSpec><ControlSpec id="startMission" name="MDV 임무 시작" cdm="Control.Mission.Start"><Target cdm="Platform.Identifier.Numeric"/><Parameters><QuantityProfile cdm="Mission.Identifier"><Range min="0" max="4294967295"/><Resolution>1</Resolution></QuantityProfile></Parameters><Reply cdm="Control.Mission.Start.Response" bindRef="startMissionReply" required="true"/></ControlSpec><ControlSpec id="pauseMission" name="MDV 임무 일시정지" cdm="Control.Mission.Pause"><Target cdm="Platform.Identifier.Numeric"/><Parameters><QuantityProfile cdm="Mission.Identifier"><Range min="0" max="4294967295"/><Resolution>1</Resolution></QuantityProfile></Parameters><Reply cdm="Control.Mission.Pause.Response" bindRef="pauseMissionReply" required="true"/></ControlSpec><ControlSpec id="resumeMission" name="MDV 임무 재개" cdm="Control.Mission.Resume"><Target cdm="Platform.Identifier.Numeric"/><Parameters><QuantityProfile cdm="Mission.Identifier"><Range min="0" max="4294967295"/><Resolution>1</Resolution></QuantityProfile></Parameters><Reply cdm="Control.Mission.Resume.Response" bindRef="resumeMissionReply" required="true"/></ControlSpec><ControlSpec id="setLegacyMode" name="MDV 레거시모드 설정" cdm="Control.Platform.OperationMode.Legacy"><Target cdm="Platform.Identifier.Numeric"/><Reply cdm="Control.Platform.OperationMode.Legacy.Response" bindRef="setLegacyModeReply" required="true"/></ControlSpec><ControlSpec id="setAutonomousMode" name="MDV 자율운항모드 설정" cdm="Control.Platform.OperationMode.Autonomous"><Target cdm="Platform.Identifier.Numeric"/><Reply cdm="Control.Platform.OperationMode.Autonomous.Response" bindRef="setAutonomousModeReply" required="true"/></ControlSpec><ControlSpec id="transferMissionPlan" name="MDV 임무계획 전송" cdm="Request.MissionPlan.Transfer">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Parameters>
                <QuantityProfile cdm="Mission.Identifier">
                    <Range min="0" max="4294967295"/>
                    <Resolution>1</Resolution>
                </QuantityProfile>
                <CollectionProfile cdm="MissionPlan.Waypoints" minOccurs="0" maxOccurs="20">
                    <ElementProfile cdm="MissionPlan.Waypoint">
                        <QuantityProfile cdm="MissionPlan.Waypoint.Latitude">
                            <Unit>deg</Unit>
                            <Range min="-90" max="90"/>
                            <Resolution>0.0000001</Resolution>
                        </QuantityProfile>
                        <QuantityProfile cdm="MissionPlan.Waypoint.Longitude">
                            <Unit>deg</Unit>
                            <Range min="-180" max="180"/>
                            <Resolution>0.0000001</Resolution>
                        </QuantityProfile>
                        <QuantityProfile cdm="MissionPlan.Waypoint.Speed">
                            <Unit>knot</Unit>
                            <Range min="0" max="100"/>
                            <Resolution>0.1</Resolution>
                        </QuantityProfile>
                        <QuantityProfile cdm="MissionPlan.Waypoint.Depth">
                            <Unit>cm</Unit>
                            <Resolution>1</Resolution>
                        </QuantityProfile>
                        <QuantityProfile cdm="MissionPlan.Waypoint.Action">
                            <Range min="0" max="1"/>
                            <Resolution>1</Resolution>
                        </QuantityProfile>
                    </ElementProfile>
                </CollectionProfile>
                <QuantityProfile cdm="Mission.Type">
                    <Range min="0" max="2"/>
                    <Resolution>1</Resolution>
                </QuantityProfile>
            </Parameters>
            <Reply cdm="Request.MissionPlan.Transfer.Response" bindRef="transferMissionPlanReply" required="true"/>
        </ControlSpec>

        <ControlSpec id="immediateEmergencyStop" name="MDV 즉시 비상정지" cdm="Control.Platform.EmergencyStop.Immediate"><Target cdm="Platform.Identifier.Numeric"/><Parameters><QuantityProfile cdm="Platform.EmergencyStop.Reason"><Range min="0" max="4"/><Resolution>1</Resolution></QuantityProfile></Parameters><Reply cdm="Control.Platform.EmergencyStop.Immediate.Response" bindRef="immediateEmergencyStopReply" required="true"/></ControlSpec><ControlSpec id="emergencyStopAndStandby" name="MDV 임무중지 후 대기" cdm="Control.Platform.EmergencyStop.StopAndStandby"><Target cdm="Platform.Identifier.Numeric"/><Parameters><QuantityProfile cdm="Platform.EmergencyStop.Reason"><Range min="0" max="4"/><Resolution>1</Resolution></QuantityProfile></Parameters><Reply cdm="Control.Platform.EmergencyStop.StopAndStandby.Response" bindRef="emergencyStopAndStandbyReply" required="true"/></ControlSpec><ControlSpec id="setTargetInformation" name="MDV 표적정보 설정" cdm="Control.Mission.TargetInformation">
            <Parameters>
                <QuantityProfile cdm="Navigation.OwnShip.Heading">
                    <Unit>deg</Unit>
                    <Range min="0" max="359.9"/>
