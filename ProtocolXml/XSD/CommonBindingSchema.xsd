<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://lignex1.com/mcmc2/umsSchema"
           xmlns="http://lignex1.com/mcmc2/umsSchema"
           elementFormDefault="qualified">

    <xs:element name="SensorBinding" type="BindingCompositionType"/>
    <xs:element name="PlatformBinding" type="BindingCompositionType"/>
    <xs:element name="PayloadBinding" type="BindingCompositionType"/>
    <xs:element name="CommBinding" type="BindingCompositionType"/>

    <xs:complexType name="BindingCompositionType">
        <xs:sequence>
            <xs:element name="Monitors" type="MonitorsType" minOccurs="0"/>
            <xs:element name="Controls" type="ControlsType" minOccurs="0"/>
            <xs:element name="SensorProducts" type="SensorProductsType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MonitorsType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="MonitorBindingDDS" type="MonitorBindingDDSType"/>
            <xs:element name="MonitorBinding" type="MonitorBindingType"/>
        </xs:choice>
        <xs:attribute name="semantic_id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="ControlsType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="ControlBindingDDS" type="ControlBindingDDSType"/>
            <xs:element name="ControlBinding" type="ControlBindingType"/>
        </xs:choice>
        <xs:attribute name="semantic_id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="SensorProductsType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="ProductBinding" type="ProductBindingType"/>
        </xs:choice>
        <xs:attribute name="semantic_id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="ChannelType">
        <xs:attribute name="topicName" type="xs:string" use="required"/>
        <xs:attribute name="typeName" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="DDSChannelType">
        <xs:attribute name="topicName" type="xs:string" use="required"/>
        <xs:attribute name="typeName" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="MessageChannelType">
        <xs:attribute name="infoCode" type="xs:unsignedShort"/>
        <xs:attribute name="messageType" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="RTPChannelType"/>

    <xs:group name="ProtocolChannelChoice">
        <xs:choice>
            <xs:element name="DDSChannel" type="DDSChannelType"/>
            <xs:element name="TCPChannel" type="MessageChannelType"/>
            <xs:element name="UDPChannel" type="MessageChannelType"/>
            <xs:element name="RS422Channel" type="MessageChannelType"/>
            <xs:element name="RTPChannel" type="RTPChannelType"/>
        </xs:choice>
    </xs:group>

    <!-- Declarative wire representation. New Binding XML should prefer these over converter identifiers. -->
    <xs:simpleType name="WireDataType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="UInt8"/>
            <xs:enumeration value="Int8"/>
            <xs:enumeration value="UInt16"/>
            <xs:enumeration value="Int16"/>
            <xs:enumeration value="UInt32"/>
            <xs:enumeration value="Int32"/>
            <xs:enumeration value="UInt64"/>
            <xs:enumeration value="Int64"/>
            <xs:enumeration value="Float32"/>
            <xs:enumeration value="Float64"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="ValueMapEntryType">
        <xs:attribute name="cdm" type="xs:string" use="required"/>
        <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="ValueMapType">
        <xs:sequence>
            <xs:element name="Map" type="ValueMapEntryType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Declarative mapping from a prepared sourceField scalar value to a wire value. -->
    <xs:complexType name="SourceValueMapEntryType">
        <xs:attribute name="sourceValue" type="xs:string" use="required"/>
        <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="SourceValueMapType">
        <xs:sequence>
            <xs:element name="Map" type="SourceValueMapEntryType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SemanticSetType">
        <xs:attribute name="cdm" type="xs:string" use="required"/>
        <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="SemanticBindType">
        <xs:attribute name="cdm" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="SentinelType">
        <xs:sequence>
            <xs:element name="Set" type="SemanticSetType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="NormalBindingType">
        <xs:sequence>
            <xs:element name="Set" type="SemanticSetType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Bind" type="SemanticBindType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Legacy extension point retained only so existing AUV/USV XML remains valid during migration. -->
    <xs:complexType name="DerivedSemanticType">
        <xs:attribute name="cdm" type="xs:string" use="required"/>
        <xs:attribute name="converter" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:complexType name="FieldType">
        <xs:sequence>
            <xs:element name="ValueMap" type="ValueMapType" minOccurs="0"/>
            <xs:element name="Sentinel" type="SentinelType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Normal" type="NormalBindingType" minOccurs="0"/>
            <xs:element name="DerivedSemantic" type="DerivedSemanticType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="cdm" type="xs:string"/>
        <xs:attribute name="dataType" type="WireDataType"/>
        <xs:attribute name="scale" type="xs:decimal"/>
        <xs:attribute name="length" type="xs:positiveInteger"/>
        <xs:attribute name="format" type="xs:string"/>
        <xs:attribute name="inputUnit" type="xs:string"/>
        <xs:attribute name="outputUnit" type="xs:string"/>
        <xs:attribute name="converter" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="FixedFieldType">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="cdm" type="xs:string"/>
        <xs:attribute name="value" type="xs:string" use="required"/>
        <xs:attribute name="dataType" type="WireDataType"/>
        <xs:attribute name="length" type="xs:positiveInteger"/>
        <xs:attribute name="format" type="xs:string"/>
        <xs:attribute name="converter" type="xs:string"/>
    </xs:complexType>

    <!-- OM prepares sourceField values. Binding only maps prepared values to wire representation. -->
    <xs:complexType name="DerivedFieldType">
        <xs:sequence>
            <xs:element name="ValueMap" type="ValueMapType" minOccurs="0"/>
            <xs:element name="SourceValueMap" type="SourceValueMapType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="cdm" type="xs:string"/>
        <xs:attribute name="sourceField" type="xs:string" use="required"/>
        <xs:attribute name="dataType" type="WireDataType"/>
        <xs:attribute name="scale" type="xs:decimal"/>
        <xs:attribute name="length" type="xs:positiveInteger"/>
        <xs:attribute name="format" type="xs:string"/>
        <xs:attribute name="converter" type="xs:string"/>
    </xs:complexType>

    <xs:simpleType name="ByteOrderType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="little"/>
            <xs:enumeration value="big"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="BitMemberType">
        <xs:sequence>
            <xs:element name="ValueMap" type="ValueMapType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="cdm" type="xs:string"/>
        <xs:attribute name="sourceField" type="xs:string"/>
        <xs:attribute name="offset" type="xs:nonNegativeInteger" use="required"/>
        <xs:attribute name="width" type="xs:positiveInteger" default="1"/>
        <xs:attribute name="fixedValue" type="xs:string"/>
        <xs:attribute name="converter" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="PackedFieldType">
        <xs:sequence>
            <xs:element name="BitMember" type="BitMemberType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="cdm" type="xs:string"/>
        <xs:attribute name="width" type="xs:positiveInteger" use="required"/>
        <!-- byteOrder is legacy override; new files inherit system/specification DataEncoding. -->
        <xs:attribute name="byteOrder" type="ByteOrderType"/>
        <xs:attribute name="defaultValue" type="xs:string" default="0"/>
        <xs:attribute name="expectedValue" type="xs:string"/>
        <xs:attribute name="expectedMask" type="xs:string"/>
        <xs:attribute name="converter" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="ElementType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="Field" type="FieldType"/>
            <xs:element name="FixedField" type="FixedFieldType"/>
            <xs:element name="DerivedField" type="DerivedFieldType"/>
            <xs:element name="PackedField" type="PackedFieldType"/>
            <xs:element name="ArrayField" type="ArrayFieldType"/>
        </xs:choice>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="cdm" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="ArrayFieldType">
        <xs:sequence>
            <xs:element name="Element" type="ElementType"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="cdm" type="xs:string"/>
        <xs:attribute name="minOccurs" type="xs:nonNegativeInteger"/>
        <xs:attribute name="maxOccurs" type="xs:string"/>
    </xs:complexType>

    <xs:group name="BindingFieldChoice">
        <xs:choice>
            <xs:element name="Field" type="FieldType"/>
            <xs:element name="FixedField" type="FixedFieldType"/>
            <xs:element name="DerivedField" type="DerivedFieldType"/>
            <xs:element name="PackedField" type="PackedFieldType"/>
            <xs:element name="ArrayField" type="ArrayFieldType"/>
        </xs:choice>
    </xs:group>

    <xs:complexType name="MatchFieldType">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="mask" type="xs:string" use="optional"/>
        <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="ProductBindingType">
        <xs:sequence>
            <xs:group ref="ProtocolChannelChoice"/>
            <xs:element name="MatchField" type="MatchFieldType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="semantic_id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="MonitorBindingDDSType">
        <xs:sequence>
            <xs:element name="Channel" type="ChannelType"/>
            <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:group ref="BindingFieldChoice"/></xs:choice>
        </xs:sequence>
        <xs:attribute name="semantic_id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="ReplyBindingType">
        <xs:sequence>
            <xs:element name="Channel" type="ChannelType"/>
            <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:group ref="BindingFieldChoice"/></xs:choice>
        </xs:sequence>
        <xs:attribute name="semantic_id" type="xs:string" use="required"/>
        <xs:attribute name="required" type="xs:boolean"/>
        <xs:attribute name="timeout" type="xs:decimal"/>
    </xs:complexType>

    <xs:complexType name="ControlBindingDDSType">
        <xs:sequence>
            <xs:element name="Channel" type="ChannelType"/>
            <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:group ref="BindingFieldChoice"/></xs:choice>
            <xs:element name="Reply" type="ReplyBindingType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="semantic_id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="MonitorBindingType">
        <xs:sequence>
            <xs:group ref="ProtocolChannelChoice"/>
            <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:group ref="BindingFieldChoice"/></xs:choice>
        </xs:sequence>
        <xs:attribute name="semantic_id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="ProtocolReplyBindingType">
        <xs:sequence>
            <xs:group ref="ProtocolChannelChoice"/>
            <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:group ref="BindingFieldChoice"/></xs:choice>
        </xs:sequence>
        <xs:attribute name="semantic_id" type="xs:string" use="required"/>
        <xs:attribute name="required" type="xs:boolean"/>
        <xs:attribute name="timeout" type="xs:decimal"/>
    </xs:complexType>

    <xs:complexType name="ControlBindingType">
        <xs:sequence>
            <xs:group ref="ProtocolChannelChoice"/>
            <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:group ref="BindingFieldChoice"/></xs:choice>
            <xs:element name="Reply" type="ProtocolReplyBindingType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="semantic_id" type="xs:string" use="required"/>
    </xs:complexType>
</xs:schema>
