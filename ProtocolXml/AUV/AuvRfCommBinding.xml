<?xml version="1.0" encoding="UTF-8"?>
<!--
    AUV RF 통신장치 자체 기능 Binding.
    AUV RF 구간은 TCP로 연동하며 모든 요청은 RF-1 Telegram, 모든 정의된 응답은 RF-2 Telegram을 공유한다.
    ControlBinding별 TCPChannel은 별도 송수신 메시지가 아니라 같은 물리 Telegram의 COMMAND/ACK 논리 뷰이다.

    공통 물리 구조
    - RF-1/INFO1: 44 bytes = HEADER 15 + INFORMATION1 25 + TAIL 4.
    - RF-2: 80 bytes = HEADER 14 + 고정 INFORMATION 62 + TAIL 4.
    - little-endian이며 COMMAND 표의 위 행을 bit0으로 해석한다.
    - RF 장치 요청은 주 기능 bit 하나와 RF_EXEC(bit31)를 결합한다.
    - COMMAND, ACK, 완료 bit, INFO_NUM, packed word와 상태 bitset은 BindingOnly이므로 cdm을 부여하지 않는다.
    - PackedField의 expectedValue는 개발자 확인용 최종 packed 값을 보존하며, expectedMask가 있으면 해당 bit만 조건으로 검사한다.
    - STAT_code bit0~4는 0=정상, 1=비정상이며 bit5/6은 DATA_LOCK/SYNC_LOCK flag 자체를 나타낸다.
    - Pre_Launch-Check는 AUV_CHECK_RESULT 계열과 동일한 자체점검 규칙으로 0=PASS, 1=FAIL을 적용한다.
    - checksum은 COUNT부터 INFORMATION 마지막 byte까지의 unsigned byte 합을 65536으로 나눈 나머지이며 UInt16 little-endian으로 전송한다.

    미확정 사항
    - TCPChannel의 messageType은 RF-1/RF-2 물리 Telegram 형식을 나타내며 별도 infoCode는 사용하지 않는다.
    - INFO_NUM은 AUV 1의 INFO1이면 1, AUV 2의 INFO1이면 4이다. converter 구현은 별도 확인이 필요하다.
    - RF-1 COUNT는 매 통신 증가값일 뿐 RF-2 COUNT와 상관관계가 정의되어 있지 않다.
    - RF-1의 2-byte ACK는 반대 방향 RF-2 COMMAND 완료 bit의 echo이며 현재 요청 COMMAND와 다른 필드이다.
    - RF_CMD_COMPLETE(bit13)=1은 RF통신장치가 해당 명령의 처리를 완료했음을 의미하며 AUV 본체 동작 완료와는 구분한다.
    - RF-2 ACK/완료 bit/Body 결과가 한 Telegram에서 동시에 유효한지 확인이 필요하다.
-->
<CommBinding xmlns="http://lignex1.com/mcmc2/umsSchema"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ./CommonBindingSchema.xsd">
    <Controls semantic_id="control">
        <!--
            Binding: configureRf
            RF-1 COMMAND=RF_CONFIG(bit25)|RF_EXEC(bit31)=0x82000000.
            RF-2 ACK=0x82000000, COMMAND.RF_CMD_COMPLETE=1, RF 설정 echo를 단일 Reply로 사용한다.
        -->
        <ControlBinding semantic_id="configureRf">
            <TCPChannel messageType="AuvRf1Telegram"/>
            <!-- RF-1 bytes 0..14 HEADER: START(4), INFO_NUM(1), COUNT(4), COMMAND(4), reverse ACK(2). -->
            <FixedField name="startByte" value="0x7E7E7E7E" dataType="UInt32"/>
            <DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" dataType="UInt8">

                <SourceValueMap>

                    <Map sourceValue="1" value="1"/>

                    <Map sourceValue="2" value="4"/>

                </SourceValueMap>

            </DerivedField>
            <DerivedField name="count" sourceField="System.Generated.Sequence" dataType="UInt32"/>
            <PackedField name="command" width="32" expectedValue="0x82000000">
                <BitMember name="RF_CONFIG" offset="25" fixedValue="1"/>
                <BitMember name="RF_EXEC" offset="31" fixedValue="1"/>
            </PackedField>
            <DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" dataType="UInt16"/>
            <!--
                RF-1 bytes 15..39 INFORMATION1:
                RESERVE(2), RF_CONF_MODE(1: 운용모드/Time Slot/UHF·L-Band 채널),
                RF_CONF_PWR(1: UHF/L-Band 출력), EDM_BATTERY(1), CH_SCAN(6), PER(2),
                STAT_code(1), RESERVE(11).
            -->
            <FixedField name="reserveInformation1" value="0" dataType="UInt8" length="2"/>
            <PackedField name="rfConfMode" width="8">
                <BitMember name="operationMode" cdm="Communication.RF.Configuration.OperationMode" offset="0" width="2">
                    <ValueMap><Map cdm="Communication.RF.Configuration.OperationMode.OneToOne" value="1"/><Map cdm="Communication.RF.Configuration.OperationMode.OneToTwo" value="2"/></ValueMap>
                </BitMember>
                <BitMember name="timeSlot" cdm="Communication.RF.Configuration.TimeSlot" offset="2" width="2">
                    <ValueMap><Map cdm="Communication.RF.Configuration.TimeSlot.Two" value="1"/><Map cdm="Communication.RF.Configuration.TimeSlot.Four" value="2"/></ValueMap>
                </BitMember>
                <BitMember name="uhfChannel" cdm="Communication.RF.Configuration.UHF.Channel" offset="4" width="2">
                    <ValueMap><Map cdm="Communication.RF.Configuration.UHF.Channel.Channel1" value="1"/><Map cdm="Communication.RF.Configuration.UHF.Channel.Channel2" value="2"/><Map cdm="Communication.RF.Configuration.UHF.Channel.Channel3" value="3"/></ValueMap>
                </BitMember>
                <BitMember name="lBandChannel" cdm="Communication.RF.Configuration.LBand.Channel" offset="6" width="2">
                    <ValueMap><Map cdm="Communication.RF.Configuration.LBand.Channel.Channel1" value="1"/><Map cdm="Communication.RF.Configuration.LBand.Channel.Channel2" value="2"/><Map cdm="Communication.RF.Configuration.LBand.Channel.Channel3" value="3"/></ValueMap>
                </BitMember>
            </PackedField>
            <PackedField name="rfConfPower" width="8">
                <BitMember name="uhfPower" cdm="Communication.RF.Configuration.UHF.Power" offset="0" width="3">
                    <ValueMap><Map cdm="Communication.RF.Configuration.UHF.Power.Off" value="1"/><Map cdm="Communication.RF.Configuration.UHF.Power.Low" value="2"/><Map cdm="Communication.RF.Configuration.UHF.Power.High" value="4"/></ValueMap>
                </BitMember>
                <BitMember name="lBandPower" cdm="Communication.RF.Configuration.LBand.Power" offset="4" width="3">
                    <ValueMap><Map cdm="Communication.RF.Configuration.LBand.Power.Off" value="1"/><Map cdm="Communication.RF.Configuration.LBand.Power.Low" value="2"/><Map cdm="Communication.RF.Configuration.LBand.Power.High" value="4"/></ValueMap>
                </BitMember>
            </PackedField>
            <FixedField name="edmBattery" value="0" dataType="UInt8"/>
            <FixedField name="channelScan" value="0" dataType="UInt8" length="6"/>
            <FixedField name="packetErrorRate" value="0" dataType="UInt8" length="2"/>
            <FixedField name="statusCode" value="0" dataType="UInt8"/>
            <FixedField name="reserveInformation1Tail" value="0" dataType="UInt8" length="11"/>
            <!-- RF-1 bytes 40..43 TAIL: CHECKSUM(2), STOP(2)=0x8181. -->
            <DerivedField name="checksum" sourceField="System.Frame.Checksum" dataType="UInt16"/>
            <FixedField name="stopByte" value="0x8181" dataType="UInt16"/>

            <Reply semantic_id="configureRfReply" required="true">
                <TCPChannel messageType="AuvRf2Telegram"/>
                <!-- RF-2 bytes 0..13 HEADER: START(4), COUNT(4), COMMAND(2), ACK(4). -->
                <FixedField name="startByte" value="0x7E7E7E7E" dataType="UInt32"/>
                <Field name="count" dataType="UInt32"/>
                <PackedField name="completionCommand" width="16" expectedValue="0x2000" expectedMask="0x2000">
                    <BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/>
                </PackedField>
                <PackedField name="ack" width="32" expectedValue="0x82000000">
                    <BitMember name="RF_CONFIG" offset="25" fixedValue="1"/>
                    <BitMember name="RF_EXEC" offset="31" fixedValue="1"/>
                </PackedField>
                <!--
                                    RF-2 bytes 14..75는 모든 응답에서 같은 62-byte Body이다.
                                    이 Reply는 bytes 64..65 RF_CONF_MODE/RF_CONF_PWR echo만 Semantic 결과로 소비한다.
                                -->
                <!-- RF-2 bytes 76..79 TAIL: CHECKSUM(2), STOP(2). -->
                <!-- RF-2 fixed Body 62 bytes. Unused fields remain Binding-only so every Reply preserves the physical byte offsets. -->
                <Field name="mspdCheck" dataType="UInt16"/>
                <Field name="inbCheck" dataType="UInt16"/>
                <Field name="accCheck" dataType="UInt16"/>
                <Field name="pcdCheck" dataType="UInt16"/>
                <Field name="mcCheck" dataType="UInt16"/>
                <Field name="rcdCheck" dataType="UInt16"/>
                <Field name="auvId" dataType="UInt8"/>
                <Field name="batteryPercent" dataType="UInt8"/>
                <Field name="gpsLatitude" dataType="Float32"/>
                <Field name="gpsLongitude" dataType="Float32"/>
                <Field name="waypointCount" dataType="UInt8"/>
                <Field name="alignmentStatus" dataType="UInt8"/>
                <Field name="integratedNavigationLatitude" dataType="Float32"/>
                <Field name="integratedNavigationLongitude" dataType="Float32"/>
                <Field name="auvDataFileCount" dataType="UInt16"/>
                <Field name="sideScanSonarFileCount" dataType="UInt16"/>
                <Field name="opticalCameraFileCount" dataType="UInt16"/>
                <Field name="acousticCameraFileCount" dataType="UInt16"/>
                <Field name="forwardLookingSonarFileCount" dataType="UInt16"/>
                <Field name="emergencyReasonMask" dataType="UInt16"/>
                <Field name="modeMask" dataType="UInt16"/>
                <Field name="reserveRf" dataType="UInt8" length="2"/>
                <Field name="preLaunchCheck" dataType="UInt16"/>
                <PackedField name="rfConfMode" width="8">
                                <BitMember name="operationMode" cdm="Communication.RF.Configuration.OperationMode" offset="0" width="2">
                                    <ValueMap><Map cdm="Communication.RF.Configuration.OperationMode.OneToOne" value="1"/><Map cdm="Communication.RF.Configuration.OperationMode.OneToTwo" value="2"/></ValueMap>
                                </BitMember>
                                <BitMember name="timeSlot" cdm="Communication.RF.Configuration.TimeSlot" offset="2" width="2">
                                    <ValueMap><Map cdm="Communication.RF.Configuration.TimeSlot.Two" value="1"/><Map cdm="Communication.RF.Configuration.TimeSlot.Four" value="2"/></ValueMap>
                                </BitMember>
                                <BitMember name="uhfChannel" cdm="Communication.RF.Configuration.UHF.Channel" offset="4" width="2">
                                    <ValueMap><Map cdm="Communication.RF.Configuration.UHF.Channel.Channel1" value="1"/><Map cdm="Communication.RF.Configuration.UHF.Channel.Channel2" value="2"/><Map cdm="Communication.RF.Configuration.UHF.Channel.Channel3" value="3"/></ValueMap>
                                </BitMember>
                                <BitMember name="lBandChannel" cdm="Communication.RF.Configuration.LBand.Channel" offset="6" width="2">
                                    <ValueMap><Map cdm="Communication.RF.Configuration.LBand.Channel.Channel1" value="1"/><Map cdm="Communication.RF.Configuration.LBand.Channel.Channel2" value="2"/><Map cdm="Communication.RF.Configuration.LBand.Channel.Channel3" value="3"/></ValueMap>
                                </BitMember>
                            </PackedField>
                <PackedField name="rfConfPower" width="8">
                                <BitMember name="uhfPower" cdm="Communication.RF.Configuration.UHF.Power" offset="0" width="3">
                                    <ValueMap><Map cdm="Communication.RF.Configuration.UHF.Power.Off" value="1"/><Map cdm="Communication.RF.Configuration.UHF.Power.Low" value="2"/><Map cdm="Communication.RF.Configuration.UHF.Power.High" value="4"/></ValueMap>
                                </BitMember>
                                <BitMember name="lBandPower" cdm="Communication.RF.Configuration.LBand.Power" offset="4" width="3">
                                    <ValueMap><Map cdm="Communication.RF.Configuration.LBand.Power.Off" value="1"/><Map cdm="Communication.RF.Configuration.LBand.Power.Low" value="2"/><Map cdm="Communication.RF.Configuration.LBand.Power.High" value="4"/></ValueMap>
                                </BitMember>
                            </PackedField>
                <Field name="edmBatteryPercent" dataType="UInt8"/>
                <Field name="uhfChannel1SignalDb" dataType="Int8"/>
                <Field name="uhfChannel2SignalDb" dataType="Int8"/>
                <Field name="uhfChannel3SignalDb" dataType="Int8"/>
                <Field name="lBandChannel1SignalDb" dataType="Int8"/>
                <Field name="lBandChannel2SignalDb" dataType="Int8"/>
                <Field name="lBandChannel3SignalDb" dataType="Int8"/>
                <Field name="uhfPacketErrorRate" dataType="UInt8"/>
                <Field name="lBandPacketErrorRate" dataType="UInt8"/>
                <Field name="statusCode" dataType="UInt8"/>
<Field name="checksum" dataType="UInt16"/>
                <FixedField name="stopByte" value="0x8181" dataType="UInt16"/>
            </Reply>
        </ControlBinding>

        <!--
            Binding: scanRfChannels
            RF-1 COMMAND=RF_CH_SCAN(bit26)|RF_EXEC=0x84000000.
            RF-2 CH_SCAN 6 bytes와 PER 2 bytes를 바이트 그룹 그대로 사용한다.
        -->
        <ControlBinding semantic_id="scanRfChannels">
            <TCPChannel messageType="AuvRf1Telegram"/>
            <!-- RF-1 bytes 0..14 HEADER. -->
            <FixedField name="startByte" value="0x7E7E7E7E" dataType="UInt32"/>
            <DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" dataType="UInt8">

                <SourceValueMap>

                    <Map sourceValue="1" value="1"/>

                    <Map sourceValue="2" value="4"/>

                </SourceValueMap>

            </DerivedField>
            <DerivedField name="count" sourceField="System.Generated.Sequence" dataType="UInt32"/>
            <PackedField name="command" width="32" expectedValue="0x84000000">
                <BitMember name="RF_CH_SCAN" offset="26" fixedValue="1"/>
                <BitMember name="RF_EXEC" offset="31" fixedValue="1"/>
            </PackedField>
            <DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" dataType="UInt16"/>
            <!-- RF-1 bytes 15..39 INFORMATION1. 스캔 요청에서 각 Body 입력값의 유효 규칙은 명시되지 않음. -->
            <FixedField name="reserveInformation1" value="0" dataType="UInt8" length="2"/>
            <FixedField name="rfConfMode" value="0"/>
            <FixedField name="rfConfPower" value="0"/>
            <FixedField name="edmBattery" value="0" dataType="UInt8"/>
            <FixedField name="channelScan" value="0" dataType="UInt8" length="6"/>
            <FixedField name="packetErrorRate" value="0" dataType="UInt8" length="2"/>
            <FixedField name="statusCode" value="0" dataType="UInt8"/>
            <FixedField name="reserveInformation1Tail" value="0" dataType="UInt8" length="11"/>
            <!-- RF-1 bytes 40..43 TAIL. -->
            <DerivedField name="checksum" sourceField="System.Frame.Checksum" dataType="UInt16"/>
            <FixedField name="stopByte" value="0x8181" dataType="UInt16"/>

            <Reply semantic_id="scanRfChannelsReply" required="true">
                <TCPChannel messageType="AuvRf2Telegram"/>
                <!-- RF-2 bytes 0..13 HEADER. -->
                <FixedField name="startByte" value="0x7E7E7E7E" dataType="UInt32"/>
                <Field name="count" dataType="UInt32"/>
                <PackedField name="completionCommand" width="16" expectedValue="0x2000" expectedMask="0x2000">
                    <BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/>
                </PackedField>
                <PackedField name="ack" width="32" expectedValue="0x84000000">
                    <BitMember name="RF_CH_SCAN" offset="26" fixedValue="1"/>
                    <BitMember name="RF_EXEC" offset="31" fixedValue="1"/>
                </PackedField>
                <!-- RF-2 bytes 67..72 CH_SCAN: UHF ch1~3, L-Band ch1~3 수신감도(dB), 각 1 byte. -->
                <!-- RF-2 bytes 73..74 PER: UHF PER, L-Band PER, 각 1 byte(0~100%). -->
                <!-- RF-2 bytes 76..79 TAIL. -->
                <!-- RF-2 fixed Body 62 bytes. Unused fields remain Binding-only so every Reply preserves the physical byte offsets. -->
                <Field name="mspdCheck" dataType="UInt16"/>
                <Field name="inbCheck" dataType="UInt16"/>
                <Field name="accCheck" dataType="UInt16"/>
                <Field name="pcdCheck" dataType="UInt16"/>
                <Field name="mcCheck" dataType="UInt16"/>
                <Field name="rcdCheck" dataType="UInt16"/>
                <Field name="auvId" dataType="UInt8"/>
                <Field name="batteryPercent" dataType="UInt8"/>
                <Field name="gpsLatitude" dataType="Float32"/>
                <Field name="gpsLongitude" dataType="Float32"/>
                <Field name="waypointCount" dataType="UInt8"/>
                <Field name="alignmentStatus" dataType="UInt8"/>
                <Field name="integratedNavigationLatitude" dataType="Float32"/>
                <Field name="integratedNavigationLongitude" dataType="Float32"/>
                <Field name="auvDataFileCount" dataType="UInt16"/>
                <Field name="sideScanSonarFileCount" dataType="UInt16"/>
                <Field name="opticalCameraFileCount" dataType="UInt16"/>
                <Field name="acousticCameraFileCount" dataType="UInt16"/>
                <Field name="forwardLookingSonarFileCount" dataType="UInt16"/>
                <Field name="emergencyReasonMask" dataType="UInt16"/>
                <Field name="modeMask" dataType="UInt16"/>
                <Field name="reserveRf" dataType="UInt8" length="2"/>
                <Field name="preLaunchCheck" dataType="UInt16"/>
                <Field name="rfConfMode" dataType="UInt8"/>
                <Field name="rfConfPower" dataType="UInt8"/>
                <Field name="edmBatteryPercent" dataType="UInt8"/>
                <Field name="uhfChannel1SignalDb" dataType="Int8" cdm="Communication.RF.ChannelScan.UHF.Channel1.ReceivedSignalLevel"/>
                <Field name="uhfChannel2SignalDb" dataType="Int8" cdm="Communication.RF.ChannelScan.UHF.Channel2.ReceivedSignalLevel"/>
                <Field name="uhfChannel3SignalDb" dataType="Int8" cdm="Communication.RF.ChannelScan.UHF.Channel3.ReceivedSignalLevel"/>
                <Field name="lBandChannel1SignalDb" dataType="Int8" cdm="Communication.RF.ChannelScan.LBand.Channel1.ReceivedSignalLevel"/>
                <Field name="lBandChannel2SignalDb" dataType="Int8" cdm="Communication.RF.ChannelScan.LBand.Channel2.ReceivedSignalLevel"/>
                <Field name="lBandChannel3SignalDb" dataType="Int8" cdm="Communication.RF.ChannelScan.LBand.Channel3.ReceivedSignalLevel"/>
                <Field name="uhfPacketErrorRate" dataType="UInt8" cdm="Communication.RF.UHF.PacketErrorRate"/>
                <Field name="lBandPacketErrorRate" dataType="UInt8" cdm="Communication.RF.LBand.PacketErrorRate"/>
                <Field name="statusCode" dataType="UInt8"/>
<Field name="checksum" dataType="UInt16"/>
                <FixedField name="stopByte" value="0x8181" dataType="UInt16"/>
            </Reply>
        </ControlBinding>

        <!--
            Binding: requestRfStatus
            RF-1 COMMAND=RF_STATUS(bit24)|RF_EXEC=0x81000000.
            RF-2의 설정/전원/채널/PER/상태 코드 영역을 한 응답으로 사용한다.
        -->
        <ControlBinding semantic_id="requestRfStatus">
            <TCPChannel messageType="AuvRf1Telegram"/>
            <!-- RF-1 bytes 0..14 HEADER. -->
            <FixedField name="startByte" value="0x7E7E7E7E" dataType="UInt32"/>
            <DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" dataType="UInt8">

                <SourceValueMap>

                    <Map sourceValue="1" value="1"/>

                    <Map sourceValue="2" value="4"/>

                </SourceValueMap>

            </DerivedField>
            <DerivedField name="count" sourceField="System.Generated.Sequence" dataType="UInt32"/>
            <PackedField name="command" width="32" expectedValue="0x81000000">
                <BitMember name="RF_STATUS" offset="24" fixedValue="1"/>
                <BitMember name="RF_EXEC" offset="31" fixedValue="1"/>
            </PackedField>
            <DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" dataType="UInt16"/>
            <!-- RF-1 bytes 15..39 INFORMATION1. 상태 요청에서 송신 Body 값의 사용 규칙은 명시되지 않음. -->
            <FixedField name="reserveInformation1" value="0" dataType="UInt8" length="2"/>
            <FixedField name="rfConfMode" value="0"/>
            <FixedField name="rfConfPower" value="0"/>
            <FixedField name="edmBattery" value="0" dataType="UInt8"/>
            <FixedField name="channelScan" value="0" dataType="UInt8" length="6"/>
            <FixedField name="packetErrorRate" value="0" dataType="UInt8" length="2"/>
            <FixedField name="statusCode" value="0" dataType="UInt8"/>
            <FixedField name="reserveInformation1Tail" value="0" dataType="UInt8" length="11"/>
            <!-- RF-1 bytes 40..43 TAIL. -->
            <DerivedField name="checksum" sourceField="System.Frame.Checksum" dataType="UInt16"/>
            <FixedField name="stopByte" value="0x8181" dataType="UInt16"/>

            <Reply semantic_id="requestRfStatusReply" required="true">
                <TCPChannel messageType="AuvRf2Telegram"/>
                <!-- RF-2 bytes 0..13 HEADER. -->
                <FixedField name="startByte" value="0x7E7E7E7E" dataType="UInt32"/>
                <Field name="count" dataType="UInt32"/>
                <PackedField name="completionCommand" width="16" expectedValue="0x2000" expectedMask="0x2000">
                    <BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/>
                </PackedField>
                <PackedField name="ack" width="32" expectedValue="0x81000000">
                    <BitMember name="RF_STATUS" offset="24" fixedValue="1"/>
                    <BitMember name="RF_EXEC" offset="31" fixedValue="1"/>
                </PackedField>
                <!-- RF-2 bytes 64..66: RF_CONF_MODE, RF_CONF_PWR, EDM_BATTERY(0~100). -->
                <!-- RF-2 bytes 67..72: CH_SCAN 6개 수신감도. -->
                <!-- RF-2 bytes 73..74: UHF/L-Band PER. -->
                <!--
                                    RF-2 byte 75 STAT_code bit 그룹.
                                    bit0~4는 각 반 상태(0=정상, 1=비정상), bit5=DATA_LOCK, bit6=SYNC_LOCK, bit7=reserved.
                                    DATA_LOCK/SYNC_LOCK은 flag 자체만 표현하며 정상/비정상 의미를 추가하지 않는다.
                                -->
                <!-- RF-2 bytes 76..79 TAIL. -->
                <!-- RF-2 fixed Body 62 bytes. Unused fields remain Binding-only so every Reply preserves the physical byte offsets. -->
                <Field name="mspdCheck" dataType="UInt16"/>
                <Field name="inbCheck" dataType="UInt16"/>
                <Field name="accCheck" dataType="UInt16"/>
                <Field name="pcdCheck" dataType="UInt16"/>
                <Field name="mcCheck" dataType="UInt16"/>
                <Field name="rcdCheck" dataType="UInt16"/>
                <Field name="auvId" dataType="UInt8"/>
                <Field name="batteryPercent" dataType="UInt8"/>
                <Field name="gpsLatitude" dataType="Float32"/>
                <Field name="gpsLongitude" dataType="Float32"/>
                <Field name="waypointCount" dataType="UInt8"/>
                <Field name="alignmentStatus" dataType="UInt8"/>
                <Field name="integratedNavigationLatitude" dataType="Float32"/>
                <Field name="integratedNavigationLongitude" dataType="Float32"/>
                <Field name="auvDataFileCount" dataType="UInt16"/>
                <Field name="sideScanSonarFileCount" dataType="UInt16"/>
                <Field name="opticalCameraFileCount" dataType="UInt16"/>
                <Field name="acousticCameraFileCount" dataType="UInt16"/>
                <Field name="forwardLookingSonarFileCount" dataType="UInt16"/>
                <Field name="emergencyReasonMask" dataType="UInt16"/>
                <Field name="modeMask" dataType="UInt16"/>
                <Field name="reserveRf" dataType="UInt8" length="2"/>
                <Field name="preLaunchCheck" dataType="UInt16"/>
                <PackedField name="rfConfMode" width="8">
                                <BitMember name="operationMode" cdm="Communication.RF.Configuration.OperationMode" offset="0" width="2">
                                    <ValueMap><Map cdm="Communication.RF.Configuration.OperationMode.OneToOne" value="1"/><Map cdm="Communication.RF.Configuration.OperationMode.OneToTwo" value="2"/></ValueMap>
                                </BitMember>
                                <BitMember name="timeSlot" cdm="Communication.RF.Configuration.TimeSlot" offset="2" width="2">
                                    <ValueMap><Map cdm="Communication.RF.Configuration.TimeSlot.Two" value="1"/><Map cdm="Communication.RF.Configuration.TimeSlot.Four" value="2"/></ValueMap>
                                </BitMember>
                                <BitMember name="uhfChannel" cdm="Communication.RF.Configuration.UHF.Channel" offset="4" width="2">
                                    <ValueMap><Map cdm="Communication.RF.Configuration.UHF.Channel.Channel1" value="1"/><Map cdm="Communication.RF.Configuration.UHF.Channel.Channel2" value="2"/><Map cdm="Communication.RF.Configuration.UHF.Channel.Channel3" value="3"/></ValueMap>
                                </BitMember>
                                <BitMember name="lBandChannel" cdm="Communication.RF.Configuration.LBand.Channel" offset="6" width="2">
                                    <ValueMap><Map cdm="Communication.RF.Configuration.LBand.Channel.Channel1" value="1"/><Map cdm="Communication.RF.Configuration.LBand.Channel.Channel2" value="2"/><Map cdm="Communication.RF.Configuration.LBand.Channel.Channel3" value="3"/></ValueMap>
                                </BitMember>
                            </PackedField>
                <PackedField name="rfConfPower" width="8">
