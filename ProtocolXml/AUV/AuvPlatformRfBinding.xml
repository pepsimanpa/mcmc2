<?xml version="1.0" encoding="UTF-8"?>
<!--
    AUV 본체 기능의 RF Binding.
    AUV RF 구간은 TCP로 연동하며 요청은 RF-1 Telegram, 일반 응답은 RF-2 Telegram,
    데이터 전송 응답은 RF-3 Telegram을 사용한다.
    ControlBinding은 메시지를 새로 쪼갠 것이 아니라 동일 물리 Telegram을
    COMMAND/ACK와 INFORMATION 종류로 구분한 논리 뷰이다.

    공통 확정 규칙
    - little-endian이며 COMMAND 표의 위 행을 bit0으로 해석한다.
    - 한 번에 AUV 주 기능 bit 하나만 설정하고 RF_SEND(bit30)를 함께 설정한다.
    - INFO_NUM은 AUV 1에서 INFO1/2/3=1/2/3, AUV 2에서 4/5/6이다.
    - RF-2 ACK는 RF-1 COMMAND 전체 4-byte word와 동일하다.
    - RF-3의 'ACK' 필드는 명령 ACK가 아니라 DATA TYPE과 Start/End frame flag이다.
    - COMMAND, ACK, INFO_NUM, raw bitset과 RF-3 framing은 BindingOnly이므로 cdm을 부여하지 않는다.

    미확정 사항
    - TCPChannel의 messageType은 RF-1/RF-2/RF-3 물리 Telegram 형식을 나타내며 별도 infoCode는 사용하지 않는다.
    - INFO_NUM converter와 실제 AUV 대상 선택 방식은 adapter 구현 확인이 필요하다.
    - RF-1 COUNT와 RF-2/RF-3 COUNT 사이의 상관관계는 정의되어 있지 않다.
    - RF-2 COMMAND의 RF_CMD_COMPLETE(bit13)=1은 RF통신장치가 휴대용콘솔에서 받은 명령의 처리/전달을 완료했음을 의미한다.
    - RF_CMD_COMPLETE는 AUV 본체의 실제 동작 완료를 의미하지 않으며, AUV 본체 성공/실패 또는 동작 완료는 별도 상태로 판단해야 한다.
    - RF-2는 항상 고정 80 bytes지만 명령별로 어느 Body 필드가 유효한지 명시되지 않았다.
    - checksum은 COUNT부터 INFORMATION 마지막 byte까지의 unsigned byte 합을 65536으로 나눈 나머지이다.
    - checksum 값은 UInt16 little-endian으로 전송한다.
-->
<PlatformBinding xmlns="http://lignex1.com/mcmc2/umsSchema"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ./CommonBindingSchema.xsd">
    <Controls semantic_id="control">
        <!--
            Binding: requestAuvCheck
            RF-1 COMMAND=AUV_CHECK_Req(bit0)|RF_SEND(bit30)=0x40000001, INFORMATION3.
            RF-2 ACK=0x40000001과 AUV_CHECK_RESULT 12 bytes를 하나의 Reply로 사용한다.
        -->
        <ControlBinding semantic_id="requestAuvCheck">
            <TCPChannel messageType="AuvRf1Telegram"/>
            <!-- RF-1 bytes 0..14 HEADER: START(4), INFO_NUM(1), COUNT(4), COMMAND(4), reverse ACK(2). -->
            <FixedField name="startByte" value="0x7E7E7E7E"/>
            <DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" converter="TargetAuvToInformation3"/>
            <DerivedField name="count" sourceField="System.Generated.Sequence" converter="IncrementingUInt32LE"/>
            <PackedField name="command" width="32" byteOrder="little" expectedValue="0x40000001">
                <BitMember name="AUV_CHECK_Req" offset="0" fixedValue="1"/>
                <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
            </PackedField>
            <DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" converter="UInt16LE"/>
            <!--
                RF-1 bytes 15..39 INFORMATION3:
                AUV_ID, RC_SPEED, RC_DIRECTION, DATA TYPE, File_First, File_Final,
                EMER_LAT, EMER_LONG, BRIGHTNESS, RESERVE(8).
                점검 요청에서는 AUV_ID 외 필드의 유효값/초기화 규칙이 명시되지 않았다.
            -->
            <Field name="auvId" cdm="Platform.Identifier.Numeric"/>
            <FixedField name="remoteSpeed" value="0"/>
            <FixedField name="remoteDirection" value="0"/>
            <FixedField name="dataType" value="0"/>
            <FixedField name="fileFirst" value="0" converter="UInt16LE"/>
            <FixedField name="fileFinal" value="0" converter="UInt16LE"/>
            <FixedField name="emergencyLatitude" value="0" converter="Float32LE"/>
            <FixedField name="emergencyLongitude" value="0" converter="Float32LE"/>
            <FixedField name="brightness" value="0"/>
            <FixedField name="reserveInformation3" value="0"/>
            <!-- RF-1 bytes 40..43 TAIL: CHECKSUM(2), STOP(2)=0x8181. -->
            <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
            <FixedField name="stopByte" value="0x8181"/>

            <Reply semantic_id="requestAuvCheckReply" required="true">
                <TCPChannel messageType="AuvRf2Telegram"/>
                <!-- RF-2 bytes 0..13 HEADER: START(4), COUNT(4), COMMAND(2), ACK(4). -->
                <FixedField name="startByte" value="0x7E7E7E7E"/>
                <Field name="count" converter="UInt32LE"/>
                <!-- KEY_COMPLETE/RF_CMD_COMPLETE가 들어 있는 RF 장치용 word이며 AUV 완료 판정에는 사용하지 않는다. -->
                <PackedField name="completionCommand" width="16" byteOrder="little" expectedValue="0x2000" expectedMask="0x2000">
                    <BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/>
                </PackedField>
                <PackedField name="ack" width="32" byteOrder="little" expectedValue="0x40000001">
                    <BitMember name="AUV_CHECK_Req" offset="0" fixedValue="1"/>
                    <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
                </PackedField>
                <!--
                    RF-2 bytes 14..15 MSPD 2-byte 점검 그룹.
                    첫 byte: 모듈#1 부팅/저장매체, FLS/SSS 점검·연동, 자율제어컴퓨터/통신부 연동.
                    둘째 byte: 광학/초음파 카메라 점검·연동과 reserved.
                -->
                <Field name="mspdCheck" converter="UInt16LEBitMask"/>
                <!--
                    RF-2 bytes 16..17 INB 2-byte 점검 그룹.
                    두 byte는 메모리 및 IMU/DVL/심도계/GPS/지자기/자율제어컴퓨터 통신 연동 상태를 담는다.
                    ICD의 MSB/LSB 명칭과 실제 wire byte 대응은 확인이 필요하다.
                -->
                <Field name="inbCheck" converter="UInt16LEBitMask"/>
                <!--
                    RF-2 bytes 18..19 ACC 2-byte 점검 그룹.
                    전원제어/누수/점멸등/핑어/ACC 자체점검과 MSPD/INB/RF/UCD/추진제어기 연동 상태를 담는다.
                -->
                <Field name="accCheck" converter="UInt16LEBitMask"/>
                <!-- RF-2 bytes 20..21 PCD 그룹: BMS, 전지팩 전압·온도, 제어/BMS 연동 상태와 reserved. -->
                <Field name="pcdCheck" converter="UInt16LEBitMask"/>
                <!-- RF-2 bytes 22..23 MC 그룹: 추진제어기 온도·입력전원·전류센서와 방향타/승강타 구동기 상태. -->
                <Field name="mcCheck" converter="UInt16LEBitMask"/>
                <!-- RF-2 bytes 24..25 RCD 그룹: MCU, 모뎀/제어반, UHF/L-Band 송수신반, 전원반, 암호화반과 reserved. -->
                <Field name="rcdCheck" converter="UInt16LEBitMask"/>
                <!-- RF-2 bytes 76..79 TAIL: CHECKSUM(2), STOP(2). -->
                <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
                <FixedField name="stopByte" value="0x8181"/>
            </Reply>
        </ControlBinding>

        <!--
            Binding: transferMissionPlan
            RF-1 COMMAND=MISSION_TRANS(bit1)|RF_SEND=0x40000002, INFORMATION2.
            RF-2에는 임무계획 수신 성공/실패 전용 결과가 없어 ACK=0x40000002를 응답 식별자로 사용한다.
        -->
        <ControlBinding semantic_id="transferMissionPlan">
            <TCPChannel messageType="AuvRf1Telegram"/>
            <!-- RF-1 bytes 0..14 HEADER. INFO_NUM은 대상 AUV에 따라 2 또는 5. -->
            <FixedField name="startByte" value="0x7E7E7E7E"/>
            <DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" converter="TargetAuvToInformation2"/>
            <DerivedField name="count" sourceField="System.Generated.Sequence" converter="IncrementingUInt32LE"/>
            <PackedField name="command" width="32" byteOrder="little" expectedValue="0x40000002">
                <BitMember name="MISSION_TRANS" offset="1" fixedValue="1"/>
                <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
            </PackedField>
            <DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" converter="UInt16LE"/>
            <!--
                RF-1 bytes 15..1031 INFORMATION2:
                AUV_ID, MODE, Velocity, DEPTH, WAYPOINT count, RETURN 좌표,
                Waypoint 좌표 영역, RESERVE, ALIGN_INTERVAL, Custom1/2.
            -->
            <Field name="auvId" cdm="Platform.Identifier.Numeric"/>
            <!-- 현재 유효값: 1=광역탐색모드, 2=정밀탐색모드. 3~8은 추후 결정이므로 송신하지 않는다. -->
            <Field name="missionMode" cdm="MissionPlan.OperationMode"/>
            <Field name="velocity" cdm="MissionPlan.Speed"/>
            <Field name="depth" cdm="MissionPlan.Depth"/>
            <DerivedField name="waypointCount" cdm="MissionPlan.WaypointCount" sourceField="waypoints" converter="ArrayLengthUInt8"/>
            <Field name="returnLatitude" cdm="MissionPlan.ReturnPosition.Latitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/>
            <Field name="returnLongitude" cdm="MissionPlan.ReturnPosition.Longitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/>
            <!--
                최대 100개라면 위·경도 쌍은 800 bytes이나 ICD는 중간 영역을 '~ 992 bytes'로 표기한다.
                아래 배열은 의미 모델이며 실제 padding/추가 필드/offset은 반드시 확인해야 한다.
            -->
            <ArrayField name="waypoints" cdm="MissionPlan.Waypoints" minOccurs="0" maxOccurs="100">
                <Element name="waypoint" cdm="MissionPlan.Waypoint">
                    <Field name="latitude" cdm="MissionPlan.Waypoint.Latitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/>
                    <Field name="longitude" cdm="MissionPlan.Waypoint.Longitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/>
                </Element>
            </ArrayField>
            <FixedField name="reserveInformation2" value="0"/>
            <Field name="alignInterval" cdm="MissionPlan.AlignmentInterval"/>
            <FixedField name="custom1" value="0"/>
            <FixedField name="custom2" value="0"/>
            <!-- RF-1 bytes 1032..1035 TAIL: CHECKSUM(2), STOP(2). -->
            <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
            <FixedField name="stopByte" value="0x8181"/>

            <Reply semantic_id="transferMissionPlanReply" required="true">
                <TCPChannel messageType="AuvRf2Telegram"/>
                <!-- RF-2 bytes 0..13 HEADER. -->
                <FixedField name="startByte" value="0x7E7E7E7E"/>
                <Field name="count" converter="UInt32LE"/>
                <PackedField name="completionCommand" width="16" byteOrder="little" expectedValue="0x2000" expectedMask="0x2000">
                    <BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/>
                </PackedField>
                <PackedField name="ack" width="32" byteOrder="little" expectedValue="0x40000002">
                    <BitMember name="MISSION_TRANS" offset="1" fixedValue="1"/>
                    <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
                </PackedField>
                <!-- RF-2 bytes 14..75 고정 Body는 존재하지만 임무계획 전송 결과로 사용할 전용 필드는 정의되지 않았다. -->
                <Field name="informationBody"/>
                <!-- RF-2 bytes 76..79 TAIL. -->
                <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
                <FixedField name="stopByte" value="0x8181"/>
            </Reply>
        </ControlBinding>

        <!--
            Binding: controlAuvLocally
            RF-1 COMMAND=RC_MODE(bit2)|RF_SEND=0x40000004, INFORMATION3.
        -->
        <ControlBinding semantic_id="controlAuvLocally">
            <TCPChannel messageType="AuvRf1Telegram"/>
            <!-- RF-1 bytes 0..14 HEADER. INFO_NUM은 대상 AUV에 따라 3 또는 6. -->
            <FixedField name="startByte" value="0x7E7E7E7E"/>
            <DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" converter="TargetAuvToInformation3"/>
            <DerivedField name="count" sourceField="System.Generated.Sequence" converter="IncrementingUInt32LE"/>
            <PackedField name="command" width="32" byteOrder="little" expectedValue="0x40000004">
                <BitMember name="RC_MODE" offset="2" fixedValue="1"/>
                <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
            </PackedField>
            <DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" converter="UInt16LE"/>
            <!-- RF-1 bytes 15..39 INFORMATION3. RC_SPEED와 signed RC_DIRECTION(-15~15)을 사용한다. -->
            <Field name="auvId" cdm="Platform.Identifier.Numeric"/>
            <Field name="remoteSpeed" cdm="Platform.Motion.Speed"/>
            <Field name="remoteDirection" cdm="Platform.Motion.Direction" converter="Int8"/>
            <FixedField name="dataType" value="0"/>
            <FixedField name="fileFirst" value="0" converter="UInt16LE"/>
            <FixedField name="fileFinal" value="0" converter="UInt16LE"/>
            <FixedField name="emergencyLatitude" value="0" converter="Float32LE"/>
            <FixedField name="emergencyLongitude" value="0" converter="Float32LE"/>
            <FixedField name="brightness" value="0"/>
            <FixedField name="reserveInformation3" value="0"/>
            <!-- RF-1 bytes 40..43 TAIL. -->
            <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
            <FixedField name="stopByte" value="0x8181"/>

            <Reply semantic_id="controlAuvLocallyReply" required="true">
                <TCPChannel messageType="AuvRf2Telegram"/>
                <FixedField name="startByte" value="0x7E7E7E7E"/>
                <Field name="count" converter="UInt32LE"/>
                <PackedField name="completionCommand" width="16" byteOrder="little" expectedValue="0x2000" expectedMask="0x2000">
                    <BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/>
                </PackedField>
                <PackedField name="ack" width="32" byteOrder="little" expectedValue="0x40000004">
                    <BitMember name="RC_MODE" offset="2" fixedValue="1"/>
                    <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
                </PackedField>
                <Field name="informationBody"/>
                <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
                <FixedField name="stopByte" value="0x8181"/>
            </Reply>
        </ControlBinding>

        <!-- Binding: requestAuvStatus / Status_Chk(bit3)|RF_SEND=0x40000008, INFORMATION3. -->
        <ControlBinding semantic_id="requestAuvStatus">
            <TCPChannel messageType="AuvRf1Telegram"/>
            <FixedField name="startByte" value="0x7E7E7E7E"/>
            <DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" converter="TargetAuvToInformation3"/>
            <DerivedField name="count" sourceField="System.Generated.Sequence" converter="IncrementingUInt32LE"/>
            <PackedField name="command" width="32" byteOrder="little" expectedValue="0x40000008">
                <BitMember name="Status_Chk" offset="3" fixedValue="1"/>
                <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
            </PackedField>
            <DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" converter="UInt16LE"/>
            <Field name="auvId" cdm="Platform.Identifier.Numeric"/>
            <FixedField name="remoteSpeed" value="0"/>
            <FixedField name="remoteDirection" value="0"/>
            <FixedField name="dataType" value="0"/>
            <FixedField name="fileFirst" value="0" converter="UInt16LE"/>
            <FixedField name="fileFinal" value="0" converter="UInt16LE"/>
            <FixedField name="emergencyLatitude" value="0" converter="Float32LE"/>
            <FixedField name="emergencyLongitude" value="0" converter="Float32LE"/>
            <FixedField name="brightness" value="0"/>
            <FixedField name="reserveInformation3" value="0"/>
            <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
            <FixedField name="stopByte" value="0x8181"/>

            <Reply semantic_id="requestAuvStatusReply" required="true">
                <TCPChannel messageType="AuvRf2Telegram"/>
                <FixedField name="startByte" value="0x7E7E7E7E"/>
                <Field name="count" converter="UInt32LE"/>
                <PackedField name="completionCommand" width="16" byteOrder="little" expectedValue="0x2000" expectedMask="0x2000">
                    <BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/>
                </PackedField>
                <PackedField name="ack" width="32" byteOrder="little" expectedValue="0x40000008">
                    <BitMember name="Status_Chk" offset="3" fixedValue="1"/>
                    <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
                </PackedField>
                <Field name="auvId" cdm="Platform.Identifier.Numeric"/>
                <Field name="batteryPercent" cdm="Platform.Energy.Battery.RemainingPercent"/>
                <Field name="gpsLatitude" cdm="Navigation.GNSS.Position.Latitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/>
                <Field name="gpsLongitude" cdm="Navigation.GNSS.Position.Longitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/>
                <Field name="waypointCount" cdm="MissionPlan.WaypointCount"/>
                <Field name="alignmentStatus" cdm="Navigation.Alignment.Status"/>
                <Field name="integratedNavigationLatitude" cdm="Navigation.Integrated.Position.Latitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/>
                <Field name="integratedNavigationLongitude" cdm="Navigation.Integrated.Position.Longitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/>
                <Field name="auvDataFileCount" cdm="RecordedData.AUV.FileCount" converter="UInt16LE"/>
                <Field name="sideScanSonarFileCount" cdm="RecordedData.SideScanSonar.FileCount" converter="UInt16LE"/>
                <Field name="opticalCameraFileCount" cdm="RecordedData.OpticalCamera.FileCount" converter="UInt16LE"/>
                <Field name="acousticCameraFileCount" cdm="RecordedData.AcousticCamera.FileCount" converter="UInt16LE"/>
                <Field name="forwardLookingSonarFileCount" cdm="RecordedData.ForwardLookingSonar.FileCount" converter="UInt16LE"/>
                <!-- EOR/MODE bit 의미는 별도 bit mapping 확정 전 raw bitset으로 보존한다. -->
                <Field name="emergencyReasonMask" converter="UInt16LEBitMask"/>
                <Field name="modeMask" converter="UInt16LEBitMask"/>
                <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
                <FixedField name="stopByte" value="0x8181"/>
            </Reply>
        </ControlBinding>

        <!-- Binding: startMission / MISSION_START(bit4)|RF_SEND=0x40000010. -->
        <ControlBinding semantic_id="startMission">
            <TCPChannel messageType="AuvRf1Telegram"/>
            <FixedField name="startByte" value="0x7E7E7E7E"/>
            <DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" converter="TargetAuvToInformation3"/>
            <DerivedField name="count" sourceField="System.Generated.Sequence" converter="IncrementingUInt32LE"/>
            <PackedField name="command" width="32" byteOrder="little" expectedValue="0x40000010">
                <BitMember name="MISSION_START" offset="4" fixedValue="1"/>
                <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
            </PackedField>
            <DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" converter="UInt16LE"/>
            <Field name="auvId" cdm="Platform.Identifier.Numeric"/>
            <FixedField name="remoteSpeed" value="0"/>
            <FixedField name="remoteDirection" value="0"/>
            <FixedField name="dataType" value="0"/>
            <FixedField name="fileFirst" value="0" converter="UInt16LE"/>
            <FixedField name="fileFinal" value="0" converter="UInt16LE"/>
            <FixedField name="emergencyLatitude" value="0" converter="Float32LE"/>
            <FixedField name="emergencyLongitude" value="0" converter="Float32LE"/>
            <FixedField name="brightness" value="0"/>
            <FixedField name="reserveInformation3" value="0"/>
            <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
            <FixedField name="stopByte" value="0x8181"/>
            <Reply semantic_id="startMissionReply" required="true">
                <TCPChannel messageType="AuvRf2Telegram"/>
                <FixedField name="startByte" value="0x7E7E7E7E"/>
                <Field name="count" converter="UInt32LE"/>
                <PackedField name="completionCommand" width="16" byteOrder="little" expectedValue="0x2000" expectedMask="0x2000">
                    <BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/>
                </PackedField>
                <PackedField name="ack" width="32" byteOrder="little" expectedValue="0x40000010">
                    <BitMember name="MISSION_START" offset="4" fixedValue="1"/>
                    <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
                </PackedField>
                <Field name="informationBody"/>
                <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
                <FixedField name="stopByte" value="0x8181"/>
            </Reply>
        </ControlBinding>

        <!-- Binding: emergencyReturn / EMER_RETURN(bit5)|RF_SEND=0x40000020. -->
        <ControlBinding semantic_id="emergencyReturn">
            <TCPChannel messageType="AuvRf1Telegram"/>
            <FixedField name="startByte" value="0x7E7E7E7E"/>
            <DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" converter="TargetAuvToInformation3"/>
            <DerivedField name="count" sourceField="System.Generated.Sequence" converter="IncrementingUInt32LE"/>
            <PackedField name="command" width="32" byteOrder="little" expectedValue="0x40000020">
                <BitMember name="EMER_RETURN" offset="5" fixedValue="1"/>
                <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
            </PackedField>
            <DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" converter="UInt16LE"/>
            <Field name="auvId" cdm="Platform.Identifier.Numeric"/>
            <FixedField name="remoteSpeed" value="0"/>
            <FixedField name="remoteDirection" value="0"/>
            <FixedField name="dataType" value="0"/>
            <FixedField name="fileFirst" value="0" converter="UInt16LE"/>
            <FixedField name="fileFinal" value="0" converter="UInt16LE"/>
            <Field name="emergencyLatitude" cdm="Autonomy.EmergencyReturn.Position.Latitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/>
            <Field name="emergencyLongitude" cdm="Autonomy.EmergencyReturn.Position.Longitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/>
            <FixedField name="brightness" value="0"/>
            <FixedField name="reserveInformation3" value="0"/>
            <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
            <FixedField name="stopByte" value="0x8181"/>
