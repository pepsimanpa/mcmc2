<?xml version="1.0" encoding="UTF-8"?>
<!--
    AUV 본체 기능의 RF Binding.
    AUV RF 구간은 TCP로 연동하며 요청은 RF-1 Telegram, 일반 응답은 RF-2 Telegram,
    데이터 전송 응답은 RF-3 Telegram을 사용한다.
    ControlBinding은 메시지를 새로 쪼갠 것이 아니라 동일 물리 Telegram을
    COMMAND/ACK와 INFORMATION 종류로 구분한 논리 뷰이다.

    공통 확정 규칙
    - little-endian이며 COMMAND 표의 위 행을 bit0으로 해석한다.
    - 한 번에 AUV 주 기능 bit 하나만 설정하고 RF_SEND(bit30)를 함께 설정한다.
    - INFO_NUM은 AUV 1에서 INFO1/2/3=1/2/3, AUV 2에서 4/5/6이다.
    - RF-2 ACK는 RF-1 COMMAND 전체 4-byte word와 동일하다.
    - RF-3의 'ACK' 필드는 명령 ACK가 아니라 DATA TYPE과 Start/End frame flag이다.
    - COMMAND, ACK, INFO_NUM, packed word와 RF-3 framing은 BindingOnly이므로 cdm을 부여하지 않는다.
    - PackedField의 expectedValue는 개발자 확인용 최종 packed 값을 보존하며, expectedMask가 있으면 해당 bit만 조건으로 검사한다.
    - AUV_CHECK_RESULT 점검 bit는 AUV_CHECK_RESULT_L과 동일 계열로 0=PASS, 1=FAIL을 적용한다.
    - EOR bit는 0=미발생, 1=해당 비상종료 조건 발생, MODE bit는 0=비활성, 1=활성으로 해석한다.

    미확정 사항
    - TCPChannel의 messageType은 RF-1/RF-2/RF-3 물리 Telegram 형식을 나타내며 별도 infoCode는 사용하지 않는다.
    - INFO_NUM converter와 실제 AUV 대상 선택 방식은 adapter 구현 확인이 필요하다.
    - RF-1 COUNT와 RF-2/RF-3 COUNT 사이의 상관관계는 정의되어 있지 않다.
    - RF-2 COMMAND의 RF_CMD_COMPLETE(bit13)=1은 RF통신장치가 휴대용콘솔에서 받은 명령의 처리/전달을 완료했음을 의미한다.
    - RF_CMD_COMPLETE는 AUV 본체의 실제 동작 완료를 의미하지 않으며, AUV 본체 성공/실패 또는 동작 완료는 별도 상태로 판단해야 한다.
    - RF-2는 항상 고정 80 bytes지만 명령별로 어느 Body 필드가 유효한지 명시되지 않았다.
    - checksum은 COUNT부터 INFORMATION 마지막 byte까지의 unsigned byte 합을 65536으로 나눈 나머지이다.
    - checksum 값은 UInt16 little-endian으로 전송한다.
-->
<PlatformBinding xmlns="http://lignex1.com/mcmc2/umsSchema"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ./CommonBindingSchema.xsd">
    <Controls semantic_id="control">
        <!--
            Binding: requestAuvCheck
            RF-1 COMMAND=AUV_CHECK_Req(bit0)|RF_SEND(bit30)=0x40000001, INFORMATION3.
            RF-2 ACK=0x40000001과 AUV_CHECK_RESULT 12 bytes를 하나의 Reply로 사용한다.
        -->
        <ControlBinding semantic_id="requestAuvCheck">
            <TCPChannel messageType="AuvRf1Telegram"/>
            <!-- RF-1 bytes 0..14 HEADER: START(4), INFO_NUM(1), COUNT(4), COMMAND(4), reverse ACK(2). -->
            <FixedField name="startByte" value="0x7E7E7E7E"/>
            <DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" converter="TargetAuvToInformation3"/>
            <DerivedField name="count" sourceField="System.Generated.Sequence" converter="IncrementingUInt32LE"/>
            <PackedField name="command" width="32" byteOrder="little" expectedValue="0x40000001">
                <BitMember name="AUV_CHECK_Req" offset="0" fixedValue="1"/>
                <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
            </PackedField>
            <DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" converter="UInt16LE"/>
            <!--
                RF-1 bytes 15..39 INFORMATION3:
                AUV_ID, RC_SPEED, RC_DIRECTION, DATA TYPE, File_First, File_Final,
                EMER_LAT, EMER_LONG, BRIGHTNESS, RESERVE(8).
                점검 요청에서는 AUV_ID 외 필드의 유효값/초기화 규칙이 명시되지 않았다.
            -->
            <Field name="auvId" cdm="Platform.Identifier.Numeric"/>
            <FixedField name="remoteSpeed" value="0"/>
            <FixedField name="remoteDirection" value="0"/>
            <FixedField name="dataType" value="0"/>
            <FixedField name="fileFirst" value="0" converter="UInt16LE"/>
            <FixedField name="fileFinal" value="0" converter="UInt16LE"/>
            <FixedField name="emergencyLatitude" value="0" converter="Float32LE"/>
            <FixedField name="emergencyLongitude" value="0" converter="Float32LE"/>
            <FixedField name="brightness" value="0"/>
            <FixedField name="reserveInformation3" value="0"/>
            <!-- RF-1 bytes 40..43 TAIL: CHECKSUM(2), STOP(2)=0x8181. -->
            <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
            <FixedField name="stopByte" value="0x8181"/>

            <Reply semantic_id="requestAuvCheckReply" required="true">
                <TCPChannel messageType="AuvRf2Telegram"/>
                <FixedField name="startByte" value="0x7E7E7E7E"/>
                <Field name="count" converter="UInt32LE"/>
                <PackedField name="completionCommand" width="16" byteOrder="little" expectedValue="0x2000" expectedMask="0x2000">
                    <BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/>
                </PackedField>
                <PackedField name="ack" width="32" byteOrder="little" expectedValue="0x40000001">
                    <BitMember name="AUV_CHECK_Req" offset="0" fixedValue="1"/>
                    <BitMember name="RF_SEND" offset="30" fixedValue="1"/>
                </PackedField>
                <!-- 표의 윗행을 bit0으로 적용하며 점검 bit는 0=PASS, 1=FAIL. -->
                <PackedField name="mspdCheck" width="16" byteOrder="little">
                    <BitMember name="MissionSensorProcessorModule1Boot" offset="0"/>
                    <BitMember name="MissionSensorProcessorModule1Storage" offset="1"/>
                    <BitMember name="ForwardLookingSonarCheck" offset="2"/>
                    <BitMember name="SideScanSonarCheck" offset="3"/>
                    <BitMember name="ForwardLookingSonarConnection" offset="4"/>
                    <BitMember name="SideScanSonarConnection" offset="5"/>
                    <BitMember name="AutonomousControlComputerConnection" offset="6"/>
                    <BitMember name="CommunicationUnitConnection" offset="7"/>
                    <BitMember name="reserved8" offset="8"/>
                    <BitMember name="reserved9" offset="9"/>
                    <BitMember name="AcousticCameraCheck" offset="10"/>
                    <BitMember name="OpticalCameraCheck" offset="11"/>
                    <BitMember name="AcousticCameraConnection" offset="12"/>
                    <BitMember name="OpticalCameraConnection" offset="13"/>
                    <BitMember name="reserved14" offset="14"/>
                    <BitMember name="reserved15" offset="15"/>
                </PackedField>
                <PackedField name="inbCheck" width="16" byteOrder="little">
                    <BitMember name="MSB_reserved0" offset="0"/>
                    <BitMember name="MSB_AutonomousControlComputerCommunication" offset="1"/>
                    <BitMember name="MSB_MagneticSensorCommunication" offset="2"/>
                    <BitMember name="MSB_GPSCommunication" offset="3"/>
                    <BitMember name="MSB_DepthSensorCommunication" offset="4"/>
                    <BitMember name="MSB_DVLCommunication" offset="5"/>
                    <BitMember name="MSB_IMUCommunication" offset="6"/>
                    <BitMember name="MSB_MemoryCheck" offset="7"/>
                    <BitMember name="LSB_reserved8" offset="8"/>
                    <BitMember name="LSB_reserved9" offset="9"/>
                    <BitMember name="LSB_AutonomousControlComputerCommunication" offset="10"/>
                    <BitMember name="LSB_MagneticSensorCommunication" offset="11"/>
                    <BitMember name="LSB_GPSCommunication" offset="12"/>
                    <BitMember name="LSB_DepthSensorCommunication" offset="13"/>
                    <BitMember name="LSB_DVLCommunication" offset="14"/>
                    <BitMember name="LSB_IMUCommunication" offset="15"/>
                </PackedField>
                <PackedField name="accCheck" width="16" byteOrder="little">
                    <BitMember name="PowerControlDeviceCommunication" offset="0"/>
                    <BitMember name="LeakSensorConnection" offset="1"/>
                    <BitMember name="FlashLightCommunication" offset="2"/>
                    <BitMember name="PingerCommunication" offset="3"/>
                    <BitMember name="AutonomousControlComputerInterfaceCheck" offset="4"/>
                    <BitMember name="AutonomousControlComputer28VDCCheck" offset="5"/>
                    <BitMember name="AutonomousControlComputerMemoryCheck" offset="6"/>
                    <BitMember name="AutonomousControlComputerBootCheck" offset="7"/>
                    <BitMember name="reserved8" offset="8"/>
                    <BitMember name="FlashLightCheck" offset="9"/>
                    <BitMember name="PingerCheck" offset="10"/>
                    <BitMember name="PropulsionControllerCommunication" offset="11"/>
                    <BitMember name="UnderwaterCommunicationDeviceConnection" offset="12"/>
                    <BitMember name="RfCommunicationDeviceConnection" offset="13"/>
                    <BitMember name="IntegratedNavigationComputerCommunication" offset="14"/>
                    <BitMember name="MissionSensorProcessorCommunication" offset="15"/>
                </PackedField>
                <PackedField name="pcdCheck" width="16" byteOrder="little">
                    <BitMember name="reserved0" offset="0"/><BitMember name="reserved1" offset="1"/><BitMember name="reserved2" offset="2"/><BitMember name="reserved3" offset="3"/>
                    <BitMember name="PowerControlAndBmsConnectionCheck" offset="4"/>
                    <BitMember name="BatteryPackTemperatureCheck" offset="5"/>
                    <BitMember name="BatteryPackVoltageTemperatureBmsCheck" offset="6"/>
                    <BitMember name="BatteryBmsCheck" offset="7"/>
                    <BitMember name="reserved8" offset="8"/><BitMember name="reserved9" offset="9"/><BitMember name="reserved10" offset="10"/><BitMember name="reserved11" offset="11"/><BitMember name="reserved12" offset="12"/><BitMember name="reserved13" offset="13"/><BitMember name="reserved14" offset="14"/><BitMember name="reserved15" offset="15"/>
                </PackedField>
                <PackedField name="mcCheck" width="16" byteOrder="little">
                    <BitMember name="reserved0" offset="0"/><BitMember name="reserved1" offset="1"/><BitMember name="reserved2" offset="2"/><BitMember name="reserved3" offset="3"/><BitMember name="reserved4" offset="4"/>
                    <BitMember name="PropulsionControllerCurrentSensorCheck" offset="5"/>
                    <BitMember name="PropulsionControllerInputPowerCheck" offset="6"/>
                    <BitMember name="PropulsionControllerTemperatureCheck" offset="7"/>
                    <BitMember name="reserved8" offset="8"/><BitMember name="reserved9" offset="9"/><BitMember name="reserved10" offset="10"/><BitMember name="reserved11" offset="11"/>
                    <BitMember name="RightElevatorActuatorCheck" offset="12"/><BitMember name="LeftElevatorActuatorCheck" offset="13"/><BitMember name="LowerRudderActuatorCheck" offset="14"/><BitMember name="UpperRudderActuatorCheck" offset="15"/>
                </PackedField>
                <PackedField name="rcdCheck" width="16" byteOrder="little">
                    <BitMember name="reserved0" offset="0"/><BitMember name="reserved1" offset="1"/><BitMember name="EncryptionUnitCheck" offset="2"/><BitMember name="PowerUnitCheck" offset="3"/><BitMember name="LBandTransceiverCheck" offset="4"/><BitMember name="UhfTransceiverCheck" offset="5"/><BitMember name="ModemControlPanelCheck" offset="6"/><BitMember name="McuCheck" offset="7"/>
                    <BitMember name="reserved8" offset="8"/><BitMember name="reserved9" offset="9"/><BitMember name="reserved10" offset="10"/><BitMember name="reserved11" offset="11"/><BitMember name="reserved12" offset="12"/><BitMember name="reserved13" offset="13"/><BitMember name="reserved14" offset="14"/><BitMember name="reserved15" offset="15"/>
                </PackedField>
                <DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/>
                <FixedField name="stopByte" value="0x8181"/>
            </Reply>
        </ControlBinding>

        <!-- 이하 Control들은 기존 물리 정의를 유지하며 COMMAND/ACK를 PackedField로 표현한다. -->
        <ControlBinding semantic_id="transferMissionPlan">
            <TCPChannel messageType="AuvRf1Telegram"/>
            <FixedField name="startByte" value="0x7E7E7E7E"/><DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" converter="TargetAuvToInformation2"/><DerivedField name="count" sourceField="System.Generated.Sequence" converter="IncrementingUInt32LE"/>
            <PackedField name="command" width="32" byteOrder="little" expectedValue="0x40000002"><BitMember name="MISSION_TRANS" offset="1" fixedValue="1"/><BitMember name="RF_SEND" offset="30" fixedValue="1"/></PackedField>
            <DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" converter="UInt16LE"/>
            <Field name="auvId" cdm="Platform.Identifier.Numeric"/><Field name="missionMode" cdm="MissionPlan.OperationMode"/><Field name="velocity" cdm="MissionPlan.Speed"/><Field name="depth" cdm="MissionPlan.Depth"/><DerivedField name="waypointCount" cdm="MissionPlan.WaypointCount" sourceField="waypoints" converter="ArrayLengthUInt8"/><Field name="returnLatitude" cdm="MissionPlan.ReturnPosition.Latitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/><Field name="returnLongitude" cdm="MissionPlan.ReturnPosition.Longitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/>
            <ArrayField name="waypoints" cdm="MissionPlan.Waypoints" minOccurs="0" maxOccurs="100"><Element name="waypoint" cdm="MissionPlan.Waypoint"><Field name="latitude" cdm="MissionPlan.Waypoint.Latitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/><Field name="longitude" cdm="MissionPlan.Waypoint.Longitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/></Element></ArrayField><FixedField name="reserveInformation2" value="0"/><Field name="alignInterval" cdm="MissionPlan.AlignmentInterval"/><FixedField name="custom1" value="0"/><FixedField name="custom2" value="0"/><DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/><FixedField name="stopByte" value="0x8181"/>
            <Reply semantic_id="transferMissionPlanReply" required="true"><TCPChannel messageType="AuvRf2Telegram"/><FixedField name="startByte" value="0x7E7E7E7E"/><Field name="count" converter="UInt32LE"/><PackedField name="completionCommand" width="16" byteOrder="little" expectedValue="0x2000" expectedMask="0x2000"><BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/></PackedField><PackedField name="ack" width="32" byteOrder="little" expectedValue="0x40000002"><BitMember name="MISSION_TRANS" offset="1" fixedValue="1"/><BitMember name="RF_SEND" offset="30" fixedValue="1"/></PackedField><Field name="informationBody"/><DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/><FixedField name="stopByte" value="0x8181"/></Reply>
        </ControlBinding>
        <ControlBinding semantic_id="controlAuvLocally"><TCPChannel messageType="AuvRf1Telegram"/><FixedField name="startByte" value="0x7E7E7E7E"/><DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" converter="TargetAuvToInformation3"/><DerivedField name="count" sourceField="System.Generated.Sequence" converter="IncrementingUInt32LE"/><PackedField name="command" width="32" byteOrder="little" expectedValue="0x40000004"><BitMember name="RC_MODE" offset="2" fixedValue="1"/><BitMember name="RF_SEND" offset="30" fixedValue="1"/></PackedField><DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" converter="UInt16LE"/><Field name="auvId" cdm="Platform.Identifier.Numeric"/><Field name="remoteSpeed" cdm="Platform.Motion.Speed"/><Field name="remoteDirection" cdm="Platform.Motion.Direction" converter="Int8"/><FixedField name="dataType" value="0"/><FixedField name="fileFirst" value="0" converter="UInt16LE"/><FixedField name="fileFinal" value="0" converter="UInt16LE"/><FixedField name="emergencyLatitude" value="0" converter="Float32LE"/><FixedField name="emergencyLongitude" value="0" converter="Float32LE"/><FixedField name="brightness" value="0"/><FixedField name="reserveInformation3" value="0"/><DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/><FixedField name="stopByte" value="0x8181"/><Reply semantic_id="controlAuvLocallyReply" required="true"><TCPChannel messageType="AuvRf2Telegram"/><FixedField name="startByte" value="0x7E7E7E7E"/><Field name="count" converter="UInt32LE"/><PackedField name="completionCommand" width="16" byteOrder="little" expectedValue="0x2000" expectedMask="0x2000"><BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/></PackedField><PackedField name="ack" width="32" byteOrder="little" expectedValue="0x40000004"><BitMember name="RC_MODE" offset="2" fixedValue="1"/><BitMember name="RF_SEND" offset="30" fixedValue="1"/></PackedField><Field name="informationBody"/><DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/><FixedField name="stopByte" value="0x8181"/></Reply></ControlBinding>
        <ControlBinding semantic_id="requestAuvStatus"><TCPChannel messageType="AuvRf1Telegram"/><FixedField name="startByte" value="0x7E7E7E7E"/><DerivedField name="informationNumber" sourceField="Platform.Identifier.Numeric" converter="TargetAuvToInformation3"/><DerivedField name="count" sourceField="System.Generated.Sequence" converter="IncrementingUInt32LE"/><PackedField name="command" width="32" byteOrder="little" expectedValue="0x40000008"><BitMember name="Status_Chk" offset="3" fixedValue="1"/><BitMember name="RF_SEND" offset="30" fixedValue="1"/></PackedField><DerivedField name="reverseCompletionAck" sourceField="System.Communication.LastReceivedCompletionCommand" converter="UInt16LE"/><Field name="auvId" cdm="Platform.Identifier.Numeric"/><FixedField name="remoteSpeed" value="0"/><FixedField name="remoteDirection" value="0"/><FixedField name="dataType" value="0"/><FixedField name="fileFirst" value="0" converter="UInt16LE"/><FixedField name="fileFinal" value="0" converter="UInt16LE"/><FixedField name="emergencyLatitude" value="0" converter="Float32LE"/><FixedField name="emergencyLongitude" value="0" converter="Float32LE"/><FixedField name="brightness" value="0"/><FixedField name="reserveInformation3" value="0"/><DerivedField name="checksum" sourceField="System.Frame.CountThroughInformation" converter="ByteSumModulo65536LE"/><FixedField name="stopByte" value="0x8181"/>
            <Reply semantic_id="requestAuvStatusReply" required="true"><TCPChannel messageType="AuvRf2Telegram"/><FixedField name="startByte" value="0x7E7E7E7E"/><Field name="count" converter="UInt32LE"/><PackedField name="completionCommand" width="16" byteOrder="little" expectedValue="0x2000" expectedMask="0x2000"><BitMember name="RF_CMD_COMPLETE" offset="13" fixedValue="1"/></PackedField><PackedField name="ack" width="32" byteOrder="little" expectedValue="0x40000008"><BitMember name="Status_Chk" offset="3" fixedValue="1"/><BitMember name="RF_SEND" offset="30" fixedValue="1"/></PackedField><Field name="auvId" cdm="Platform.Identifier.Numeric"/><Field name="batteryPercent" cdm="Platform.Energy.Battery.RemainingPercent"/><Field name="gpsLatitude" cdm="Navigation.GNSS.Position.Latitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/><Field name="gpsLongitude" cdm="Navigation.GNSS.Position.Longitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/><Field name="waypointCount" cdm="MissionPlan.WaypointCount"/><Field name="alignmentStatus" cdm="Navigation.Integrated.Alignment.Status"/><Field name="integratedNavigationLatitude" cdm="Navigation.Integrated.Position.Latitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/><Field name="integratedNavigationLongitude" cdm="Navigation.Integrated.Position.Longitude" inputUnit="rad" outputUnit="rad" converter="Float32LE"/><Field name="auvDataFileCount" cdm="RecordedData.Platform.FileCount" converter="UInt16LE"/><Field name="sideScanSonarFileCount" cdm="RecordedData.SideScanSonar.FileCount" converter="UInt16LE"/><Field name="opticalCameraFileCount" cdm="RecordedData.OpticalCamera.FileCount" converter="UInt16LE"/><Field name="acousticCameraFileCount" cdm="RecordedData.AcousticCamera.FileCount" converter="UInt16LE"/><Field name="forwardLookingSonarFileCount" cdm="RecordedData.ForwardLookingSonar.FileCount" converter="UInt16LE"/>
                <PackedField name="eor" width="16" byteOrder="little"><BitMember name="LEAK" offset="0"/><BitMember name="ROLL" offset="1"/><BitMember name="PITCH" offset="2"/><BitMember name="VEL" offset="3"/><BitMember name="COM" offset="4"/><BitMember name="PCD" offset="5"/><BitMember name="GPS" offset="6"/><BitMember name="RF_UCD" offset="7"/><BitMember name="CeilingDepth" offset="8"/><BitMember name="BT_SOC" offset="9"/><BitMember name="BT_TEMP" offset="10"/><BitMember name="BT_CO" offset="11"/><BitMember name="BT_V" offset="12"/><BitMember name="MC" offset="13"/><BitMember name="DIS" offset="14"/><BitMember name="EOM" offset="15"/></PackedField>
