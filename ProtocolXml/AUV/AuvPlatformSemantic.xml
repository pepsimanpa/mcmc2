<?xml version="1.0" encoding="UTF-8"?>
<!--
    AUV 본체 기능 Semantic.
    AUV ICD의 RF-1/RF-2/RF-3 및 UCD-1/UCD-2 Telegram을
    전송 매체와 무관한 AUV 제어 의미로 분류한다.

    확정 규칙
    - 한 제어 요청에는 주 기능 COMMAND bit를 하나만 설정한다.
    - RF 전송에서는 해당 기능 bit와 RF_SEND를 함께 사용한다.
    - RF와 UCD의 물리 필드 차이는 각 Binding에서 표현한다.
    - 공통 의미는 Platform/Health/Mission/RecordedData Core와 Underwater/Autonomy/Capability Extension으로 분류하고 AUV는 이를 조합한 Profile로 본다.
    - ICD에서 주기 Telegram을 확인할 수 없어 MonitorSpecs를 정의하지 않는다.
    - 각 Control은 의미상 Reply 하나만 가진다. Reply의 Results는 원문에서 반환 의미가 확인되는 데이터만 선언한다.
    - RF/UCD처럼 같은 Semantic Reply가 서로 다른 상세도를 제공하면 Results의 대체 결과 묶음을 required="false"로 구분한다.
    - Semantic Result는 정상/고장, 발생/미발생, 활성/비활성과 같은 논리 의미를 표현하며 물리 0/1과 bit 위치는 Binding에서 정의한다.

    미확정 사항
    - ICD에는 Reply timeout이 정의되어 있지 않으므로 timeout 속성을 임의로 넣지 않았다.
    - RF-2의 RF_CMD_COMPLETE는 RF통신장치에 보낸 명령의 RF통신장치 측 완료를 의미하며 AUV 본체 동작 완료를 의미하지 않는다.
    - UCD-2 ACK는 요청 COMMAND 식별에는 사용되지만 AUV 본체 동작 완료/성공을 직접 나타내는 필드는 확인되지 않았다.
    - 개별 Result CDM은 USV/MDV/EMDW/AUV 공통 CDM 정합성 검토 후 확정한다.
-->
<PlatformSpec xmlns="http://lignex1.com/mcmc2/umsSchema"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ./CommonSpecSchema.xsd">
    <ConstantSpecs id="constant">
        <TextConstantSpec id="productName" name="제품명" cdm="Product.Name">
            <Value>AUV Platform Interface</Value>
        </TextConstantSpec>
        <TextConstantSpec id="productDescription" name="제품 설명" cdm="Product.Description">
            <Value>Transport-independent AUV body control and reply semantic specification</Value>
        </TextConstantSpec>
    </ConstantSpecs>

    <ControlSpecs id="control">
        <!--
            AUV 점검 요청.
            RF: RF-1 INFORMATION3의 AUV_CHECK_Req + RF_SEND, RF-2의 동일 ACK와 12-byte 상세 점검 결과.
            UCD: UCD-1 AUV_CHECK_Req_L, UCD-2의 동일 ACK와 1-byte 요약 점검 결과.
            하나의 Semantic Reply를 두 Binding이 서로 다른 상세도로 구현한다.
        -->
        <ControlSpec id="requestAuvCheck" name="AUV 점검 요청" cdm="Request.Health.Check">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Reply id="requestAuvCheckReply" name="Request Auv Check Reply" cdm="Request.Health.Check.Response" bindRef="requestAuvCheckReply" required="true">
                <Results>
                    <!-- 각 bit의 물리 0/1과 정확한 offset은 Binding에서 정의한다. -->
                    <GroupResult id="detailedCheckResults" name="상세 점검 결과" required="false">
                        <GroupResult id="mSPD" name="MSPD 점검 결과">
                            <Result id="communicationInterfaceStatus" name="통신부 연동상태"/>
                            <Result id="autonomousControlComputerInterfaceStatus" name="자율제어컴퓨터 연동상태"/>
                            <Result id="sideScanSonarInterfaceStatus" name="측면주사소나 연동상태"/>
                            <Result id="forwardLookingSonarInterfaceStatus" name="전방주사소나 연동상태"/>
                            <Result id="sideScanSonarStatusCheck" name="측면주사소나 상태점검"/>
                            <Result id="forwardLookingSonarStatusCheck" name="전방주사소나 상태점검"/>
                            <Result id="missionSensorProcessorModule1StorageStatus" name="임무센서처리장치 모듈 #1 저장매체 상태"/>
                            <Result id="missionSensorProcessorModule1BootStatus" name="임무센서처리장치 모듈 #1 부팅상태"/>
                            <Result id="underwaterOpticalCameraInterfaceStatus" name="수중광학카메라 연동상태"/>
                            <Result id="underwaterAcousticCameraInterfaceStatus" name="수중초음파카메라 연동상태"/>
                            <Result id="underwaterOpticalCameraCheck" name="수중광학카메라 점검"/>
                            <Result id="underwaterAcousticCameraCheck" name="수중초음파카메라 점검"/>
                        </GroupResult>
                        <GroupResult id="iNB" name="INB 점검 결과">
                            <Result id="memoryCheck" name="메모리 점검"/>
                            <Result id="iNBMSBIMU" name="INB MSB IMU 통신연동"/>
                            <Result id="iNBMSBDVL" name="INB MSB DVL 통신연동"/>
                            <Result id="iNBMSB" name="INB MSB 심도계 통신연동"/>
                            <Result id="iNBMSBGPS" name="INB MSB GPS 통신연동"/>
                            <Result id="iNBMSB2" name="INB MSB 지자기센서 통신연동"/>
                            <Result id="iNBMSB3" name="INB MSB 자율제어컴퓨터 통신연동"/>
                            <Result id="iNBLSBIMU" name="INB LSB IMU 통신연동"/>
                            <Result id="iNBLSBDVL" name="INB LSB DVL 통신연동"/>
                            <Result id="iNBLSB" name="INB LSB 심도계 통신연동"/>
                            <Result id="iNBLSBGPS" name="INB LSB GPS 통신연동"/>
                            <Result id="iNBLSB2" name="INB LSB 지자기센서 통신연동"/>
                            <Result id="iNBLSB3" name="INB LSB 자율제어컴퓨터 통신연동"/>
                        </GroupResult>
                        <GroupResult id="aCC" name="ACC 점검 결과">
                            <Result id="autonomousControlComputerBootCheck" name="자율제어컴퓨터 BOOT 점검"/>
                            <Result id="autonomousControlComputerMemoryCheck" name="자율제어컴퓨터 메모리 점검"/>
                            <Result id="autonomousControlComputer28VdcCheck" name="자율제어컴퓨터 28VDC 점검"/>
                            <Result id="autonomousControlComputerInterfaceCheck" name="자율제어컴퓨터 인터페이스 점검"/>
                            <Result id="pingerCommunicationStatus" name="핑어 통신연동"/>
                            <Result id="flasherCommunicationStatus" name="점멸등 통신연동"/>
                            <Result id="leakSensorInterfaceStatus" name="누수센서 연동"/>
                            <Result id="powerControllerCommunicationStatus" name="전원제어장치 통신연동"/>
                            <Result id="missionSensorProcessorCommunicationStatus" name="임무센서처리장치 통신연동"/>
                            <Result id="integratedNavigationComputerCommunicationStatus" name="복합항법컴퓨터 통신연동"/>
                            <Result id="rF" name="RF 통신장치 통신연동"/>
                            <Result id="underwaterCommunicationStatus" name="수중통신장치 통신연동"/>
                            <Result id="propulsionControllerCommunicationStatus" name="추진제어기 통신연동"/>
                            <Result id="pingerSelfCheck" name="핑어 자체점검"/>
                            <Result id="flasherSelfCheck" name="점멸등 자체점검"/>
                        </GroupResult>
                        <GroupResult id="pCD" name="PCD 점검 결과">
                            <Result id="batteryBmsStatusCheck" name="전지 BMS 상태 점검"/>
                            <Result id="batteryPackVoltageTemperatureBmsCheck" name="전지팩 전압, 온도, BMS 연동상태 점검"/>
                            <Result id="batteryPackTemperatureCheck" name="전지팩 온도 점검"/>
                            <Result id="powerControllerAndBmsStatusCheck" name="전원제어장치 제어상태, BMS 연동상태 점검"/>
                        </GroupResult>
                        <GroupResult id="mC" name="MC 점검 결과">
                            <Result id="propulsionControllerTemperatureCheck" name="추진제어기 온도 점검"/>
                            <Result id="propulsionControllerInputPowerCheck" name="추진제어기 입력 전원 점검"/>
                            <Result id="propulsionControllerCurrentSensorCheck" name="추진제어기 전류 센서 점검"/>
                            <Result id="upperRudderActuatorCheck" name="상방향타 구동기 점검"/>
                            <Result id="lowerRudderActuatorCheck" name="하방향타 구동기 점검"/>
                            <Result id="portElevatorActuatorCheck" name="좌승강타 구동기 점검"/>
                            <Result id="starboardElevatorActuatorCheck" name="우승강타 구동기 점검"/>
                        </GroupResult>
                        <GroupResult id="rCD" name="RCD 점검 결과">
                            <Result id="mCU" name="MCU"/>
                            <Result id="modemControlUnit" name="모뎀 및 제어반"/>
                            <Result id="uHF" name="송수신반 UHF"/>
                            <Result id="lBand" name="송수신반 L-Band"/>
                            <Result id="powerUnit" name="전원반"/>
                            <Result id="encryptionUnit" name="암호화반"/>
                        </GroupResult>
                    </GroupResult>
                    <GroupResult id="summaryCheckResults" name="요약 점검 결과" required="false">
                        <Result id="mSSTEST" name="MSS_TEST"/>
                        <Result id="cCSTEST" name="CCS_TEST"/>
                        <Result id="nSTEST" name="NS_TEST"/>
                        <Result id="bSTEST" name="BS_TEST"/>
                        <Result id="pRSTEST" name="PRS_TEST"/>
                        <Result id="mCSTEST" name="MCS_TEST"/>
                    </GroupResult>
                </Results>
            </Reply>
        </ControlSpec>

        <!--
            AUV 임무계획 전송.
            RF-1의 MISSION_TRANS + RF_SEND와 INFORMATION2를 사용한다.
            DEPTH 필드명과 '주행 고도' 설명이 함께 기재되어 있어 정확한 기준면/부호는 확인이 필요하다.
            최대 100개 Waypoint는 좌표당 8 bytes이지만 ICD의 '~ 992 bytes' 표기 및 INFO2 총 길이와
            산술적으로 일치하지 않으므로 실제 배열/예약 영역 배치는 확인이 필요하다.
            ALIGN_INTERVAL의 단위와 범위, Custom1/Custom2의 의미는 정의되지 않았다.
            WAYPOINT count는 사용자 입력 Parameter로 중복 노출하지 않고 Waypoints collection 길이에서 파생되는 전송 지원 값으로 취급한다.
        -->
        <ControlSpec id="transferMissionPlan" name="AUV 임무계획 전송" cdm="Request.MissionPlan.Transfer">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Parameters>
                <ValueSetProfile id="operationMode" name="Operation Mode" cdm="MissionPlan.OperationMode">
                    <Values>
                        <Value name="광역탐색" cdm="MissionPlan.OperationMode.WideAreaSearch"/>
                        <Value name="정밀탐색" cdm="MissionPlan.OperationMode.PrecisionSearch"/>
                    </Values>
                </ValueSetProfile>
                <QuantityProfile id="speed" name="Speed" cdm="MissionPlan.Speed">
                    <Unit>kts</Unit>
                    <Range min="0" max="7"/>
                    <Resolution>1</Resolution>
                </QuantityProfile>
                <QuantityProfile id="depth" name="Depth" cdm="MissionPlan.Depth">
                    <Unit>m</Unit>
                    <Resolution>1</Resolution>
                </QuantityProfile>
                <QuantityProfile id="returnLatitude" name="복귀 위치 위도" cdm="MissionPlan.ReturnPosition.Latitude">
                    <Unit>rad</Unit>
                </QuantityProfile>
                <QuantityProfile id="returnLongitude" name="복귀 위치 경도" cdm="MissionPlan.ReturnPosition.Longitude">
                    <Unit>rad</Unit>
                </QuantityProfile>
                <CollectionProfile id="waypoints" name="경유점 목록" cdm="MissionPlan.Waypoints" minOccurs="0" maxOccurs="100">
                    <ElementProfile id="waypoint" name="경유점" cdm="MissionPlan.Waypoint">
                        <QuantityProfile id="latitude" name="위도" cdm="MissionPlan.Waypoint.Latitude">
                            <Unit>rad</Unit>
                        </QuantityProfile>
                        <QuantityProfile id="longitude" name="경도" cdm="MissionPlan.Waypoint.Longitude">
                            <Unit>rad</Unit>
                        </QuantityProfile>
                    </ElementProfile>
                </CollectionProfile>
                <QuantityProfile id="alignmentInterval" name="Alignment Interval" cdm="MissionPlan.AlignmentInterval">
                    <!-- ICD에 단위와 범위가 없어 수치 프로파일만 선언한다. -->
                    <Resolution>1</Resolution>
                </QuantityProfile>
            </Parameters>
            <Reply id="transferMissionPlanReply" name="Transfer Mission Plan Reply" cdm="Request.MissionPlan.Transfer.Response" bindRef="transferMissionPlanReply" required="true"/>
        </ControlSpec>

        <!--
            근거리 위치 통제.
            RF-1 INFORMATION3의 RC_MODE + RF_SEND를 사용하며 RC_SPEED와 RC_DIRECTION을 전달한다.
            RC_DIRECTION은 1 byte이면서 -15~15 범위이므로 signed 표현 방식 확인이 필요하다.
        -->
        <ControlSpec id="controlAuvLocally" name="AUV 근거리 위치 통제" cdm="Control.Platform.Motion">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Parameters>
                <QuantityProfile id="speed" name="Speed" cdm="Platform.Motion.Speed">
                    <Range min="0" max="255"/>
                    <Resolution>1</Resolution>
                </QuantityProfile>
                <QuantityProfile id="direction" name="Direction" cdm="Platform.Motion.Direction">
                    <Unit>deg</Unit>
                    <Range min="-15" max="15"/>
                    <Resolution>1</Resolution>
                </QuantityProfile>
            </Parameters>
            <Reply id="controlAuvLocallyReply" name="Control Auv Locally Reply" cdm="Control.Platform.Motion.Response" bindRef="controlAuvLocallyReply" required="true"/>
        </ControlSpec>

        <!--
            AUV 상태 요청.
            RF-1 INFORMATION3의 Status_Chk + RF_SEND를 사용한다.
            RF-2 고정 Body의 항법, 파일 현황, EOR, MODE 필드를 하나의 응답으로 해석한다.
        -->
        <ControlSpec id="requestAuvStatus" name="AUV 상태 요청" cdm="Request.Platform.Status">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Reply id="requestAuvStatusReply" name="Request Auv Status Reply" cdm="Request.Platform.Status.Response" bindRef="requestAuvStatusReply" required="true">
                <Results>
                    <QuantityResult id="numeric" name="AUV ID" cdm="Platform.Identifier.Numeric"/>
                    <QuantityResult id="remainingPercent" name="배터리 용량" cdm="Platform.Energy.Battery.RemainingPercent">
                        <Unit>%</Unit>
                        <Range min="0" max="100"/>
                        <Resolution>1</Resolution>
                    </QuantityResult>
                    <QuantityResult id="latitude" name="GPS 위도" cdm="Navigation.GNSS.Position.Latitude"><Unit>rad</Unit></QuantityResult>
                    <QuantityResult id="longitude" name="GPS 경도" cdm="Navigation.GNSS.Position.Longitude"><Unit>rad</Unit></QuantityResult>
                    <QuantityResult id="waypointCount" name="WayPoint 개수" cdm="MissionPlan.WaypointCount"><Range min="0" max="100"/><Resolution>1</Resolution></QuantityResult>
                    <Result id="status" name="정렬확인" cdm="Navigation.Integrated.Alignment.Status"/>
                    <QuantityResult id="latitude2" name="복합항법 위도" cdm="Navigation.Integrated.Position.Latitude"><Unit>rad</Unit></QuantityResult>
                    <QuantityResult id="longitude2" name="복합항법 경도" cdm="Navigation.Integrated.Position.Longitude"><Unit>rad</Unit></QuantityResult>
                    <QuantityResult id="fileCount" name="AUV 데이터 파일 개수" cdm="RecordedData.Platform.FileCount"/>
                    <QuantityResult id="fileCount2" name="측면주사소나 파일 개수" cdm="RecordedData.SideScanSonar.FileCount"/>
                    <QuantityResult id="fileCount3" name="광학카메라 파일 개수" cdm="RecordedData.OpticalCamera.FileCount"/>
                    <QuantityResult id="fileCount4" name="초음파카메라 파일 개수" cdm="RecordedData.AcousticCamera.FileCount"/>
                    <QuantityResult id="fileCount5" name="전방주사소나 파일 개수" cdm="RecordedData.ForwardLookingSonar.FileCount"/>
                    <GroupResult id="emergencyShutdownItems" name="비상종료 항목(EOR)">
                        <Result id="lEAK" name="LEAK"/><Result id="rOLL" name="ROLL"/><Result id="pITCH" name="PITCH"/><Result id="vEL" name="VEL"/>
                        <Result id="cOM" name="COM"/><Result id="pCD" name="PCD"/><Result id="gPS" name="GPS"/><Result id="rFUCD" name="RF/UCD"/>
                        <Result id="ceilingDepth" name="Ceiling Depth"/><Result id="bTSOC" name="BT_SOC"/><Result id="bTTEMP" name="BT_TEMP"/><Result id="bTCO" name="BT_CO"/>
                        <Result id="bTV" name="BT_V"/><Result id="mC" name="MC"/><Result id="dIS" name="DIS"/><Result id="eOM" name="EOM"/>
                    </GroupResult>
                    <GroupResult id="mODE" name="MODE 항목">
                        <Result id="pLC" name="PLC"/><Result id="mS" name="MS"/><Result id="rC" name="RC"/><Result id="aLIGN" name="ALIGN"/>
                        <Result id="mSST" name="MS_ST"/><Result id="eMER" name="EMER"/><Result id="fILE" name="FILE"/><Result id="dATA" name="DATA"/>
                        <Result id="mSSTOP" name="MS_STOP"/><Result id="rECDEL" name="REC_DEL"/><Result id="rFCONF" name="RF_CONF"/><Result id="eOR" name="EOR"/>
                    </GroupResult>
                </Results>
            </Reply>
        </ControlSpec>

        <!--
            AUV 임무 시작.
            MISSION_START는 이미 전송된 임무계획의 수행을 시작하는 명령이며 RF에서는 INFORMATION3을 사용한다.
            별도 MissionPlan Parameter를 다시 전달하지 않는다.
        -->
        <ControlSpec id="startMission" name="AUV 임무 시작" cdm="Control.Mission.Start">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Reply id="startMissionReply" name="Start Mission Reply" cdm="Control.Mission.Start.Response" bindRef="startMissionReply" required="true"/>
        </ControlSpec>

        <!--
            AUV 비상복귀.
            RF에서는 INFORMATION3, UCD에서는 UCD-1 INFORMATION의 RETURN_LAT/RETURN_LONG을 사용한다.
            두 좌표의 ICD 단위는 rad이며 허용 범위는 기재되어 있지 않다.
            UCD-2에는 IMU_LAT/IMU_LONG 물리 필드가 있으나 emergencyReturn Reply의 Semantic 결과로 최종 채택할지는 CDM/응답 의미 재검토 때 확정한다.
        -->
        <ControlSpec id="emergencyReturn" name="AUV 비상복귀" cdm="Control.Mission.EmergencyReturn">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Parameters>
                <QuantityProfile id="emergencyLatitude" name="비상복귀 위도" cdm="Autonomy.EmergencyReturn.Position.Latitude"><Unit>rad</Unit></QuantityProfile>
                <QuantityProfile id="emergencyLongitude" name="비상복귀 경도" cdm="Autonomy.EmergencyReturn.Position.Longitude"><Unit>rad</Unit></QuantityProfile>
            </Parameters>
            <Reply id="emergencyReturnReply" name="Emergency Return Reply" cdm="Control.Mission.EmergencyReturn.Response" bindRef="emergencyReturnReply" required="true"/>
        </ControlSpec>

        <!--
            저장 파일 목록 요청.
            File_List_Req는 현재 저장되어 있는 주행데이터 및 센서데이터의 File_list를 요청한다.
            DATA TYPE / File_First / File_Final은 Data_Req 데이터 전송 요청에 사용하며 File_List_Req의 사용자 입력으로 사용하지 않는다.
            Reply는 AUV/SSS/OC/AC/FLS 전체 파일 개수를 제공한다.
        -->
        <ControlSpec id="requestFileList" name="AUV 파일 목록 요청" cdm="Request.RecordedData.FileList">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Reply id="requestFileListReply" name="Request File List Reply" cdm="Request.RecordedData.FileList.Response" bindRef="requestFileListReply" required="true">
                <Results>
                    <QuantityResult id="fileCount" name="AUV 데이터 파일 개수" cdm="RecordedData.Platform.FileCount"/>
                    <QuantityResult id="fileCount2" name="측면주사소나 파일 개수" cdm="RecordedData.SideScanSonar.FileCount"/>
                    <QuantityResult id="fileCount3" name="광학카메라 파일 개수" cdm="RecordedData.OpticalCamera.FileCount"/>
                    <QuantityResult id="fileCount4" name="초음파카메라 파일 개수" cdm="RecordedData.AcousticCamera.FileCount"/>
                    <QuantityResult id="fileCount5" name="전방주사소나 파일 개수" cdm="RecordedData.ForwardLookingSonar.FileCount"/>
                </Results>
            </Reply>
        </ControlSpec>

        <!--
            저장 데이터 전송 요청.
            RF-1 INFORMATION3의 Data_Req + RF_SEND, DATA TYPE, File_First, File_Final을 사용한다.
            DATA TYPE bit0~4는 AUV/SSS/OC/AC/FLS 선택 bit이며 원문 근거 없이 정확히 하나만 선택하도록 제한하지 않는다.
            실제 RF-3 데이터 프레임은 SensorProductSpecs/ProductBinding으로 분리하여 표현한다.
        -->
        <ControlSpec id="requestData" name="AUV 데이터 전송 요청" cdm="Request.RecordedData.Transfer">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Parameters>
                <BooleanProfile id="platform" name="Platform" cdm="RecordedData.Selection.Platform" required="false" default="false"/>
                <BooleanProfile id="sideScanSonar" name="Side Scan Sonar" cdm="RecordedData.Selection.SideScanSonar" required="false" default="false"/>
                <BooleanProfile id="opticalCamera" name="Optical Camera" cdm="RecordedData.Selection.OpticalCamera" required="false" default="false"/>
                <BooleanProfile id="acousticCamera" name="Acoustic Camera" cdm="RecordedData.Selection.AcousticCamera" required="false" default="false"/>
                <BooleanProfile id="forwardLookingSonar" name="Forward Looking Sonar" cdm="RecordedData.Selection.ForwardLookingSonar" required="false" default="false"/>
                <QuantityProfile id="first" name="First" cdm="RecordedData.FileRange.First"><Range min="0" max="65535"/><Resolution>1</Resolution></QuantityProfile>
                <QuantityProfile id="final" name="Final" cdm="RecordedData.FileRange.Final"><Range min="0" max="65535"/><Resolution>1</Resolution></QuantityProfile>
            </Parameters>
        </ControlSpec>

        <ControlSpec id="stopMission" name="AUV 임무 중지" cdm="Control.Mission.Stop">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Reply id="stopMissionReply" name="Stop Mission Reply" cdm="Control.Mission.Stop.Response" bindRef="stopMissionReply" required="true"/>
        </ControlSpec>

        <ControlSpec id="deleteAllRecords" name="AUV 저장자료 전체 삭제" cdm="Request.RecordedData.DeleteAll">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Reply id="deleteAllRecordsReply" name="Delete All Records Reply" cdm="Request.RecordedData.DeleteAll.Response" bindRef="deleteAllRecordsReply" required="true"/>
        </ControlSpec>

        <ControlSpec id="enterMaintenanceMode" name="AUV 정비장비모드 진입" cdm="Control.Platform.MaintenanceMode.Enter">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Reply id="enterMaintenanceModeReply" name="Enter Maintenance Mode Reply" cdm="Control.Platform.MaintenanceMode.Enter.Response" bindRef="enterMaintenanceModeReply" required="true"/>
        </ControlSpec>

        <ControlSpec id="setFlashBrightness" name="AUV 점멸등 밝기 설정" cdm="Control.Equipment.Light.Brightness">
            <Target cdm="Platform.Identifier.Numeric"/>
            <Parameters>
                <QuantityProfile id="brightness" name="Brightness" cdm="Equipment.Light.Brightness"><Range min="1" max="10"/><Resolution>1</Resolution></QuantityProfile>
            </Parameters>
            <Reply id="setFlashBrightnessReply" name="Set Flash Brightness Reply" cdm="Control.Equipment.Light.Brightness.Response" bindRef="setFlashBrightnessReply" required="true"/>
        </ControlSpec>
    </ControlSpecs>

    <SensorProductSpecs id="sensorProduct">
        <ProductFileSpec id="auvData" name="AUV 데이터" cdm="RecordedData.Platform"><ProductKind cdm="ProductKind.RecordedData"/></ProductFileSpec>
        <ProductFileSpec id="sideScanSonarData" name="측면주사소나 데이터" cdm="RecordedData.SideScanSonar"><ProductKind cdm="ProductKind.RecordedData"/></ProductFileSpec>
        <ProductFileSpec id="opticalCameraData" name="광학카메라 데이터" cdm="RecordedData.OpticalCamera"><ProductKind cdm="ProductKind.RecordedData"/></ProductFileSpec>
        <ProductFileSpec id="acousticCameraData" name="초음파카메라 데이터" cdm="RecordedData.AcousticCamera"><ProductKind cdm="ProductKind.RecordedData"/></ProductFileSpec>
        <ProductFileSpec id="forwardLookingSonarData" name="전방주사소나 데이터" cdm="RecordedData.ForwardLookingSonar"><ProductKind cdm="ProductKind.RecordedData"/></ProductFileSpec>
    </SensorProductSpecs>
</PlatformSpec>