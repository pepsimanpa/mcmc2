<?xml version='1.0' encoding='UTF-8'?>
<SensorBinding xmlns="http://lignex1.com/mcmc2/umsSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ./CommonBindingSchema.xsd">
  <!--복합항법장치 Binding: 복합항법장치 CSCI 및 원격통제장치 CSCI 직접 연동 기준.-->
  <!--공용 식별자 규칙: Navigation=0x01, NavProcessorCard=0x01. 별도 세부 장비 ID가 정의되지 않아 dstSubEquipmentID=0x00을 적용한다.-->
  <!--BIT bit-packed 필드는 별도 bit extractor 없이 원본 raw 값을 매핑한다.-->
  <Monitors semantic_id="monitor">
    <MonitorBinding semantic_id="navigationData">
      <DDSChannel topicName="RUSV::SA::CNE::NavigationDataReportType" typeName="NavigationDataReportType"/>
      <Field name="usvHeader"/>
      <Field name="sequenceNumber" cdm="Message.SequenceNumber"/>
      <Field name="positionLatitude" cdm="Navigation.Position.Latitude"/>
      <Field name="positionLongitude" cdm="Navigation.Position.Longitude"/>
      <Field name="positionMSLAltitude" cdm="Navigation.Position.MSLAltitude"/>
      <Field name="velocityNorth" cdm="Navigation.Velocity.North"/>
      <Field name="velocityEast" cdm="Navigation.Velocity.East"/>
      <Field name="velocityDown" cdm="Navigation.Velocity.Down"/>
      <Field name="groundSpeed" cdm="Motion.GroundSpeed"/>
      <Field name="attitudeRoll" cdm="Attitude.Roll"/>
      <Field name="attitudePitch" cdm="Attitude.Pitch"/>
      <Field name="attitudeYaw" cdm="Attitude.Yaw"/>
      <Field name="courseYaw" cdm="Navigation.Course.Yaw"/>
      <Field name="imuAccelX" cdm="Navigation.IMU.Acceleration.X"/>
      <Field name="imuAccelY" cdm="Navigation.IMU.Acceleration.Y"/>
      <Field name="imuAccelZ" cdm="Navigation.IMU.Acceleration.Z"/>
      <Field name="imuGyroX" cdm="Navigation.IMU.Gyro.X"/>
      <Field name="imuGyroY" cdm="Navigation.IMU.Gyro.Y"/>
      <Field name="imuGyroZ" cdm="Navigation.IMU.Gyro.Z"/>
      <Field name="integratedNavigationStatus" cdm="Navigation.Integrated.Status"/>
      <Field name="integratedNavigationAidedSensor" cdm="Navigation.Integrated.AidedSensor"/>
      <Field name="gnssNavigationStatus" cdm="Navigation.GNSS.Status"/>
      <Field name="ajAsStatus" cdm="Navigation.GNSS.AntiJamSpoof.Status"/>
      <Field name="gnssSvNum" cdm="Navigation.GNSS.SatelliteCount"/>
    </MonitorBinding>

    <MonitorBinding semantic_id="cneCbitStatus">
      <DDSChannel topicName="RUSV::SO::CNE::CNECBITReportType" typeName="CNECBITReportType"/>
      <Field name="usvHeader"/>
      <Field name="sysCbit" cdm="Health.CNE.CBIT.System.Raw"/>
      <Field name="imuCbit" cdm="Health.CNE.CBIT.IMU.Raw"/>
      <Field name="gnssCbit" cdm="Health.CNE.CBIT.GNSS.Raw"/>
      <Field name="ajCbit" cdm="Health.CNE.CBIT.AntiJam.Raw"/>
      <Field name="ajasCbit" cdm="Health.CNE.CBIT.AntiSpoofGNSS.Raw"/>
      <Field name="eLoranCbit" cdm="Health.CNE.CBIT.ELoran.Raw"/>
      <Field name="dvlCbit" cdm="Health.CNE.CBIT.DVL.Raw"/>
      <Field name="aisCbit" cdm="Health.CNE.CBIT.AIS.Raw"/>
      <Field name="idcCbit" cdm="Health.CNE.CBIT.IDC.Raw"/>
    </MonitorBinding>
  </Monitors>

  <Controls semantic_id="control">
    <ControlBinding semantic_id="startIntegration">
      <DDSChannel topicName="RUSV::C2::RCU::IntegrationControlType" typeName="IntegrationControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <FixedField name="destination.dstEquipmentType" value="0x01"/>
      <FixedField name="destination.dstEquipmentID" value="0x01"/>
      <FixedField name="destination.dstSubEquipmentID" value="0x00"/>
      <Reply semantic_id="startIntegrationAck" required="true">
        <DDSChannel topicName="RUSV::C2::CNE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>

    <ControlBinding semantic_id="restartSystem">
      <DDSChannel topicName="RUSV::C2::RCU::SystemRebootControlType" typeName="SystemRebootControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <FixedField name="destination.dstEquipmentType" value="0x01"/>
      <FixedField name="destination.dstEquipmentID" value="0x01"/>
      <FixedField name="destination.dstSubEquipmentID" value="0x00"/>
      <Reply semantic_id="restartSystemAck" required="true">
        <DDSChannel topicName="RUSV::C2::CNE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>

    <ControlBinding semantic_id="requestPbit">
      <DDSChannel topicName="RUSV::SO::RCU::RCUPBITControlType" typeName="RCUPBITControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <FixedField name="destination.dstEquipmentType" value="0x01"/>
      <FixedField name="destination.dstEquipmentID" value="0x01"/>
      <FixedField name="destination.dstSubEquipmentID" value="0x00"/>
      <Reply semantic_id="requestPbitAck" required="true">
        <DDSChannel topicName="RUSV::C2::CNE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
      <Reply semantic_id="requestPbitResult">
        <DDSChannel topicName="RUSV::SO::CNE::CNEPBITReportType" typeName="CNEPBITReportType"/>
        <Field name="usvHeader"/>
        <Field name="sysPbit" cdm="Health.CNE.PBIT.System.Raw"/>
        <Field name="imuPbit" cdm="Health.CNE.PBIT.IMU.Raw"/>
        <Field name="gnssPbit" cdm="Health.CNE.PBIT.GNSS.Raw"/>
        <Field name="ajPbit" cdm="Health.CNE.PBIT.AntiJam.Raw"/>
        <Field name="ajasPbit" cdm="Health.CNE.PBIT.AntiSpoofGNSS.Raw"/>
        <Field name="eLoranPbit" cdm="Health.CNE.PBIT.ELoran.Raw"/>
        <Field name="dvlPbit" cdm="Health.CNE.PBIT.DVL.Raw"/>
        <Field name="aisPbit" cdm="Health.CNE.PBIT.AIS.Raw"/>
        <Field name="idcPbit" cdm="Health.CNE.PBIT.IDC.Raw"/>
        <!--PBIT 원문 bit 정의를 보존하며 별도 bit extractor는 적용하지 않는다.-->
        <!--sysPbit: Bit 0-1 = INC 시스템 오류(0=정상, 2=비가용).-->
        <!--imuPbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용), Bit 4-5 = BIT 오류(0=정상, 2=비가용).-->
        <!--gnssPbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--ajPbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--ajasPbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--eLoranPbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--dvlPbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용), Bit 4-5 = BIT 오류(0=정상, 2=비가용).-->
        <!--aisPbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--idcPbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--PBIT 결과는 commandID를 포함하지 않으므로 CommandStatusReport와 같은 방식의 명시적 명령 상관관계를 임의로 추가하지 않는다.-->
      </Reply>
    </ControlBinding>

    <ControlBinding semantic_id="requestIbit">
      <DDSChannel topicName="RUSV::SO::RCU::RCUIBITControlType" typeName="RCUIBITControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <FixedField name="destination.dstEquipmentType" value="0x01"/>
      <FixedField name="destination.dstEquipmentID" value="0x01"/>
      <FixedField name="destination.dstSubEquipmentID" value="0x00"/>
      <Reply semantic_id="requestIbitAck" required="true">
        <DDSChannel topicName="RUSV::C2::CNE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
      <Reply semantic_id="requestIbitResult">
        <DDSChannel topicName="RUSV::SO::CNE::CNEIBITReportType" typeName="CNEIBITReportType"/>
        <Field name="usvHeader"/>
        <Field name="sysIbit" cdm="Health.CNE.IBIT.System.Raw"/>
        <Field name="imuIbit" cdm="Health.CNE.IBIT.IMU.Raw"/>
        <Field name="imuIbit2" cdm="Health.CNE.IBIT.IMU.Detail.Raw"/>
        <Field name="gnssIbit" cdm="Health.CNE.IBIT.GNSS.Raw"/>
        <Field name="ajIbit" cdm="Health.CNE.IBIT.AntiJam.Raw"/>
        <Field name="ajasIbit" cdm="Health.CNE.IBIT.AntiSpoofGNSS.Raw"/>
        <Field name="eLoranIbit" cdm="Health.CNE.IBIT.ELoran.Raw"/>
        <Field name="dvlIbit" cdm="Health.CNE.IBIT.DVL.Raw"/>
        <Field name="dvlIbit2" cdm="Health.CNE.IBIT.DVL.Detail.Raw"/>
        <Field name="aisIbit" cdm="Health.CNE.IBIT.AIS.Raw"/>
        <Field name="idcIbit" cdm="Health.CNE.IBIT.IDC.Raw"/>
        <Field name="idcTemperature" cdm="Health.CNE.IBIT.IDC.Temperature"/>
        <Field name="idcCpuLoad" cdm="Health.CNE.IBIT.IDC.CpuLoad"/>
        <!--IBIT 원문 bit 정의를 보존하며 별도 bit extractor는 적용하지 않는다.-->
        <!--sysIbit: Bit 0-1 = INC 시스템 오류(0=정상, 2=비가용), Bit 2-3 = INC 클럭설정 오류(0=정상, 2=비가용), Bit 4-5 = INC 전원설정 오류(0=정상, 2=비가용), Bit 6-7 = INC 메모리테스트 오류(0=정상, 2=비가용).-->
        <!--imuIbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용), Bit 4-5 = BIT 오류(0=정상, 2=비가용).-->
        <!--imuIbit2 원문: Bit 0?10=Reserved, Bit 11=Gyro Tests Failed(0=OK,1=ERR), Bit 12=Accel Tests Failed(0=OK,1=ERR), Bit 13=Other Tests Failed(0=OK,1=ERR), Bit 14=Memory Tests Failed(0=OK,1=ERR), Bit 15=Processor Tests Failed(0=OK,1=ERR), Bit 16-19=4-bit Counter, Bit 20=IMU Failed(0=OK,1=ERR), Bit 21=c-axis RLG in PLC reset(0=OK,1=ERR), Bit 22=b-axis RLG in PLC reset(0=OK,1=ERR), Bit 23=a-axis RLG in PLC reset(0=OK,1=ERR), Bit 24-31=Accelerometer Temperature(LSB = 1×C). 원문 'Bit 0?10' 표기는 그대로 보존한다.-->
        <!--gnssIbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--ajIbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--ajasIbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--eLoranIbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--dvlIbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용), Bit 4-5 = BIT 오류(0=정상, 2=비가용).-->
        <!--dvlIbit2 원문: Bit 0-3=Beam 1-4 Velocity Valid(0=ERR,1=OK), Bit 4-7=Beam 1-4 Distance Valid(0=ERR,1=OK), Bit 8-11=Beam 1-4 Figure of Merit Valid(0=ERR,1=OK), Bit 12=X Velocity Valid, Bit 13=Y Velocity Valid, Bit 14=Z1 Velocity Valid, Bit 15=Z2 Velocity Valid, Bit 16=X Figure of Merit Valid, Bit 17=Y Figure of Merit Valid, Bit 18=Z1 Figure of Merit Valid, Bit 19=Z2 Figure of Merit Valid(각 0=ERR,1=OK), Bit 20?31=Reserved. 원문 'Bit 20?31' 표기는 그대로 보존한다.-->
        <!--aisIbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--idcIbit: Bit 0-1 = 통신 오류(0=정상, 3=미응답), Bit 2-3 = 데이터 무결성 오류(0=정상, 2=비가용).-->
        <!--idcTemperature/idcCpuLoad: 원문 Unit은 각각 ℃, %이고 Range 열은 '0'으로만 기재되어 실제 유효 범위는 불명확하다. Reply에서는 물리 필드를 그대로 매핑하며 별도 Range/Unit 변환은 적용하지 않는다.-->
        <!--IBIT 결과 역시 commandID를 포함하지 않아 명시적 명령 상관관계는 CommandStatusReport에서만 수행한다.-->
      </Reply>
    </ControlBinding>

    <ControlBinding semantic_id="updateRtcmData">
      <DDSChannel topicName="RUSV::SA::RCU::RTCMDataReportType" typeName="RTCMDataReportType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <Field name="vaildRtcmDataSize" cdm="Navigation.GNSS.RTCM.ValidDataSize"/>
      <Field name="rtcmDataBuf" cdm="Navigation.GNSS.RTCM.Data"/>
      <!--물리 필드명 vaildRtcmDataSize는 원본 IDL/CSV 오탈자 가능성이 있으나 Binding에서는 실제 필드명을 보존한다. Semantic Range는 0~256 byte로 제한한다.-->
    </ControlBinding>
  </Controls>
</SensorBinding>
