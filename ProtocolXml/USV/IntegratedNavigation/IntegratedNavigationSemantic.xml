<?xml version='1.0' encoding='UTF-8'?>
<SensorSpec xmlns="http://lignex1.com/mcmc2/umsSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ./CommonSpecSchema.xsd">
  <!--복합항법장치(Combined Navigation Equipment, CNE) Semantic 명세: 원격통제장치 CSCI ↔ 복합항법장치 CSCI 직접 연동 기준.-->
  <!--설계 결정: RTCMDataReportType은 복합항법장치에 주기적으로 제공되는 GNSS 보정 입력 데이터이므로 응답 없는 Control(updateRtcmData)로 정의한다.-->
  <!--설계 결정: vaildRtcmDataSize 원문 Range 0~1,000,000,000은 rtcmDataBuf 256 Byte 및 '버퍼 중 가용 데이터 크기' 설명과 충돌하므로 Semantic Range를 0~256 byte로 정규화한다. 물리 필드명 오탈자(vaild)는 Binding에 그대로 유지한다.-->
  <!--BIT 계열의 bit-packed octet/uint32 필드는 임의의 bit extractor를 도입하지 않고 raw 값으로 노출하며 원문 비트 의미를 주석으로 보존한다.-->
  <!--설계 결정: integratedNavigationAidedSensor는 원문의 key 정의(0, 1, 2, 4, 8, 16)를 그대로 ValueSet으로 정의한다. 조합 가능한 bit mask라는 근거는 원문에 없으므로 조합값은 임의 해석하지 않는다.-->
  <ConstantSpecs id="constant">
    <TextConstantSpec id="productName" name="제품명" cdm="Product.Name">
      <Value>IntegratedNavigation</Value>
    </TextConstantSpec>
    <TextConstantSpec id="productDescription" name="제품 설명" cdm="Product.Description">
      <Value>복합항법 정보, GNSS 보정정보 입력, 상태 감시 및 원격 자체점검·장비 제어 인터페이스</Value>
    </TextConstantSpec>
  </ConstantSpecs>

  <MonitorSpecs id="monitor">
    <GroupSpec id="navigationData" name="무인수상정 항법정보" cdm="Navigation.Integrated.Data">
      <QuantitySpec id="sequenceNumber" name="메시지 발행 카운트" cdm="Message.SequenceNumber">
        <Range min="0" max="255"/>
      </QuantitySpec>
      <QuantitySpec id="latitude" name="함체 위치 위도" cdm="Navigation.Position.Latitude">
        <Unit>deg</Unit>
        <Range min="-90" max="90"/>
      </QuantitySpec>
      <QuantitySpec id="longitude" name="함체 위치 경도" cdm="Navigation.Position.Longitude">
        <Unit>deg</Unit>
        <Range min="-180" max="180"/>
      </QuantitySpec>
      <QuantitySpec id="mslAltitude" name="함체 MSL 고도" cdm="Navigation.Position.MSLAltitude">
        <Unit>m</Unit>
        <Range min="0"/>
      </QuantitySpec>
      <QuantitySpec id="velocityNorth" name="북방향 속도" cdm="Navigation.Velocity.North">
        <Unit>m/s</Unit>
        <Range min="-299792458" max="299792458"/>
      </QuantitySpec>
      <QuantitySpec id="velocityEast" name="동방향 속도" cdm="Navigation.Velocity.East">
        <Unit>m/s</Unit>
        <Range min="-299792458" max="299792458"/>
      </QuantitySpec>
      <QuantitySpec id="velocityDown" name="하방향 속도" cdm="Navigation.Velocity.Down">
        <Unit>m/s</Unit>
        <Range min="-299792458" max="299792458"/>
      </QuantitySpec>
      <QuantitySpec id="groundSpeed" name="수평속도" cdm="Motion.GroundSpeed">
        <Unit>m/s</Unit>
        <Range min="-299792458" max="299792458"/>
      </QuantitySpec>
      <QuantitySpec id="roll" name="함체 Roll" cdm="Attitude.Roll">
        <Unit>rad</Unit>
        <Range min="-6.28318530718" max="6.28318530718"/>
      </QuantitySpec>
      <QuantitySpec id="pitch" name="함체 Pitch" cdm="Attitude.Pitch">
        <Unit>rad</Unit>
        <Range min="-6.28318530718" max="6.28318530718"/>
      </QuantitySpec>
      <QuantitySpec id="yaw" name="함체 Yaw" cdm="Attitude.Yaw">
        <Unit>rad</Unit>
        <Range min="-6.28318530718" max="6.28318530718"/>
      </QuantitySpec>
      <QuantitySpec id="courseYaw" name="함체 진행방향 Yaw" cdm="Navigation.Course.Yaw">
        <Unit>rad</Unit>
        <Range min="-6.28318530718" max="6.28318530718"/>
      </QuantitySpec>
      <QuantitySpec id="imuAccelX" name="IMU 가속도 X" cdm="Navigation.IMU.Acceleration.X">
        <Unit>m/s2</Unit>
        <Range min="-1310.68" max="1310.68"/>
      </QuantitySpec>
      <QuantitySpec id="imuAccelY" name="IMU 가속도 Y" cdm="Navigation.IMU.Acceleration.Y">
        <Unit>m/s2</Unit>
        <Range min="-1310.68" max="1310.68"/>
      </QuantitySpec>
      <QuantitySpec id="imuAccelZ" name="IMU 가속도 Z" cdm="Navigation.IMU.Acceleration.Z">
        <Unit>m/s2</Unit>
        <Range min="-1310.68" max="1310.68"/>
      </QuantitySpec>
      <QuantitySpec id="imuGyroX" name="IMU 각속도 X" cdm="Navigation.IMU.Gyro.X">
        <Unit>rad/s</Unit>
        <Range min="-32.767" max="32.676"/>
      </QuantitySpec>
      <QuantitySpec id="imuGyroY" name="IMU 각속도 Y" cdm="Navigation.IMU.Gyro.Y">
        <Unit>rad/s</Unit>
        <Range min="-32.767" max="32.677"/>
      </QuantitySpec>
      <QuantitySpec id="imuGyroZ" name="IMU 각속도 Z" cdm="Navigation.IMU.Gyro.Z">
        <Unit>rad/s</Unit>
        <Range min="-32.767" max="32.678"/>
      </QuantitySpec>
      <ValueSetSpec id="integratedNavigationStatus" name="통합항법 상태" cdm="Navigation.Integrated.Status">
        <Values>
          <Value cdm="Navigation.Integrated.Status.Idle">0</Value>
          <Value cdm="Navigation.Integrated.Status.Align">1</Value>
          <Value cdm="Navigation.Integrated.Status.Navigation">2</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="integratedNavigationAidedSensor" name="통합항법 사용 측정치" cdm="Navigation.Integrated.AidedSensor">
        <Values>
          <Value cdm="Navigation.Integrated.AidedSensor.INSOnly">0</Value>
          <Value cdm="Navigation.Integrated.AidedSensor.GNSSPV">1</Value>
          <Value cdm="Navigation.Integrated.AidedSensor.GNSSHeading">2</Value>
          <Value cdm="Navigation.Integrated.AidedSensor.AJASGNSSPV">4</Value>
          <Value cdm="Navigation.Integrated.AidedSensor.ELoranPV">8</Value>
          <Value cdm="Navigation.Integrated.AidedSensor.DVL">16</Value>
        </Values>
      </ValueSetSpec>
      <!--원문 Range는 0~16이며 key는 0=INS-Only, 1=GNSS PV, 2=GNSS Heading, 4=AJ/AS GNSS PV, 8=eLoran PV, 16=DVL로 정의되어 있다. 조합 가능한 bit mask라는 설명은 없으므로 정의된 key만 사용한다.-->
      <ValueSetSpec id="gnssNavigationStatus" name="위성항법 상태" cdm="Navigation.GNSS.Status">
        <Values>
          <Value cdm="Navigation.GNSS.Status.Fix2D">1</Value>
          <Value cdm="Navigation.GNSS.Status.Fix3D">2</Value>
          <Value cdm="Navigation.GNSS.Status.DGPS">3</Value>
          <Value cdm="Navigation.GNSS.Status.RTK">4</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="ajAsStatus" name="항재밍·항기만 상태" cdm="Navigation.GNSS.AntiJamSpoof.Status">
        <Values>
          <Value cdm="Navigation.GNSS.AntiJamSpoof.Status.AntiJamDetected">1</Value>
          <Value cdm="Navigation.GNSS.AntiJamSpoof.Status.AntiSpoofDetected">2</Value>
        </Values>
      </ValueSetSpec>
      <!--ajAsStatus 원문 정의는 1=GPS 항재밍 감지, 2=항기만 감지이다. 정상/동시감지 값은 명시되지 않아 추가 값을 임의 정의하지 않는다.-->
      <QuantitySpec id="gnssSatelliteCount" name="위성항법 위성 수" cdm="Navigation.GNSS.SatelliteCount"/>
    </GroupSpec>

    <GroupSpec id="cneCbitStatus" name="복합항법장치 CBIT 상태" cdm="Health.CBIT.CNE">
      <QuantitySpec id="sysCbit" name="복합항법카드 CBIT raw 상태" cdm="Health.CNE.CBIT.System.Raw">
        <Range min="0" max="255"/>
      </QuantitySpec>
      <!--sysCbit: Bit0-1 INC 시스템 오류(0=정상, 2=비가용).-->
      <QuantitySpec id="imuCbit" name="관성측정장치 CBIT raw 상태" cdm="Health.CNE.CBIT.IMU.Raw"><Range min="0" max="255"/></QuantitySpec>
      <!--imuCbit: Bit0-1 통신 오류(0=정상,3=미응답), Bit2-3 데이터 무결성(0=정상,2=비가용), Bit4-5 BIT 오류(0=정상,2=비가용).-->
      <QuantitySpec id="gnssCbit" name="위성항법수신기 CBIT raw 상태" cdm="Health.CNE.CBIT.GNSS.Raw"><Range min="0" max="255"/></QuantitySpec>
      <QuantitySpec id="ajCbit" name="항재밍안테나 CBIT raw 상태" cdm="Health.CNE.CBIT.AntiJam.Raw"><Range min="0" max="255"/></QuantitySpec>
      <QuantitySpec id="ajasCbit" name="항기만위성항법수신기 CBIT raw 상태" cdm="Health.CNE.CBIT.AntiSpoofGNSS.Raw"><Range min="0" max="255"/></QuantitySpec>
      <QuantitySpec id="eLoranCbit" name="지상파항법수신카드 CBIT raw 상태" cdm="Health.CNE.CBIT.ELoran.Raw"><Range min="0" max="255"/></QuantitySpec>
      <QuantitySpec id="dvlCbit" name="측심기 CBIT raw 상태" cdm="Health.CNE.CBIT.DVL.Raw"><Range min="0" max="255"/></QuantitySpec>
      <QuantitySpec id="aisCbit" name="선박자동식별장치 CBIT raw 상태" cdm="Health.CNE.CBIT.AIS.Raw"><Range min="0" max="255"/></QuantitySpec>
      <QuantitySpec id="idcCbit" name="DDS통신카드 CBIT raw 상태" cdm="Health.CNE.CBIT.IDC.Raw"><Range min="0" max="255"/></QuantitySpec>
      <!--gnss/aj/ajas/eLoran/ais/idc: Bit0-1 통신 오류(0=정상,3=미응답), Bit2-3 데이터 무결성 오류(0=정상,2=비가용). dvl은 추가로 Bit4-5 BIT 오류를 사용한다.-->
    </GroupSpec>
  </MonitorSpecs>

  <ControlSpecs id="control">
    <ControlSpec id="startIntegration" name="복합항법장치 연동 개시" cdm="Control.Navigation.Integration.Start">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply bindRef="startIntegrationAck" cdm="Control.Navigation.Integration.Start.Response" required="true"/>
    </ControlSpec>
    <ControlSpec id="restartSystem" name="복합항법장치 시스템 재시작" cdm="Control.Navigation.System.Restart">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply bindRef="restartSystemAck" cdm="Control.Navigation.System.Restart.Response" required="true"/>
    </ControlSpec>
    <ControlSpec id="requestPbit" name="복합항법장치 PBIT 요청" cdm="Control.Navigation.PBIT.Request">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply bindRef="requestPbitAck" cdm="Control.Navigation.PBIT.Request.Response" required="true"/>
      <Reply bindRef="requestPbitResult" cdm="Control.Navigation.PBIT.Result"/>
    </ControlSpec>
    <ControlSpec id="requestIbit" name="복합항법장치 IBIT 요청" cdm="Control.Navigation.IBIT.Request">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply bindRef="requestIbitAck" cdm="Control.Navigation.IBIT.Request.Response" required="true"/>
      <Reply bindRef="requestIbitResult" cdm="Control.Navigation.IBIT.Result"/>
    </ControlSpec>
    <ControlSpec id="updateRtcmData" name="위성항법 RTCM 보정정보 입력" cdm="Control.Navigation.GNSS.RTCM.Update">
      <Parameters>
        <QuantityProfile cdm="Navigation.GNSS.RTCM.ValidDataSize">
          <Unit>byte</Unit>
          <Range min="0" max="256"/>
          <Resolution>1</Resolution>
        </QuantityProfile>
        <Profile cdm="Navigation.GNSS.RTCM.Data"/>
      </Parameters>
      <!--원문 vaildRtcmDataSize Range는 0~1,000,000,000이나 rtcmDataBuf가 256 Byte이고 해당 필드는 버퍼 내 가용 데이터 크기를 뜻하므로 0~256 byte로 적용한다. RTCM payload 자체는 변환하지 않고 원문 버퍼를 그대로 전달한다.-->
    </ControlSpec>
  </ControlSpecs>
</SensorSpec>
