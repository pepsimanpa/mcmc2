      <Reply bindRef="restartSystemAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply>
    </ControlSpec>
    <ControlSpec id="requestPbit" name="근거리접촉물탐지장치 PBIT 요청" cdm="Request.Health.PBIT">
