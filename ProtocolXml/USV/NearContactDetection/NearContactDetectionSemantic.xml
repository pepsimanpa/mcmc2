      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply bindRef="startIntegrationAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply>
    </ControlSpec>
    <ControlSpec id="restartSystem" name="근거리접촉물탐지장치 시스템 재시작" cdm="Control.System.Restart">
