      <Reply bindRef="requestPbitLidarResult" cdm="Request.Health.PBIT.Response.NearContactDetection.Lidar" required="true"><Results><ValueSetResult name="lidarStatus" cdm="Health.NearContactDetection.Lidar.Overall"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult></Results></Reply>
