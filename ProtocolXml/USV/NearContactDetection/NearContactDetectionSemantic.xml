<?xml version='1.0' encoding='UTF-8'?>
<SensorSpec xmlns="http://lignex1.com/mcmc2/umsSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ../../XSD/CommonSpecSchema.xsd">
  <!--근거리접촉물탐지장치(Near Contact Detection Device) Semantic 명세: 원격통제장치 CSCI ↔ 근거리접촉물탐지장치 CSCI 직접 연동 기준.-->
  <!--직접 RCU 연동 대상: 서라운드 뷰 RTP, SCDE/Lidar CBIT, PBIT/IBIT 결과, 공통 명령 ACK, 연동/재시작/PBIT/IBIT 명령. Contact/Wave Report와 라이다 정보처리 CSC 전용 RTP는 제외한다.-->
  <!--설계 결정: PBIT/IBIT 명령은 근거리접촉물탐지장치 전체에 1회 요청하며, 각각 SCDE 결과와 내부 라이다 센서 결과의 두 Reply를 수신한다.-->
  <!--설계 결정: 공용 식별자 0x03/0x04의 세부 ID 0x01=근거리접촉물탐지장치 상태정보, 0x02=라이다 상태정보는 보고 정보 구분용으로 해석하며 별도 제어 대상으로 분리하지 않는다.-->
  <!--설계 결정: 공통 Control 목적지는 equipmentType=0x03, equipmentID=0x04로 장비가 유일하게 식별되므로 dstSubEquipmentID=0x00을 사용한다.-->
  <!--CSV 재심층 감사: SCDE IBIT 반복장치의 첫 비고가 장비번호 1이 아니라 `#` placeholder로 전원/동작 bit 공통 규칙을 정의하므로 Radar2~9, Contact2~9, SVM2~6에도 동일 bit0/bit1 계약을 적용한다.-->
  <ConstantSpecs id="constant">
    <TextConstantSpec id="productName" name="제품명" cdm="Product.Name">
      <Value>NearContactDetection</Value>
    </TextConstantSpec>
    <TextConstantSpec id="productDescription" name="제품 설명" cdm="Product.Description">
      <Value>근거리접촉물탐지장치 서라운드 뷰, 장치 및 내부 라이다 상태 감시와 원격 자체점검/제어 인터페이스</Value>
    </TextConstantSpec>
  </ConstantSpecs>

  <MonitorSpecs id="monitor">
    <GroupSpec id="scdeCbitStatus" name="근거리접촉물탐지장치 CBIT 상태" cdm="Health.CBIT.NearContactDetection">
      <ValueSetSpec id="scdeStatus" name="근거리접촉물탐지장치 상태" cdm="Health.NearContactDetection.Overall">
        <Values>
          <Value cdm="Health.Normal" name="Normal"/>
          <Value cdm="Health.Degraded" name="Degraded"/>
          <Value cdm="Health.Unavailable" name="Unavailable"/>
          <Value cdm="Health.NoResponse" name="NoResponse"/>
        </Values>
      </ValueSetSpec>
    </GroupSpec>
    <GroupSpec id="lidarCbitStatus" name="내부 라이다 센서 CBIT 상태" cdm="Health.CBIT.NearContactDetection.Lidar">
      <ValueSetSpec id="lidarStatus" name="라이다 상태" cdm="Health.NearContactDetection.Lidar.Overall">
        <Values>
          <Value cdm="Health.Normal" name="Normal"/>
          <Value cdm="Health.Degraded" name="Degraded"/>
          <Value cdm="Health.Unavailable" name="Unavailable"/>
          <Value cdm="Health.NoResponse" name="NoResponse"/>
        </Values>
      </ValueSetSpec>
    </GroupSpec>
  </MonitorSpecs>

  <ControlSpecs id="control">
