        <ValueSetResult id="iRProcessingBoard" name="statusIRProcessingBoard" cdm="Health.NavigationCamera.IRProcessingBoard"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult>
        <ValueSetResult id="eOAssembly" name="statusEO" cdm="Health.NavigationCamera.EOAssembly"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult>
        <ValueSetResult id="iRAssembly" name="statusIR" cdm="Health.NavigationCamera.IRAssembly"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult>
      </GroupResult></Results></Reply>
