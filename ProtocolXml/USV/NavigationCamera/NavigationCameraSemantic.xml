        <ValueSetResult id="eOAssembly" name="statusEO" cdm="Health.NavigationCamera.EOAssembly"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult>
        <ValueSetResult id="iRAssembly" name="statusIR" cdm="Health.NavigationCamera.IRAssembly"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult>
        <GroupResult id="overallDetail" name="statusCCDDetail" cdm="Health.NavigationCamera.IBIT.OverallDetail"><Result id="raw" name="powerBoardAvailability" cdm="Health.NavigationCamera.IBIT.OverallDetail.PowerBoardAvailability.Raw"/><Result id="raw2" name="inputPowerStatus" cdm="Health.NavigationCamera.IBIT.OverallDetail.InputPowerStatus.Raw"/><Result id="raw3" name="eoProcessingBoardPower" cdm="Health.NavigationCamera.IBIT.OverallDetail.EOProcessingBoardPower.Raw"/><Result id="raw4" name="irProcessingBoardPower" cdm="Health.NavigationCamera.IBIT.OverallDetail.IRProcessingBoardPower.Raw"/><Result id="raw5" name="eoCameraStatus" cdm="Health.NavigationCamera.IBIT.OverallDetail.EOCameraStatus.Raw"/><Result id="raw6" name="irCameraStatus" cdm="Health.NavigationCamera.IBIT.OverallDetail.IRCameraStatus.Raw"/></GroupResult><GroupResult id="powerBoardDetail" name="statusPowerBoardDetail" cdm="Health.NavigationCamera.IBIT.PowerBoardDetail"><Result id="raw7" name="inputPowerStatus" cdm="Health.NavigationCamera.IBIT.PowerBoardDetail.InputPowerStatus.Raw"/></GroupResult><GroupResult id="eOMuxBoardDetail" name="statusEOMuxingBoardDetail" cdm="Health.NavigationCamera.IBIT.EOMuxBoardDetail"><Result id="raw8" name="eoMuxBoardStatus" cdm="Health.NavigationCamera.IBIT.EOMuxBoardDetail.BoardStatus.Raw"/><Result id="raw9" name="cameraCommunication" cdm="Health.NavigationCamera.IBIT.EOMuxBoardDetail.CameraCommunication.Raw"/></GroupResult><GroupResult id="iRMuxBoardDetail" name="statusIRMuxingBoardDetail" cdm="Health.NavigationCamera.IBIT.IRMuxBoardDetail"><Result id="raw10" name="irMuxBoardStatus" cdm="Health.NavigationCamera.IBIT.IRMuxBoardDetail.BoardStatus.Raw"/><Result id="raw11" name="cameraCommunication" cdm="Health.NavigationCamera.IBIT.IRMuxBoardDetail.CameraCommunication.Raw"/></GroupResult><GroupResult id="eOProcessingBoardDetail" name="statusEOProcessingBoardDetail" cdm="Health.NavigationCamera.IBIT.EOProcessingBoardDetail"><Result id="raw12" name="eoProcessingBoardStatus" cdm="Health.NavigationCamera.IBIT.EOProcessingBoardDetail.BoardStatus.Raw"/><Result id="raw13" name="muxCommunication" cdm="Health.NavigationCamera.IBIT.EOProcessingBoardDetail.MuxCommunication.Raw"/></GroupResult><GroupResult id="iRProcessingBoardDetail" name="statusIRProcessingBoardDetail" cdm="Health.NavigationCamera.IBIT.IRProcessingBoardDetail"><Result id="raw14" name="irProcessingBoardStatus" cdm="Health.NavigationCamera.IBIT.IRProcessingBoardDetail.BoardStatus.Raw"/><Result id="raw15" name="muxCommunication" cdm="Health.NavigationCamera.IBIT.IRProcessingBoardDetail.MuxCommunication.Raw"/></GroupResult>
