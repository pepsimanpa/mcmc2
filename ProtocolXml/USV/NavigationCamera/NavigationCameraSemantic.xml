      <Reply id="requestPbitResult" name="Request Pbit Result" bindRef="requestPbitResult" cdm="Request.Health.PBIT.Response" required="true"><Results><GroupResult id="navigationCamera" name="navigationCameraPbit" cdm="Health.PBIT.NavigationCamera">
