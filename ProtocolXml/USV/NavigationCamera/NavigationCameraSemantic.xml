        <ValueSetResult id="eOMuxBoard" name="statusEOMuxingBoard" cdm="Health.NavigationCamera.EOMuxBoard"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult>
        <ValueSetResult id="iRMuxBoard" name="statusIRMuxingBoard" cdm="Health.NavigationCamera.IRMuxBoard"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult>
