<?xml version="1.0" encoding="UTF-8"?>
<SensorBinding xmlns="http://lignex1.com/mcmc2/umsSchema"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ../../XSD/CommonBindingSchema.xsd">
  <!--운항용카메라장치 Binding: 운항용카메라 CSCI + 원격통제장치 CSCI 직접 연동 기준.-->
  <!--공용 목적지는 OM/Adapter가 System.Target.NavigationCamera로 준비한다.-->
  <!--중앙통제 전용 운항기록 EO/IR RTP는 제외하고 원격통제소 전시용 RTP만 포함한다.-->
  <Monitors semantic_id="monitor">
    <MonitorBinding semantic_id="objectDetectionResults">
      <DDSChannel topicName="RUSV::SA::CCD::PanoImageObjectDetection2DSeqReportType" typeName="PanoImageObjectDetection2DSeqReportType"/>
      <Field name="usvHeader"/>
      <Field name="panoViewType" cdm="Sensor.NavigationCamera.Panorama.ViewType" dataType="UInt8"><ValueMap><Map cdm="Sensor.NavigationCamera.Panorama.ViewType.EOFull" value="0"/></ValueMap></Field>
      <Field name="imageWidth" cdm="Image.Width" dataType="UInt16"/><Field name="imageHeight" cdm="Image.Height" dataType="UInt16"/><Field name="imageObjectDetectionCnt" cdm="Sensor.NavigationCamera.ObjectDetection.Count" dataType="UInt8"/>
      <ArrayField name="imageObjectDetection2DSeq" cdm="Sensor.NavigationCamera.ObjectDetection.List" minOccurs="0" maxOccurs="255"><Element name="objectDetection" cdm="Sensor.NavigationCamera.ObjectDetection.Item">
        <Field name="classID" cdm="Sensor.NavigationCamera.ObjectDetection.Class" dataType="UInt8"><ValueMap><Map cdm="Sensor.NavigationCamera.ObjectDetection.Class.PatrolVessel" value="0"/><Map cdm="Sensor.NavigationCamera.ObjectDetection.Class.NorthKoreanCargoShip" value="1"/><Map cdm="Sensor.NavigationCamera.ObjectDetection.Class.FlagOfConvenienceShip" value="2"/><Map cdm="Sensor.NavigationCamera.ObjectDetection.Class.Warship" value="3"/><Map cdm="Sensor.NavigationCamera.ObjectDetection.Class.FishingShip" value="4"/><Map cdm="Sensor.NavigationCamera.ObjectDetection.Class.CargoShip" value="5"/><Map cdm="Sensor.NavigationCamera.ObjectDetection.Class.Ferry" value="6"/><Map cdm="Sensor.NavigationCamera.ObjectDetection.Class.UnidentifiedShip" value="7"/></ValueMap></Field>
        <Field name="confidence" cdm="Sensor.NavigationCamera.ObjectDetection.Confidence" dataType="UInt8"/><Field name="bbox2D.topLeftX" cdm="Sensor.NavigationCamera.ObjectDetection.BBox.TopLeft.X" dataType="UInt16"/><Field name="bbox2D.topLeftY" cdm="Sensor.NavigationCamera.ObjectDetection.BBox.TopLeft.Y" dataType="UInt16"/><Field name="bbox2D.bottomRightX" cdm="Sensor.NavigationCamera.ObjectDetection.BBox.BottomRight.X" dataType="UInt16"/><Field name="bbox2D.bottomRightY" cdm="Sensor.NavigationCamera.ObjectDetection.BBox.BottomRight.Y" dataType="UInt16"/><Field name="bbox2D.bboxWidth" cdm="Sensor.NavigationCamera.ObjectDetection.BBox.Width" dataType="UInt16"/><Field name="bbox2D.bboxHeight" cdm="Sensor.NavigationCamera.ObjectDetection.BBox.Height" dataType="UInt16"/><Field name="relativeAngle" cdm="Sensor.NavigationCamera.ObjectDetection.RelativeAngle" dataType="Float32"/>
      </Element></ArrayField>
      <Field name="odFPS" cdm="Sensor.NavigationCamera.ObjectDetection.FPS" dataType="UInt8"/>
    </MonitorBinding>
    <MonitorBinding semantic_id="ccdCbitStatus"><DDSChannel topicName="RUSV::SO::CCD::CCDCBITReportType" typeName="CCDCBITReportType"/><Field name="usvHeader"/>
      <Field name="statusCCD" cdm="Health.NavigationCamera.Overall" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusPowerBoard" cdm="Health.NavigationCamera.PowerBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusEOMuxingBoard" cdm="Health.NavigationCamera.EOMuxBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusIRMuxingBoard" cdm="Health.NavigationCamera.IRMuxBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusEOProcessingBoard" cdm="Health.NavigationCamera.EOProcessingBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusIRProcessingBoard" cdm="Health.NavigationCamera.IRProcessingBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusEO" cdm="Health.NavigationCamera.EOAssembly" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusIR" cdm="Health.NavigationCamera.IRAssembly" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field>
    </MonitorBinding>
  </Monitors>
  <Controls semantic_id="control">
    <ControlBinding semantic_id="startIntegration"><DDSChannel topicName="RUSV::C2::RCU::IntegrationControlType" typeName="IntegrationControlType"/><DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/><DerivedField name="destination" sourceField="System.Target.NavigationCamera"/><DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/><Reply semantic_id="startIntegrationAck" required="true"><DDSChannel topicName="RUSV::C2::CCD::CommandStatusReportType" typeName="CommandStatusReportType"/><Field name="usvHeader"/><Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/><Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/><Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/><Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/></Reply></ControlBinding>
    <ControlBinding semantic_id="restartSystem"><DDSChannel topicName="RUSV::C2::RCU::SystemRebootControlType" typeName="SystemRebootControlType"/><DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/><DerivedField name="destination" sourceField="System.Target.NavigationCamera"/><DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/><Reply semantic_id="restartSystemAck" required="true"><DDSChannel topicName="RUSV::C2::CCD::CommandStatusReportType" typeName="CommandStatusReportType"/><Field name="usvHeader"/><Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/><Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/><Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/><Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/></Reply></ControlBinding>
    <ControlBinding semantic_id="requestPbit"><DDSChannel topicName="RUSV::SO::RCU::RCUPBITControlType" typeName="RCUPBITControlType"/><DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/><DerivedField name="destination" sourceField="System.Target.NavigationCamera"/><DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Reply semantic_id="requestPbitAck" required="true"><DDSChannel topicName="RUSV::C2::CCD::CommandStatusReportType" typeName="CommandStatusReportType"/><Field name="usvHeader"/><Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/><Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/><Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/><Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/></Reply>
      <Reply semantic_id="requestPbitResult" required="true"><DDSChannel topicName="RUSV::SO::CCD::CCDPBITReportType" typeName="CCDPBITReportType"/><Field name="usvHeader"/><Field name="statusCCD" cdm="Health.NavigationCamera.Overall" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusPowerBoard" cdm="Health.NavigationCamera.PowerBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusEOMuxingBoard" cdm="Health.NavigationCamera.EOMuxBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusIRMuxingBoard" cdm="Health.NavigationCamera.IRMuxBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusEOProcessingBoard" cdm="Health.NavigationCamera.EOProcessingBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusIRProcessingBoard" cdm="Health.NavigationCamera.IRProcessingBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusEO" cdm="Health.NavigationCamera.EOAssembly" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusIR" cdm="Health.NavigationCamera.IRAssembly" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field></Reply>
    </ControlBinding>
    <ControlBinding semantic_id="requestIbit"><DDSChannel topicName="RUSV::SO::RCU::RCUIBITControlType" typeName="RCUIBITControlType"/><DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/><DerivedField name="destination" sourceField="System.Target.NavigationCamera"/><DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Reply semantic_id="requestIbitAck" required="true"><DDSChannel topicName="RUSV::C2::CCD::CommandStatusReportType" typeName="CommandStatusReportType"/><Field name="usvHeader"/><Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/><Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/><Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/><Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/></Reply>
      <Reply semantic_id="requestIbitResult" required="true"><DDSChannel topicName="RUSV::SO::CCD::CCDIBITReportType" typeName="CCDIBITReportType"/><Field name="usvHeader"/>
        <Field name="statusCCD" cdm="Health.NavigationCamera.Overall" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusCCDDetail" cdm="Health.NavigationCamera.IBIT.OverallDetail.Raw" dataType="UInt8"/><Field name="statusPowerBoard" cdm="Health.NavigationCamera.PowerBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusPowerBoardDetail" cdm="Health.NavigationCamera.IBIT.PowerBoardDetail.Raw" dataType="UInt8"/><Field name="statusEOMuxingBoard" cdm="Health.NavigationCamera.EOMuxBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusEOMuxingBoardDetail" cdm="Health.NavigationCamera.IBIT.EOMuxBoardDetail.Raw" dataType="UInt8"/><Field name="statusIRMuxingBoard" cdm="Health.NavigationCamera.IRMuxBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusIRMuxingBoardDetail" cdm="Health.NavigationCamera.IBIT.IRMuxBoardDetail.Raw" dataType="UInt8"/><Field name="statusEOProcessingBoard" cdm="Health.NavigationCamera.EOProcessingBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusEOProcessingBoardDetail" cdm="Health.NavigationCamera.IBIT.EOProcessingBoardDetail.Raw" dataType="UInt8"/><Field name="statusIRProcessingBoard" cdm="Health.NavigationCamera.IRProcessingBoard" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusIRProcessingBoardDetail" cdm="Health.NavigationCamera.IBIT.IRProcessingBoardDetail.Raw" dataType="UInt8"/><Field name="statusEO" cdm="Health.NavigationCamera.EOAssembly" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field>
        <Field name="statusEO1Detail" cdm="Health.NavigationCamera.IBIT.EO.Camera1.Detail.Raw" dataType="UInt8"/><Field name="statusEO2Detail" cdm="Health.NavigationCamera.IBIT.EO.Camera2.Detail.Raw" dataType="UInt8"/><Field name="statusEO3Detail" cdm="Health.NavigationCamera.IBIT.EO.Camera3.Detail.Raw" dataType="UInt8"/><Field name="statusEO4Detail" cdm="Health.NavigationCamera.IBIT.EO.Camera4.Detail.Raw" dataType="UInt8"/><Field name="statusEO5Detail" cdm="Health.NavigationCamera.IBIT.EO.Camera5.Detail.Raw" dataType="UInt8"/><Field name="statusEO6Detail" cdm="Health.NavigationCamera.IBIT.EO.Camera6.Detail.Raw" dataType="UInt8"/><Field name="statusEO7Detail" cdm="Health.NavigationCamera.IBIT.EO.Camera7.Detail.Raw" dataType="UInt8"/><Field name="statusEO8Detail" cdm="Health.NavigationCamera.IBIT.EO.Camera8.Detail.Raw" dataType="UInt8"/>
        <Field name="statusIR" cdm="Health.NavigationCamera.IRAssembly" dataType="UInt8"><ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap></Field><Field name="statusIR1Detail" cdm="Health.NavigationCamera.IBIT.IR.Camera1.Detail.Raw" dataType="UInt8"/><Field name="statusIR2Detail" cdm="Health.NavigationCamera.IBIT.IR.Camera2.Detail.Raw" dataType="UInt8"/><Field name="statusIR3Detail" cdm="Health.NavigationCamera.IBIT.IR.Camera3.Detail.Raw" dataType="UInt8"/><Field name="statusIR4Detail" cdm="Health.NavigationCamera.IBIT.IR.Camera4.Detail.Raw" dataType="UInt8"/><Field name="statusIR5Detail" cdm="Health.NavigationCamera.IBIT.IR.Camera5.Detail.Raw" dataType="UInt8"/><Field name="statusIR6Detail" cdm="Health.NavigationCamera.IBIT.IR.Camera6.Detail.Raw" dataType="UInt8"/><Field name="statusIR7Detail" cdm="Health.NavigationCamera.IBIT.IR.Camera7.Detail.Raw" dataType="UInt8"/><Field name="statusIR8Detail" cdm="Health.NavigationCamera.IBIT.IR.Camera8.Detail.Raw" dataType="UInt8"/>
        <!--상세 octet은 원문 비트 polarity 또는 카메라 2~8 설명이 불완전하여 raw로 유지한다.-->
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="configureDisplayMode"><DDSChannel topicName="RUSV::C2::RCU::CCDDisplayModeControlType" typeName="CCDDisplayModeControlType"/><DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/><PackedField name="ccdDisplayModeControlStatus.displayMode" width="8" defaultValue="0"><BitMember name="eoDisplay" cdm="Control.NavigationCamera.Display.EO.Mode" offset="0" width="1"><ValueMap><Map cdm="Control.NavigationCamera.Display.EO.Off" value="0"/><Map cdm="Control.NavigationCamera.Display.EO.On" value="1"/></ValueMap></BitMember><BitMember name="irDisplay" cdm="Control.NavigationCamera.Display.IR.Mode" offset="1" width="1"><ValueMap><Map cdm="Control.NavigationCamera.Display.IR.Off" value="0"/><Map cdm="Control.NavigationCamera.Display.IR.On" value="1"/></ValueMap></BitMember><BitMember name="quality" cdm="Control.NavigationCamera.Display.Quality.Mode" offset="2" width="1"><ValueMap><Map cdm="Control.NavigationCamera.Display.Quality.Normal" value="0"/><Map cdm="Control.NavigationCamera.Display.Quality.Low" value="1"/></ValueMap></BitMember></PackedField><DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/><!--Bit3~7 reserved는 defaultValue=0으로 송신한다. 원본 ACK=X이므로 Reply 없음.--></ControlBinding>
  </Controls>
  <SensorProducts semantic_id="sensorProduct"><ProductBinding semantic_id="navigationCameraVideo"><RTPChannel/></ProductBinding></SensorProducts>
</SensorBinding>
