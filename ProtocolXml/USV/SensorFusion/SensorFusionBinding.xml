<?xml version='1.0' encoding='UTF-8'?>
<SensorBinding xmlns="http://lignex1.com/mcmc2/umsSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ../../XSD/CommonBindingSchema.xsd">
  <!--센서융합 정보처리장치 Binding: 센서융합 정보처리 CSC 및 원격통제장치 CSCI 직접 연동 기준-->
  <!--공용 식별자 규칙: SurfaceDetection=0x03, SensorFusionProcessorCard=0x01, 별도 세부 장비 ID 없음 → System.Target.SensorFusion은 0x03/0x01/0x00 DestinationType을 준비한다.-->
  <!--공용 struct 내부 필드는 Adapter의 dotted-path 접근 규칙을 사용하고, 생성 header/destination/commandID는 OM/Adapter가 준비한다.-->
  <Monitors semantic_id="monitor">
    <MonitorBinding semantic_id="fusionContacts">
      <DDSChannel topicName="RUSV::SA::CIPE::FusionContactReportType" typeName="FusionContactReportType"/>
      <Field name="usvHeader"/>
      <Field name="contactNum" cdm="Contact.Fusion.Count" dataType="Int32"/>
      <ArrayField name="sensorFusionContactTypeList" cdm="Contact.Fusion.List" minOccurs="0" maxOccurs="256">
        <Element name="contact" cdm="Contact.Fusion.Item">
          <Field name="sensorFusionContactID" cdm="Contact.Fusion.Identifier" dataType="Int32"/>
          <Field name="sensorFusionContactIdentifier" cdm="Contact.Fusion.Classification" dataType="Int32">
            <ValueMap>
              <Map cdm="Contact.Fusion.Classification.Unclassified" value="0"/>
              <Map cdm="Contact.Fusion.Classification.Vessel" value="1"/>
            </ValueMap>
          </Field>
          <Field name="sensorFusionContactAttribute" cdm="Contact.Fusion.MotionAttribute" dataType="Int32">
            <ValueMap>
              <Map cdm="Contact.Fusion.MotionAttribute.Static" value="0"/>
              <Map cdm="Contact.Fusion.MotionAttribute.Dynamic" value="1"/>
            </ValueMap>
          </Field>
          <Field name="latitude" cdm="Contact.Fusion.Position.Latitude" dataType="Float64"/>
          <Field name="longitude" cdm="Contact.Fusion.Position.Longitude" dataType="Float64"/>
          <Field name="altitudeAmsl" cdm="Contact.Fusion.Position.AltitudeAMSL" dataType="Float32"/>
          <Field name="range" cdm="Contact.Fusion.Range" dataType="Float32"/>
          <Field name="relativeAzimuth" cdm="Contact.Fusion.Bearing.RelativeAzimuth" dataType="Float32"/>
          <Field name="trueAzimuth" cdm="Contact.Fusion.Bearing.TrueAzimuth" dataType="Float32"/>
          <Field name="elevationAngle" cdm="Contact.Fusion.Bearing.Elevation" dataType="Float32"/>
          <Field name="relativeSpeed" cdm="Contact.Fusion.Motion.RelativeSpeed" dataType="Float32"/>
          <Field name="relativeHeading" cdm="Contact.Fusion.Motion.RelativeHeading" dataType="Float32"/>
          <Field name="cog" cdm="Contact.Fusion.Motion.COG" dataType="Float32"/>
          <Field name="sog" cdm="Contact.Fusion.Motion.SOG" dataType="Float32"/>
          <Field name="contactLength" cdm="Contact.Fusion.Dimension.Length" dataType="Float32"/>
          <Field name="contactWidth" cdm="Contact.Fusion.Dimension.Width" dataType="Float32"/>
          <Field name="contactHeight" cdm="Contact.Fusion.Dimension.Height" dataType="Float32"/>
          <Field name="size" cdm="Contact.Fusion.Dimension.Size" dataType="Float32"/>
          <Field name="cpa" cdm="Contact.Fusion.CPA" dataType="Float32"/>
          <Field name="collisionRisk" cdm="Contact.Fusion.CollisionRisk" dataType="Float32"/>
        </Element>
      </ArrayField>
    </MonitorBinding>

    <MonitorBinding semantic_id="fusionWaves">
      <DDSChannel topicName="RUSV::SA::CIPE::FusionWaveReportType" typeName="FusionWaveReportType"/>
      <Field name="usvHeader"/>
      <Field name="waveNum" cdm="Wave.Fusion.Count" dataType="Int32"/>
      <ArrayField name="waveTypeList" cdm="Wave.Fusion.List" minOccurs="0" maxOccurs="256">
        <Element name="wave" cdm="Wave.Fusion.Item">
          <Field name="waveID" cdm="Wave.Fusion.Identifier" dataType="Int32"/>
          <Field name="waveRange" cdm="Wave.Fusion.Range" dataType="Float32"/>
          <Field name="relativeWaveDirection" cdm="Wave.Fusion.Direction.Relative" dataType="Float32"/>
          <Field name="latitude" cdm="Wave.Fusion.Position.Latitude" dataType="Float64"/>
          <Field name="longitude" cdm="Wave.Fusion.Position.Longitude" dataType="Float64"/>
          <Field name="waveHeight" cdm="Wave.Fusion.Height" dataType="Float32"/>
          <Field name="maximumWaveHeight" cdm="Wave.Fusion.Height.Maximum" dataType="Float32"/>
          <Field name="waveDirection" cdm="Wave.Fusion.Direction" dataType="Float32"/>
          <!--물리 필드명 directionalWaveSpectrum은 원본 의미 '파향분산도'에 따라 Semantic CDM Wave.Fusion.Direction.Spread로 매핑한다.-->
          <Field name="directionalWaveSpectrum" cdm="Wave.Fusion.Direction.Spread" dataType="Float32"/>
          <Field name="wavePeriod" cdm="Wave.Fusion.Period" dataType="Float32"/>
          <Field name="meanWavePeriod" cdm="Wave.Fusion.Period.Mean" dataType="Float32"/>
          <Field name="waveSpectrum" cdm="Wave.Fusion.Spectrum" dataType="Float32"/>
          <Field name="integratedWaveEnergy" cdm="Wave.Fusion.Energy.Integrated" dataType="Float32"/>
          <Field name="spectralPeakPeriod" cdm="Wave.Fusion.Period.SpectralPeak" dataType="Float32"/>
        </Element>
      </ArrayField>
    </MonitorBinding>

    <MonitorBinding semantic_id="cipeCbitStatus">
      <DDSChannel topicName="RUSV::SO::CIPE::CIPECBITReportType" typeName="CIPECBITReportType"/>
      <Field name="usvHeader"/>
      <Field name="cipeCBITStatus.cipeOperationalStatus" cdm="Health.CIPE.EquipmentLink" dataType="UInt8">
        <ValueMap>
          <Map cdm="Health.CIPE.Radar.Connected" value="10"/>
          <Map cdm="Health.CIPE.Radar.Disconnected" value="13"/>
          <Map cdm="Health.CIPE.Lidar.Connected" value="20"/>
          <Map cdm="Health.CIPE.Lidar.Disconnected" value="23"/>
          <Map cdm="Health.CIPE.NearContact.Connected" value="30"/>
          <Map cdm="Health.CIPE.NearContact.Disconnected" value="33"/>
          <Map cdm="Health.CIPE.EOIR.Connected" value="40"/>
          <Map cdm="Health.CIPE.EOIR.Disconnected" value="43"/>
        </ValueMap>
      </Field>
      <Field name="cipeCBITStatus.operationalStatus" cdm="Health.CIPE.OperationalStatus" dataType="UInt8">
        <ValueMap>
          <Map cdm="Health.Normal" value="0"/>
          <Map cdm="Health.Degraded" value="1"/>
          <Map cdm="Health.Unavailable" value="2"/>
          <Map cdm="Health.NoResponse" value="3"/>
        </ValueMap>
      </Field>
    </MonitorBinding>
  </Monitors>

  <Controls semantic_id="control">
    <ControlBinding semantic_id="startIntegration">
      <DDSChannel topicName="RUSV::C2::RCU::IntegrationControlType" typeName="IntegrationControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="destination" sourceField="System.Target.SensorFusion"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Reply semantic_id="startIntegrationAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
    </ControlBinding>

    <ControlBinding semantic_id="restartSystem">
      <DDSChannel topicName="RUSV::C2::RCU::SystemRebootControlType" typeName="SystemRebootControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="destination" sourceField="System.Target.SensorFusion"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Reply semantic_id="restartSystemAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
    </ControlBinding>

    <ControlBinding semantic_id="requestIbit">
      <DDSChannel topicName="RUSV::SO::RCU::RCUIBITControlType" typeName="RCUIBITControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="destination" sourceField="System.Target.SensorFusion"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Reply semantic_id="requestIbitAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
      <Reply semantic_id="requestIbitResult" required="true">
        <DDSChannel topicName="RUSV::SO::CIPE::CIPEIBITReportType" typeName="CIPEIBITReportType"/>
        <Field name="usvHeader"/>
        <Field name="cipeIBITStatus.cipeOperationalStatus" cdm="Health.CIPE.EquipmentLink" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.CIPE.Radar.Connected" value="10"/>
            <Map cdm="Health.CIPE.Radar.Disconnected" value="13"/>
            <Map cdm="Health.CIPE.Lidar.Connected" value="20"/>
            <Map cdm="Health.CIPE.Lidar.Disconnected" value="23"/>
            <Map cdm="Health.CIPE.NearContact.Connected" value="30"/>
            <Map cdm="Health.CIPE.NearContact.Disconnected" value="33"/>
            <Map cdm="Health.CIPE.EOIR.Connected" value="40"/>
            <Map cdm="Health.CIPE.EOIR.Disconnected" value="43"/>
          </ValueMap>
        </Field>
        <Field name="cipeIBITStatus.operationalStatus" cdm="Health.CIPE.OperationalStatus" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.Normal" value="0"/>
            <Map cdm="Health.Degraded" value="1"/>
            <Map cdm="Health.Unavailable" value="2"/>
            <Map cdm="Health.NoResponse" value="3"/>
          </ValueMap>
        </Field>
        <!--DDS에는 CPU 상태 enum이 별도로 존재하지 않으며 실제 cpuTemperature/cpuLoad 값만 전달된다.-->
        <Field name="cipeIBITStatus.cipeProcessorIBIT.cpuTemperature" cdm="Health.CIPE.Processor.CpuTemperature" dataType="Float64"/>
        <Field name="cipeIBITStatus.cipeProcessorIBIT.cpuLoad" cdm="Health.CIPE.Processor.CpuLoad" dataType="Float64"/>
      </Reply>
    </ControlBinding>

    <ControlBinding semantic_id="requestPbit">
      <DDSChannel topicName="RUSV::SO::RCU::RCUPBITControlType" typeName="RCUPBITControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="destination" sourceField="System.Target.SensorFusion"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Reply semantic_id="requestPbitAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
      <Reply semantic_id="requestPbitResult" required="true">
        <DDSChannel topicName="RUSV::SO::CIPE::CIPEPBITReportType" typeName="CIPEPBITReportType"/>
        <Field name="usvHeader"/>
        <Field name="cipePBITStatus.cipeOperationalStatus" cdm="Health.CIPE.EquipmentLink" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.CIPE.Radar.Connected" value="10"/>
            <Map cdm="Health.CIPE.Radar.Disconnected" value="13"/>
            <Map cdm="Health.CIPE.Lidar.Connected" value="20"/>
            <Map cdm="Health.CIPE.Lidar.Disconnected" value="23"/>
            <Map cdm="Health.CIPE.NearContact.Connected" value="30"/>
            <Map cdm="Health.CIPE.NearContact.Disconnected" value="33"/>
            <Map cdm="Health.CIPE.EOIR.Connected" value="40"/>
            <Map cdm="Health.CIPE.EOIR.Disconnected" value="43"/>
          </ValueMap>
        </Field>
        <Field name="cipePBITStatus.operationalStatus" cdm="Health.CIPE.OperationalStatus" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.Normal" value="0"/>
            <Map cdm="Health.Degraded" value="1"/>
            <Map cdm="Health.Unavailable" value="2"/>
            <Map cdm="Health.NoResponse" value="3"/>
          </ValueMap>
        </Field>
      </Reply>
    </ControlBinding>
  </Controls>
</SensorBinding>
