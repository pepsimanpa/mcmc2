<?xml version='1.0' encoding='UTF-8'?>
<SensorBinding xmlns="http://lignex1.com/mcmc2/umsSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ./CommonBindingSchema.xsd">
  <!--항해레이더 정보처리장치 Binding: 항해레이더 정보처리 CSC 및 원격통제장치 CSCI 기준-->
  <!--공용 식별자 규칙: SurfaceDetection=0x03, NavRadarProcessorCard=0x03. 세부 장비 ID는 별도 정의 없음.-->
  <Monitors semantic_id="monitor">
    <MonitorBinding semantic_id="radarContacts">
      <DDSChannel topicName="RUSV::SA::CIPE::RadarContactReportType" typeName="RadarContactReportType"/>
      <Field name="usvHeader"/>
      <Field name="contactNum" cdm="Contact.Radar.Count"/>
      <ArrayField name="contactTypeList" cdm="Contact.Radar.List" minOccurs="0" maxOccurs="256">
        <Element name="contact" cdm="Contact.Radar.Item">
          <Field name="contactID" cdm="Contact.Identifier"/>
          <Field name="detectionRange" cdm="Contact.Range"/>
          <Field name="azimuth" cdm="Contact.Azimuth"/>
          <Field name="latitude" cdm="Contact.Position.Latitude"/>
          <Field name="longitude" cdm="Contact.Position.Longitude"/>
          <Field name="course" cdm="Contact.Course"/>
          <Field name="speed" cdm="Contact.Speed"/>
          <Field name="size" cdm="Contact.Size"/>
          <Field name="rcs" cdm="Contact.RCS"/>
          <Field name="cpa" cdm="Contact.CPA"/>
          <Field name="tcpa" cdm="Contact.TCPA"/>
          <Field name="collisionRisk" cdm="Contact.CollisionRisk"/>
        </Element>
      </ArrayField>
    </MonitorBinding>
    <MonitorBinding semantic_id="aisContacts">
      <DDSChannel topicName="RUSV::SA::CIPE::AISContactReportType" typeName="AISContactReportType"/>
      <!--AISContactType 수치 Range는 공용 구조체 원본 정합성 확인 전까지 Binding converter/validation을 두지 않는다.-->
      <Field name="usvHeader"/>
      <Field name="contactNum" cdm="Contact.AIS.Count"/>
      <ArrayField name="contactTypeList" cdm="Contact.AIS.List" minOccurs="0" maxOccurs="256">
        <Element name="contact" cdm="Contact.AIS.Item">
          <Field name="contactID" cdm="Contact.Identifier"/>
          <Field name="mmsi" cdm="Contact.AIS.MMSI"/>
          <Field name="latitude" cdm="Contact.Position.Latitude"/>
          <Field name="longitude" cdm="Contact.Position.Longitude"/>
          <Field name="course" cdm="Contact.Course"/>
          <Field name="speed" cdm="Contact.Speed"/>
          <Field name="detectionRange" cdm="Contact.Range"/>
          <Field name="cpa" cdm="Contact.CPA"/>
          <Field name="tcpa" cdm="Contact.TCPA"/>
          <Field name="collisionRisk" cdm="Contact.CollisionRisk"/>
          <Field name="heading" cdm="Contact.Heading"/>
          <Field name="rateOfTurn" cdm="Contact.RateOfTurn"/>
          <Field name="shipName" cdm="Contact.AIS.ShipName"/>
          <Field name="shipType" cdm="Contact.AIS.ShipType"/>
          <Field name="shipLength" cdm="Contact.Length"/>
          <Field name="shipWidth" cdm="Contact.Width"/>
        </Element>
      </ArrayField>
    </MonitorBinding>
    <MonitorBinding semantic_id="radarStatus">
      <DDSChannel topicName="RUSV::SA::CIPE::RadarAISStatusReportType" typeName="RadarAISStatusReportType"/>
      <!--TBD: radarMessageTransmitStatus의 구체적인 "레이더 메시지" 대상 확인 필요.-->
      <Field name="usvHeader"/>
      <Field name="radarTransmitStatus" cdm="Radar.Status.Transmit"/>
      <Field name="radarRange" cdm="Radar.Status.Range"/>
      <Field name="radarMessageTransmitStatus" cdm="Radar.Status.MessageTransmit"/>
    </MonitorBinding>
    <MonitorBinding semantic_id="radarVideoStatus">
      <DDSChannel topicName="RUSV::SA::CIPE::RadarAISStatusReportType" typeName="RadarAISStatusReportType"/>
      <Field name="usvHeader"/>
      <Field name="videoBroadcastStatus" cdm="Radar.Video.BroadcastStatus"/>
      <Field name="frameWidth" cdm="Radar.Video.Frame.Width"/>
      <Field name="frameHeight" cdm="Radar.Video.Frame.Height"/>
    </MonitorBinding>
    <MonitorBinding semantic_id="aisStatus">
      <DDSChannel topicName="RUSV::SA::CIPE::RadarAISStatusReportType" typeName="RadarAISStatusReportType"/>
      <Field name="usvHeader"/>
      <Field name="aisMessageTransmitStatus" cdm="AIS.Status.MessageTransmit"/>
      <Field name="aisRange" cdm="AIS.Status.Range"/>
    </MonitorBinding>
    <MonitorBinding semantic_id="cipeCbitStatus">
      <DDSChannel topicName="RUSV::SO::CIPE::CIPECBITReportType" typeName="CIPECBITReportType"/>
      <Field name="usvHeader"/>
      <Field name="cipeCBITStatus.cipeOperationalStatus" cdm="Health.CIPE.EquipmentLink"/>
      <Field name="cipeCBITStatus.operationalStatus" cdm="Health.CIPE.OperationalStatus"/>
    </MonitorBinding>
  </Monitors>
  <Controls semantic_id="control">
    <ControlBinding semantic_id="startIntegration">
      <DDSChannel topicName="RUSV::C2::RCU::IntegrationControlType" typeName="IntegrationControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <!--DestinationType: dstEquipmentType=0x03(SurfaceDetection), dstEquipmentID=0x03(NavRadarProcessorCard).-->
      <FixedField name="destination.dstEquipmentType" value="3"/>
      <FixedField name="destination.dstEquipmentID" value="3"/>
      <!--TBD: NavRadarProcessorCard의 dstSubEquipmentID는 공용 식별자 규칙에 별도 정의가 없어 실제 송신 적용값 확인 필요. 임의의 0/0xFF를 넣지 않는다.-->
      <Reply semantic_id="startIntegrationAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="restartSystem">
      <DDSChannel topicName="RUSV::C2::RCU::SystemRebootControlType" typeName="SystemRebootControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <!--DestinationType: dstEquipmentType=0x03(SurfaceDetection), dstEquipmentID=0x03(NavRadarProcessorCard).-->
      <FixedField name="destination.dstEquipmentType" value="3"/>
      <FixedField name="destination.dstEquipmentID" value="3"/>
      <!--TBD: NavRadarProcessorCard의 dstSubEquipmentID는 공용 식별자 규칙에 별도 정의가 없어 실제 송신 적용값 확인 필요. 임의의 0/0xFF를 넣지 않는다.-->
      <Reply semantic_id="restartSystemAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="requestIbit">
      <DDSChannel topicName="RUSV::SO::RCU::RCUIBITControlType" typeName="RCUIBITControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <!--DestinationType: dstEquipmentType=0x03(SurfaceDetection), dstEquipmentID=0x03(NavRadarProcessorCard).-->
      <FixedField name="destination.dstEquipmentType" value="3"/>
      <FixedField name="destination.dstEquipmentID" value="3"/>
      <!--TBD: NavRadarProcessorCard의 dstSubEquipmentID는 공용 식별자 규칙에 별도 정의가 없어 실제 송신 적용값 확인 필요. 임의의 0/0xFF를 넣지 않는다.-->
      <Reply semantic_id="requestIbitAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
      <Reply semantic_id="requestIbitResult">
        <DDSChannel topicName="RUSV::SO::CIPE::CIPEIBITReportType" typeName="CIPEIBITReportType"/>
        <Field name="usvHeader"/>
        <Field name="cipeIBITStatus.cipeOperationalStatus" cdm="Health.CIPE.EquipmentLink"/>
        <Field name="cipeIBITStatus.operationalStatus" cdm="Health.CIPE.OperationalStatus"/>
        <Field name="cipeIBITStatus.cipeProcessorIBIT.cpuTemperature" cdm="Health.Processor.CPUTemperature"/>
        <Field name="cipeIBITStatus.cipeProcessorIBIT.cpuLoad" cdm="Health.Processor.CPULoad"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="requestPbit">
      <DDSChannel topicName="RUSV::SO::RCU::RCUPBITControlType" typeName="RCUPBITControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <!--DestinationType: dstEquipmentType=0x03(SurfaceDetection), dstEquipmentID=0x03(NavRadarProcessorCard).-->
      <FixedField name="destination.dstEquipmentType" value="3"/>
      <FixedField name="destination.dstEquipmentID" value="3"/>
      <!--TBD: NavRadarProcessorCard의 dstSubEquipmentID는 공용 식별자 규칙에 별도 정의가 없어 실제 송신 적용값 확인 필요. 임의의 0/0xFF를 넣지 않는다.-->
      <Reply semantic_id="requestPbitAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
      <Reply semantic_id="requestPbitResult">
        <DDSChannel topicName="RUSV::SO::CIPE::CIPEPBITReportType" typeName="CIPEPBITReportType"/>
        <Field name="usvHeader"/>
        <Field name="cipePBITStatus.cipeOperationalStatus" cdm="Health.CIPE.EquipmentLink"/>
        <Field name="cipePBITStatus.operationalStatus" cdm="Health.CIPE.OperationalStatus"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="setRadarStandby">
      <DDSChannel topicName="RUSV::C2::RCU::RadarTransmitControlType" typeName="RadarTransmitControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <FixedField name="transmitterStatus" value="0"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <Reply semantic_id="setRadarStandbyAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="startRadarTransmit">
      <DDSChannel topicName="RUSV::C2::RCU::RadarTransmitControlType" typeName="RadarTransmitControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <FixedField name="transmitterStatus" value="1"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <Reply semantic_id="startRadarTransmitAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="setRadarRange">
      <DDSChannel topicName="RUSV::C2::RCU::RadarRangeControlType" typeName="RadarRangeControlType"/>
      <!--TBD: setTargetRange octet의 단위/범위/프리셋 변환 규칙 미정.-->
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <Field name="setTargetRange" cdm="Control.Radar.Range.CommandValue"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <Reply semantic_id="setRadarRangeAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="startRadarVideoStreaming">
      <DDSChannel topicName="RUSV::C2::RCU::RadarVideoStreamingControlType" typeName="RadarVideoStreamingControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <FixedField name="videoBroadcastStatus" value="1"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <Reply semantic_id="startRadarVideoStreamingAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="stopRadarVideoStreaming">
      <DDSChannel topicName="RUSV::C2::RCU::RadarVideoStreamingControlType" typeName="RadarVideoStreamingControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <FixedField name="videoBroadcastStatus" value="0"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <Reply semantic_id="stopRadarVideoStreamingAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="setAISMessageStandby">
      <DDSChannel topicName="RUSV::C2::RCU::AISMessageTransmitControlType" typeName="AISMessageTransmitControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <FixedField name="messageTransmitterStatus" value="0"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <Reply semantic_id="setAISMessageStandbyAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="startAISMessageTransmit">
      <DDSChannel topicName="RUSV::C2::RCU::AISMessageTransmitControlType" typeName="AISMessageTransmitControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <FixedField name="messageTransmitterStatus" value="1"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <Reply semantic_id="startAISMessageTransmitAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="setAISRange">
      <DDSChannel topicName="RUSV::C2::RCU::AISRangeFilterControlType" typeName="AISRangeFilterControlType"/>
      <!--TBD: setAISRange octet의 단위/범위/프리셋 변환 규칙 미정.-->
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase" converter="BuildUSVMessageBase"/>
      <Field name="setAISRange" cdm="Control.AIS.Range.CommandValue"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" converter="UInt16"/>
      <Reply semantic_id="setAISRangeAck" required="true">
        <DDSChannel topicName="RUSV::C2::CIPE::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID"/>
      </Reply>
    </ControlBinding>
  </Controls>
  <SensorProducts semantic_id="sensorProduct">
    <ProductBinding semantic_id="radarVideo">
      <!--CSCI는 항해레이더 스트리밍 영상을 RTP, 약 1 Mbps로 정의. IP/Port 등 통신 설정은 현재 ProductBinding 명세 범위에서 제외.-->
      <RTPChannel/>
    </ProductBinding>
  </SensorProducts>
</SensorBinding>
