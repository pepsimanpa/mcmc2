<?xml version='1.0' encoding='UTF-8'?>
<SensorSpec xmlns="http://lignex1.com/mcmc2/umsSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ../../XSD/CommonSpecSchema.xsd">
  <!--전자광학장치(EOIR) Semantic: 전자광학장치 CSCI + 원격통제장치 CSCI + 공용 구조체/식별자 규칙 기반-->
  <!--범위는 원격통제장치 CSCI ↔ 전자광학장치 CSCI 직접 연동에 한정하며 전자광학장치 영상처리 CSC 연동은 제외한다.-->
  <!--물리 enum code, DDS primitive type, scale/sentinel은 Binding 책임으로 두며 Semantic에는 운용 의미만 선언한다.-->
  <ConstantSpecs id="constant">
    <TextConstantSpec id="productName" name="제품명" cdm="Product.Name"><Value>EOIR</Value></TextConstantSpec>
    <TextConstantSpec id="productDescription" name="제품 설명" cdm="Product.Description"><Value>EO/MWIR/SWIR 영상, 추적, LRF, 상태 감시 및 원격 구동/센서 제어 인터페이스</Value></TextConstantSpec>
  </ConstantSpecs>
  <MonitorSpecs id="monitor">
    <GroupSpec id="trackingStatus" name="EOIR 접촉물 추적 상태" cdm="EOIR.Tracking.Status">
      <ValueSetSpec id="trackingStatus1" name="1차 표적 추적 상태" cdm="EOIR.Tracking.Target1.Status"><Values><Value name="None" cdm="Tracking.Command.None"/><Value name="Active" cdm="Tracking.Active"/><Value name="Stopped" cdm="Tracking.Stopped"/><Value name="Failed" cdm="Tracking.Failed"/></Values></ValueSetSpec>
      <ValueSetSpec id="trackingStatus2" name="2차 표적 추적 상태" cdm="EOIR.Tracking.Target2.Status"><Values><Value name="None" cdm="Tracking.Command.None"/><Value name="Active" cdm="Tracking.Active"/><Value name="Stopped" cdm="Tracking.Stopped"/><Value name="Failed" cdm="Tracking.Failed"/></Values></ValueSetSpec>
      <!--원본 CSCI의 trackingSensor에는 Undefined/EO/MWIR만 정의되어 있으며 SWIR 추적 지원 값은 확인되지 않는다.-->
      <ValueSetSpec id="trackingSensor" name="추적 영상 채널" cdm="EOIR.Tracking.Sensor"><Values><Value name="Undefined" cdm="EOIR.Tracking.Sensor.Undef"/><Value name="EO" cdm="EOIR.Tracking.Sensor.EO"/><Value name="MWIR" cdm="EOIR.Tracking.Sensor.MWIR"/></Values></ValueSetSpec>
      <ValueSetSpec id="target1Number" name="1차 표적 번호" cdm="EOIR.Tracking.Target1.Number"><Values><Value name="First" cdm="EOIR.Tracking.Target.First"/><Value name="Second" cdm="EOIR.Tracking.Target.Second"/></Values></ValueSetSpec>
      <QuantitySpec id="target1CenterX" name="1차 표적 중심 X" cdm="EOIR.Tracking.Target1.CenterX"><Unit>pixel</Unit><Range min="0" max="1919"/></QuantitySpec>
      <QuantitySpec id="target1CenterY" name="1차 표적 중심 Y" cdm="EOIR.Tracking.Target1.CenterY"><Unit>pixel</Unit><Range min="0" max="1079"/></QuantitySpec>
      <QuantitySpec id="target1Width" name="1차 표적 수평크기" cdm="EOIR.Tracking.Target1.Width"><Unit>pixel</Unit><Range min="0" max="1920"/></QuantitySpec>
      <QuantitySpec id="target1Height" name="1차 표적 수직크기" cdm="EOIR.Tracking.Target1.Height"><Unit>pixel</Unit><Range min="0" max="1080"/></QuantitySpec>
      <ValueSetSpec id="target2Number" name="2차 표적 번호" cdm="EOIR.Tracking.Target2.Number"><Values><Value name="First" cdm="EOIR.Tracking.Target.First"/><Value name="Second" cdm="EOIR.Tracking.Target.Second"/></Values></ValueSetSpec>
      <QuantitySpec id="target2CenterX" name="2차 표적 중심 X" cdm="EOIR.Tracking.Target2.CenterX"><Unit>pixel</Unit><Range min="0" max="1919"/></QuantitySpec>
      <QuantitySpec id="target2CenterY" name="2차 표적 중심 Y" cdm="EOIR.Tracking.Target2.CenterY"><Unit>pixel</Unit><Range min="0" max="1079"/></QuantitySpec>
      <QuantitySpec id="target2Width" name="2차 표적 수평크기" cdm="EOIR.Tracking.Target2.Width"><Unit>pixel</Unit><Range min="0" max="1920"/></QuantitySpec>
      <QuantitySpec id="target2Height" name="2차 표적 수직크기" cdm="EOIR.Tracking.Target2.Height"><Unit>pixel</Unit><Range min="0" max="1080"/></QuantitySpec>
    </GroupSpec>
    <GroupSpec id="lrfMeasurement" name="LRF 측정 정보" cdm="EOIR.LRF.Measurement"><QuantitySpec id="distance" name="LRF 측정 거리" cdm="EOIR.LRF.Distance"><Unit>m</Unit><Range min="1" max="50000"/><Resolution>1</Resolution></QuantitySpec></GroupSpec>
    <GroupSpec id="eoirStatus" name="전자광학장치 상태" cdm="EOIR.Status">
      <ValueSetSpec id="eoirMode" name="EOIR 운용 모드" cdm="EOIR.Mode"><Values><Value name="Standby" cdm="EOIR.Mode.Standby"/><Value name="ManualDrive" cdm="EOIR.Mode.ManualDrive"/><Value name="Tracking" cdm="EOIR.Mode.Tracking"/><Value name="RadarLinked" cdm="EOIR.Mode.RadarLinked"/><Value name="RCWSLinked" cdm="EOIR.Mode.RCWSLinked"/><Value name="BowPointing" cdm="EOIR.Mode.BowPointing"/><Value name="Swing" cdm="EOIR.Mode.Swing"/><Value name="Stow" cdm="EOIR.Mode.Stow"/></Values></ValueSetSpec>
      <QuantitySpec id="statusPanLocation" name="EOIR PAN 현재 위치" cdm="EOIR.Position.Pan"><Unit>deg</Unit><Range min="-180" max="180"/><Resolution>0.01</Resolution></QuantitySpec>
      <QuantitySpec id="statusTiltLocation" name="EOIR TILT 현재 위치" cdm="EOIR.Position.Tilt"><Unit>deg</Unit><Range min="-90" max="90"/><Resolution>0.01</Resolution></QuantitySpec>
      <QuantitySpec id="statusEoZoom" name="EO 카메라 Zoom 단계" cdm="EOIR.EO.Zoom.Step"><Unit>num</Unit><Range min="0" max="1000"/></QuantitySpec>
      <QuantitySpec id="statusIrZoom" name="IR 카메라 Zoom 단계" cdm="EOIR.IR.Zoom.Step"><Unit>num</Unit><Range min="0" max="1000"/></QuantitySpec>
      <QuantitySpec id="statusHFOV" name="수평 화각(HFOV)" cdm="EOIR.FOV.Horizontal"><Unit>deg</Unit><Resolution>0.01</Resolution></QuantitySpec>
      <QuantitySpec id="statusVFOV" name="수직 화각(VFOV)" cdm="EOIR.FOV.Vertical"><Unit>deg</Unit><Resolution>0.01</Resolution></QuantitySpec>
      <BooleanSpec id="statusEoirLock" name="EOIR LOCK 상태" cdm="EOIR.Tracking.Lock"/>
      <QuantitySpec id="statusBrightness" name="탐조등 밝기" cdm="EOIR.Illuminator.Brightness"><Unit>num</Unit><Range min="0" max="255"/></QuantitySpec>
      <QuantitySpec id="statusBeamAngle" name="탐조등 광원 범위" cdm="EOIR.Illuminator.BeamRange"><Unit>num</Unit><Range min="0" max="1000"/></QuantitySpec>
      <QuantitySpec id="statusLrfLife" name="LRF 수명 비율" cdm="EOIR.LRF.LifePercent"><Unit>%</Unit><Range min="0" max="100"/><Resolution>0.01</Resolution></QuantitySpec>
      <!--statusMwirUsedTime의 실제 시간 단위는 원본에 없다.--><QuantitySpec id="statusMwirUsedTime" name="MWIR 사용시간" cdm="EOIR.MWIR.UsageTime"><Range min="0" max="65535"/></QuantitySpec>
    </GroupSpec>
    <GroupSpec id="eoirCbitStatus" name="전자광학장치 CBIT 상태" cdm="Health.CBIT.EOIR">
      <ValueSetSpec id="statusEoir" name="전자광학장치 상태" cdm="Health.EOIR.Overall"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetSpec>
      <ValueSetSpec id="statusCameraAssembly" name="카메라 조립체 상태" cdm="Health.EOIR.CameraAssembly"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetSpec>
      <ValueSetSpec id="statusMainBodyAssembly" name="주몸체조립체 상태" cdm="Health.EOIR.MainBodyAssembly"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetSpec>
    </GroupSpec>
  </MonitorSpecs>
  <ControlSpecs id="control">
    <ControlSpec id="startIntegration" name="연동 개시 명령" cdm="Control.Integration.Start"><Reply bindRef="startIntegrationAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply></ControlSpec>
    <ControlSpec id="restartSystem" name="시스템 재시작 명령" cdm="Control.System.Restart"><Reply bindRef="restartSystemAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply></ControlSpec>
    <ControlSpec id="requestIbit" name="IBIT 명령" cdm="Request.Health.IBIT">
      <Reply bindRef="requestIbitAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply>
      <Reply bindRef="requestIbitResult" cdm="Request.Health.IBIT.Response" required="true"><Results><GroupResult name="eoirIbit" cdm="Health.IBIT.EOIR"><ValueSetResult name="statusEoir" cdm="Health.EOIR.IBIT.Overall"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult name="statusCameraAssembly" cdm="Health.EOIR.IBIT.CameraAssembly"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><Result name="statusInternalGimbal" cdm="Health.EOIR.IBIT.InternalGimbal.Raw"/><Result name="statusSensorAssembly1" cdm="Health.EOIR.IBIT.SensorAssembly1.Raw"/><Result name="statusSensorAssembly2" cdm="Health.EOIR.IBIT.SensorAssembly2.Raw"/><Result name="statusPowerSwir" cdm="Health.EOIR.IBIT.SWIR.Power"/><Result name="statusControlSwir" cdm="Health.EOIR.IBIT.SWIR.Control"/><ValueSetResult name="statusMainBodyAssembly" cdm="Health.EOIR.IBIT.MainBodyAssembly"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><Result name="statusExternalGimbal" cdm="Health.EOIR.IBIT.ExternalGimbal.Raw"/><Result name="statusStabilizationControlBoard" cdm="Health.EOIR.IBIT.StabilizationControlBoard.Raw"/></GroupResult></Results></Reply>
    </ControlSpec>
    <ControlSpec id="requestPbit" name="PBIT 명령" cdm="Request.Health.PBIT"><Reply bindRef="requestPbitAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply><Reply bindRef="requestPbitResult" cdm="Request.Health.PBIT.Response" required="true"><Results><GroupResult name="eoirPbit" cdm="Health.PBIT.EOIR"><ValueSetResult name="statusEoir" cdm="Health.EOIR.PBIT.Overall"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult name="statusCameraAssembly" cdm="Health.EOIR.PBIT.CameraAssembly"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult name="statusMainBodyAssembly" cdm="Health.EOIR.PBIT.MainBodyAssembly"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult></GroupResult></Results></Reply></ControlSpec>
    <ControlSpec id="setOperationMode" name="EOIR 운용모드 설정" cdm="Control.EOIR.Mode.Set"><Parameters><ValueSetProfile cdm="Control.EOIR.Mode.Command"><Values><Value name="Standby" cdm="EOIR.Mode.Standby"/><Value name="ManualDrive" cdm="EOIR.Mode.ManualDrive"/><Value name="Tracking" cdm="EOIR.Mode.Tracking"/><Value name="RadarLinked" cdm="EOIR.Mode.RadarLinked"/><Value name="RCWSLinked" cdm="EOIR.Mode.RCWSLinked"/><Value name="BowPointing" cdm="EOIR.Mode.BowPointing"/><Value name="Swing" cdm="EOIR.Mode.Swing"/><Value name="Stow" cdm="EOIR.Mode.Stow"/></Values></ValueSetProfile></Parameters><Reply bindRef="setOperationModeAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply></ControlSpec>
    <ControlSpec id="controlByJoystick" name="EOIR 조이스틱 구동 제어" cdm="Control.EOIR.Motion.Joystick"><Parameters><QuantityProfile cdm="Control.EOIR.Joystick.Pan"><Unit>%</Unit><Range min="-100" max="100"/></QuantityProfile><QuantityProfile cdm="Control.EOIR.Joystick.Tilt"><Unit>%</Unit><Range min="-100" max="100"/></QuantityProfile></Parameters><Reply bindRef="controlByJoystickAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply></ControlSpec>
    <ControlSpec id="pointToPosition" name="EOIR 설정값 구동 제어" cdm="Control.EOIR.Motion.Position"><Parameters><BooleanProfile cdm="Control.EOIR.Position.ReferenceTrueNorth"/><QuantityProfile cdm="Control.EOIR.Position.Pan"><Unit>deg</Unit><Resolution>0.01</Resolution></QuantityProfile><QuantityProfile cdm="Control.EOIR.Position.Tilt"><Unit>deg</Unit><Range min="-90" max="90"/><Resolution>0.01</Resolution></QuantityProfile></Parameters><Reply bindRef="pointToPositionAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply></ControlSpec>
    <ControlSpec id="controlTracking" name="EOIR 접촉물 추적 제어" cdm="Control.EOIR.Tracking"><Parameters><BooleanProfile cdm="Control.EOIR.Tracking.AutoEnabled"/><ValueSetProfile cdm="Control.EOIR.Tracking.TargetSetting"><Values><Value name="NoChange" cdm="EOIR.Tracking.TargetSetting.NoChange"/><Value name="SetTarget1" cdm="EOIR.Tracking.TargetSetting.SetTarget1"/><Value name="SetTarget2" cdm="EOIR.Tracking.TargetSetting.SetTarget2"/><Value name="CancelTarget1" cdm="EOIR.Tracking.TargetSetting.CancelTarget1"/><Value name="CancelTarget2" cdm="EOIR.Tracking.TargetSetting.CancelTarget2"/></Values></ValueSetProfile><BooleanProfile cdm="Control.EOIR.Tracking.PriorityChange"/><ValueSetProfile cdm="Control.EOIR.Tracking.SensorSelection"><Values><Value name="Previous" cdm="EOIR.Tracking.Sensor.Previous"/><Value name="EO" cdm="EOIR.Tracking.Sensor.EO"/><Value name="MWIR" cdm="EOIR.Tracking.Sensor.MWIR"/></Values></ValueSetProfile><QuantityProfile cdm="Control.EOIR.Tracking.Target1.CenterX"><Unit>pixel</Unit><Range min="0" max="1919"/></QuantityProfile><QuantityProfile cdm="Control.EOIR.Tracking.Target1.CenterY"><Unit>pixel</Unit><Range min="0" max="1079"/></QuantityProfile><QuantityProfile cdm="Control.EOIR.Tracking.Target1.Width"><Unit>pixel</Unit><Range min="0" max="1920"/></QuantityProfile><QuantityProfile cdm="Control.EOIR.Tracking.Target1.Height"><Unit>pixel</Unit><Range min="0" max="1080"/></QuantityProfile><QuantityProfile cdm="Control.EOIR.Tracking.Target2.CenterX"><Unit>pixel</Unit><Range min="0" max="1919"/></QuantityProfile><QuantityProfile cdm="Control.EOIR.Tracking.Target2.CenterY"><Unit>pixel</Unit><Range min="0" max="1079"/></QuantityProfile><QuantityProfile cdm="Control.EOIR.Tracking.Target2.Width"><Unit>pixel</Unit><Range min="0" max="1920"/></QuantityProfile><QuantityProfile cdm="Control.EOIR.Tracking.Target2.Height"><Unit>pixel</Unit><Range min="0" max="1080"/></QuantityProfile></Parameters><Reply bindRef="controlTrackingAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply></ControlSpec>
    <ControlSpec id="pointToRadarTarget" name="항해레이더 지향 목표 표적 설정" cdm="Control.EOIR.Pointing.RadarTarget"><Parameters><QuantityProfile cdm="Control.EOIR.Pointing.RadarTarget.Identifier"><Unit>num</Unit><Range min="1" max="65534"/></QuantityProfile></Parameters><Reply bindRef="pointToRadarTargetAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply></ControlSpec>
    <!--swingSpeedResult은 원문 Unit이 deg로 표기되지만 필드 설명은 속도/각속도이므로 deg/s로 추정하지 않고 원문 Unit을 보존하며 OpenIssues에 남긴다.-->
    <ControlSpec id="configureSwing" name="EOIR 스윙 설정" cdm="Control.EOIR.Swing"><Parameters><BooleanProfile cdm="Control.EOIR.Swing.Enabled"/><QuantityProfile cdm="Control.EOIR.Swing.StartAngle"><Unit>deg</Unit><Range min="-180" max="180"/><Resolution>0.01</Resolution></QuantityProfile><QuantityProfile cdm="Control.EOIR.Swing.EndAngle"><Unit>deg</Unit><Range min="-180" max="180"/><Resolution>0.01</Resolution></QuantityProfile><QuantityProfile cdm="Control.EOIR.Swing.Speed"><Unit>deg</Unit><Range min="0" max="180"/><Resolution>0.01</Resolution></QuantityProfile></Parameters><Reply bindRef="configureSwingAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply></ControlSpec>
    <ControlSpec id="switchIrVideo" name="IR 영상 전환" cdm="Control.EOIR.Video.IR.Switch"><Parameters><BooleanProfile cdm="Control.EOIR.Video.IR.UseSWIR"/></Parameters><Reply bindRef="switchIrVideoAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply></ControlSpec>
    <ControlSpec id="controlZoom" name="EOIR Zoom 설정" cdm="Control.EOIR.Zoom"><Parameters><BooleanProfile cdm="Control.EOIR.Zoom.UseMWIR"/><ValueSetProfile cdm="Control.EOIR.Zoom.Mode"><Values><Value name="NoChange" cdm="EOIR.Zoom.Mode.NoChange"/><Value name="Continuous" cdm="EOIR.Zoom.Mode.Continuous"/><Value name="Position" cdm="EOIR.Zoom.Mode.Position"/></Values></ValueSetProfile><ValueSetProfile cdm="Control.EOIR.Zoom.Continuous"><Values><Value name="NoAction" cdm="EOIR.Zoom.Continuous.NoAction"/><Value name="ZoomIn" cdm="EOIR.Zoom.Continuous.In"/><Value name="ZoomOut" cdm="EOIR.Zoom.Continuous.Out"/><Value name="Stop" cdm="EOIR.Zoom.Continuous.Stop"/></Values></ValueSetProfile><QuantityProfile cdm="Control.EOIR.Zoom.Position"><Unit>%</Unit><Range min="0" max="500"/><Resolution>0.5</Resolution></QuantityProfile></Parameters><Reply bindRef="controlZoomAck" cdm="Command.ProcessingStatus.Response" required="true"><Results><Result name="commandStatusReport.status" cdm="Control.Response.Status"/></Results></Reply></ControlSpec>
