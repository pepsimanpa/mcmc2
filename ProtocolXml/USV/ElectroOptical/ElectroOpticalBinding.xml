<?xml version='1.0' encoding='UTF-8'?>
<SensorBinding xmlns="http://lignex1.com/mcmc2/umsSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ../../XSD/CommonBindingSchema.xsd">
  <!--전자광학장치(EOIR) Binding: 원격통제장치 CSCI ↔ 전자광학장치 CSCI 직접 연동 DDS/RTP 매핑-->
  <!--공용 식별자: SurfaceDetection=0x03 / EOIR=0x05 / subEquipment=0x00. 공용 Control destination은 OM/Adapter의 System.Target.ElectroOptical이 준비한다.-->
  <!--원 CSCI primitive가 실제 boolean인 직접 DDS 필드는 공용 WireDataType Boolean으로 선언한다. Semantic Boolean이라도 원 wire가 octet/bit/sentinel이면 해당 물리 표현을 유지한다.-->
  <Monitors semantic_id="monitor">
        <MonitorBinding semantic_id="trackingStatus">
      <!--target1/target2는 공용 EOIRTrackingBboxType 구조체이며 dotted path로 하위 필드를 매핑한다. SWIR trackingSensor 값은 원본 CSCI에 없음(TBD).-->
      <DDSChannel topicName="RUSV::SA::EOIR::TrackingReportType" typeName="TrackingReportType"/>
      <Field name="usvHeader"/>
      <Field name="trackingStatus1" cdm="EOIR.Tracking.Target1.Status" dataType="UInt8">
        <ValueMap>
          <Map cdm="Tracking.Command.None" value="0"/>
          <Map cdm="Tracking.Active" value="1"/>
          <Map cdm="Tracking.Stopped" value="2"/>
          <Map cdm="Tracking.Failed" value="3"/>
        </ValueMap>
      </Field>
      <Field name="trackingStatus2" cdm="EOIR.Tracking.Target2.Status" dataType="UInt8">
        <ValueMap>
          <Map cdm="Tracking.Command.None" value="0"/>
          <Map cdm="Tracking.Active" value="1"/>
          <Map cdm="Tracking.Stopped" value="2"/>
          <Map cdm="Tracking.Failed" value="3"/>
        </ValueMap>
      </Field>
      <Field name="trackingSensor" cdm="EOIR.Tracking.Sensor" dataType="UInt8">
        <ValueMap>
          <Map cdm="EOIR.Tracking.Sensor.Undef" value="0"/>
          <Map cdm="EOIR.Tracking.Sensor.EO" value="1"/>
          <Map cdm="EOIR.Tracking.Sensor.MWIR" value="2"/>
        </ValueMap>
      </Field>
      <Field name="target1.targetNumber" cdm="EOIR.Tracking.Target1.Number" dataType="UInt8">
        <ValueMap>
          <Map cdm="EOIR.Tracking.Target.First" value="0"/>
          <Map cdm="EOIR.Tracking.Target.Second" value="1"/>
        </ValueMap>
      </Field>
      <Field name="target1.centerX" cdm="EOIR.Tracking.Target1.CenterX" dataType="UInt16"/>
      <Field name="target1.centerY" cdm="EOIR.Tracking.Target1.CenterY" dataType="UInt16"/>
      <Field name="target1.width" cdm="EOIR.Tracking.Target1.Width" dataType="UInt16"/>
      <Field name="target1.height" cdm="EOIR.Tracking.Target1.Height" dataType="UInt16"/>
      <Field name="target2.targetNumber" cdm="EOIR.Tracking.Target2.Number" dataType="UInt8">
        <ValueMap>
          <Map cdm="EOIR.Tracking.Target.First" value="0"/>
          <Map cdm="EOIR.Tracking.Target.Second" value="1"/>
        </ValueMap>
      </Field>
      <Field name="target2.centerX" cdm="EOIR.Tracking.Target2.CenterX" dataType="UInt16"/>
      <Field name="target2.centerY" cdm="EOIR.Tracking.Target2.CenterY" dataType="UInt16"/>
      <Field name="target2.width" cdm="EOIR.Tracking.Target2.Width" dataType="UInt16"/>
      <Field name="target2.height" cdm="EOIR.Tracking.Target2.Height" dataType="UInt16"/>
    </MonitorBinding>
        <MonitorBinding semantic_id="lrfMeasurement">
      <!--statusDistance: 1~50000은 m 거리, 0=Unknown, 65535=Fail. Semantic Range는 유효 거리만 표현하며 특수값은 구현에서 상태 처리한다.-->
      <DDSChannel topicName="RUSV::SA::EOIR::LRFReportType" typeName="LRFReportType"/>
      <Field name="usvHeader"/>
      <!--0=Unknown, 65535=Fail은 물리 특수값이며 유효 거리는 1~50000 m.-->
      <Field name="statusDistance" cdm="EOIR.LRF.Distance" dataType="UInt16"/>
    </MonitorBinding>
        <MonitorBinding semantic_id="eoirStatus">
      <!--statusLrfLife는 CSCI 명시 규칙에 따라 raw/100으로 % 변환한다. statusMwirUsedTime의 시간 단위는 원본에 없음(TBD).-->
      <DDSChannel topicName="RUSV::SO::EOIR::EOIRHeartBeatReportType" typeName="EOIRHeartBeatReportType"/>
      <Field name="usvHeader"/>
      <Field name="eoirMode" cdm="EOIR.Mode" dataType="UInt8">
        <ValueMap>
          <Map cdm="EOIR.Mode.Standby" value="0"/>
          <Map cdm="EOIR.Mode.ManualDrive" value="1"/>
          <Map cdm="EOIR.Mode.Tracking" value="2"/>
          <Map cdm="EOIR.Mode.RadarLinked" value="3"/>
          <Map cdm="EOIR.Mode.RCWSLinked" value="4"/>
          <Map cdm="EOIR.Mode.BowPointing" value="5"/>
          <Map cdm="EOIR.Mode.Swing" value="6"/>
          <Map cdm="EOIR.Mode.Stow" value="7"/>
        </ValueMap>
      </Field>
      <Field name="statusPanLocation" cdm="EOIR.Position.Pan" dataType="Float32"/>
      <Field name="statusTiltLocation" cdm="EOIR.Position.Tilt" dataType="Float32"/>
      <Field name="statusEoZoom" cdm="EOIR.EO.Zoom.Step" dataType="UInt16"/>
      <Field name="statusIrZoom" cdm="EOIR.IR.Zoom.Step" dataType="UInt16"/>
      <Field name="statusHFOV" cdm="EOIR.FOV.Horizontal" dataType="Float32"/>
      <Field name="statusVFOV" cdm="EOIR.FOV.Vertical" dataType="Float32"/>
      <Field name="statusEoirLock" cdm="EOIR.Tracking.Lock" dataType="Boolean"/>
      <Field name="statusBrightness" cdm="EOIR.Illuminator.Brightness" dataType="UInt8"/>
      <Field name="statusBeamAngle" cdm="EOIR.Illuminator.BeamRange" dataType="UInt16"/>
      <!--Semantic percent -> wire raw는 x100. 수신 시 wire/100.-->
      <Field name="statusLrfLife" cdm="EOIR.LRF.LifePercent" dataType="UInt16" scale="100"/>
      <Field name="statusMwirUsedTime" cdm="EOIR.MWIR.UsageTime" dataType="UInt16"/>
    </MonitorBinding>
        <MonitorBinding semantic_id="eoirCbitStatus">
      <DDSChannel topicName="RUSV::SO::EOIR::EOIRCBITReportType" typeName="EOIRCBITReportType"/>
      <Field name="usvHeader"/>
      <Field name="statusEoir" cdm="Health.EOIR.Overall" dataType="UInt8">
        <ValueMap>
          <Map cdm="Health.Normal" value="0"/>
          <Map cdm="Health.Degraded" value="1"/>
          <Map cdm="Health.Unavailable" value="2"/>
          <Map cdm="Health.NoResponse" value="3"/>
        </ValueMap>
      </Field>
      <Field name="statusCameraAssembly" cdm="Health.EOIR.CameraAssembly" dataType="UInt8">
        <ValueMap>
          <Map cdm="Health.Normal" value="0"/>
          <Map cdm="Health.Degraded" value="1"/>
          <Map cdm="Health.Unavailable" value="2"/>
          <Map cdm="Health.NoResponse" value="3"/>
        </ValueMap>
      </Field>
      <Field name="statusMainBodyAssembly" cdm="Health.EOIR.MainBodyAssembly" dataType="UInt8">
        <ValueMap>
          <Map cdm="Health.Normal" value="0"/>
          <Map cdm="Health.Degraded" value="1"/>
          <Map cdm="Health.Unavailable" value="2"/>
          <Map cdm="Health.NoResponse" value="3"/>
        </ValueMap>
      </Field>
    </MonitorBinding>
  </Monitors>
  <Controls semantic_id="control">
        <ControlBinding semantic_id="startIntegration">
      <!--전자광학장치는 equipmentType=0x03, equipmentID=0x05만으로 식별되며 별도 세부 장비 ID가 정의되어 있지 않아 dstSubEquipmentID는 미사용값 0x00을 적용한다.-->
      <DDSChannel topicName="RUSV::C2::RCU::IntegrationControlType" typeName="IntegrationControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="destination" sourceField="System.Target.ElectroOptical"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Reply semantic_id="startIntegrationAck" required="true">
        <DDSChannel topicName="RUSV::C2::EOIR::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
    </ControlBinding>
        <ControlBinding semantic_id="restartSystem">
      <!--전자광학장치는 equipmentType=0x03, equipmentID=0x05만으로 식별되며 별도 세부 장비 ID가 정의되어 있지 않아 dstSubEquipmentID는 미사용값 0x00을 적용한다.-->
      <DDSChannel topicName="RUSV::C2::RCU::SystemRebootControlType" typeName="SystemRebootControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="destination" sourceField="System.Target.ElectroOptical"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Reply semantic_id="restartSystemAck" required="true">
        <DDSChannel topicName="RUSV::C2::EOIR::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
    </ControlBinding>
        <ControlBinding semantic_id="requestIbit">
      <!--전자광학장치는 equipmentType=0x03, equipmentID=0x05만으로 식별되며 별도 세부 장비 ID가 정의되어 있지 않아 dstSubEquipmentID는 미사용값 0x00을 적용한다.-->
      <!--IBIT detail 5개 octet은 CSCI가 bit 위치와 점검 대상을 직접 명시하므로 PackedField/BitMember로 분해한다. 다만 각 bit의 0/1 정상/이상 polarity는 직접 정의되지 않아 bit별 Raw 의미로 유지한다.-->
      <DDSChannel topicName="RUSV::SO::RCU::RCUIBITControlType" typeName="RCUIBITControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="destination" sourceField="System.Target.ElectroOptical"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Reply semantic_id="requestIbitAck" required="true">
        <DDSChannel topicName="RUSV::C2::EOIR::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
      <Reply semantic_id="requestIbitResult" required="true">
        <DDSChannel topicName="RUSV::SO::EOIR::EOIRIBITReportType" typeName="EOIRIBITReportType"/>
        <Field name="usvHeader"/>
        <Field name="statusEoir" cdm="Health.EOIR.IBIT.Overall" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.Normal" value="0"/>
            <Map cdm="Health.Degraded" value="1"/>
            <Map cdm="Health.Unavailable" value="2"/>
            <Map cdm="Health.NoResponse" value="3"/>
          </ValueMap>
        </Field>
        <Field name="statusCameraAssembly" cdm="Health.EOIR.IBIT.CameraAssembly" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.Normal" value="0"/>
            <Map cdm="Health.Degraded" value="1"/>
            <Map cdm="Health.Unavailable" value="2"/>
            <Map cdm="Health.NoResponse" value="3"/>
          </ValueMap>
        </Field>
        <PackedField name="statusInternalGimbal" width="8" defaultValue="0">
          <BitMember name="internalAzimuthMotorDrive" cdm="Health.EOIR.IBIT.InternalGimbal.InternalAzimuthMotorDrive.Raw" offset="0"/>
          <BitMember name="internalElevationMotorDrive" cdm="Health.EOIR.IBIT.InternalGimbal.InternalElevationMotorDrive.Raw" offset="1"/>
          <BitMember name="internalAzimuthEncoderCommunication" cdm="Health.EOIR.IBIT.InternalGimbal.InternalAzimuthEncoderCommunication.Raw" offset="2"/>
          <BitMember name="internalElevationEncoderCommunication" cdm="Health.EOIR.IBIT.InternalGimbal.InternalElevationEncoderCommunication.Raw" offset="3"/>
        </PackedField>
        <PackedField name="statusSensorAssembly1" width="8" defaultValue="0">
          <BitMember name="eoCameraPower" cdm="Health.EOIR.IBIT.SensorAssembly1.EOCameraPower.Raw" offset="0"/>
          <BitMember name="eoCameraControl" cdm="Health.EOIR.IBIT.SensorAssembly1.EOCameraControl.Raw" offset="1"/>
          <BitMember name="mwirCameraPower" cdm="Health.EOIR.IBIT.SensorAssembly1.MWIRCameraPower.Raw" offset="2"/>
          <BitMember name="mwirCameraControl" cdm="Health.EOIR.IBIT.SensorAssembly1.MWIRCameraControl.Raw" offset="3"/>
          <BitMember name="illuminatorPower" cdm="Health.EOIR.IBIT.SensorAssembly1.IlluminatorPower.Raw" offset="4"/>
          <BitMember name="illuminatorControl" cdm="Health.EOIR.IBIT.SensorAssembly1.IlluminatorControl.Raw" offset="5"/>
          <BitMember name="lrfPower" cdm="Health.EOIR.IBIT.SensorAssembly1.LRFPower.Raw" offset="6"/>
          <BitMember name="lrfControl" cdm="Health.EOIR.IBIT.SensorAssembly1.LRFControl.Raw" offset="7"/>
        </PackedField>
        <PackedField name="statusSensorAssembly2" width="8" defaultValue="0">
          <BitMember name="imuCommunication" cdm="Health.EOIR.IBIT.SensorAssembly2.IMUCommunication.Raw" offset="0"/>
          <BitMember name="cameraControlBoardControl" cdm="Health.EOIR.IBIT.SensorAssembly2.CameraControlBoardControl.Raw" offset="1"/>
          <BitMember name="imageTrackingBoardControl" cdm="Health.EOIR.IBIT.SensorAssembly2.ImageTrackingBoardControl.Raw" offset="2"/>
          <BitMember name="wiperOperation" cdm="Health.EOIR.IBIT.SensorAssembly2.WiperOperation.Raw" offset="3"/>
        </PackedField>
        <Field name="statusPowerSwir" cdm="Health.EOIR.IBIT.SWIR.Power" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.Normal" value="0"/>
            <Map cdm="Health.Degraded" value="1"/>
            <Map cdm="Health.Unavailable" value="2"/>
            <Map cdm="Health.NoResponse" value="3"/>
          </ValueMap>
        </Field>
        <Field name="statusControlSwir" cdm="Health.EOIR.IBIT.SWIR.Control" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.Normal" value="0"/>
            <Map cdm="Health.Degraded" value="1"/>
            <Map cdm="Health.Unavailable" value="2"/>
            <Map cdm="Health.NoResponse" value="3"/>
          </ValueMap>
        </Field>
        <Field name="statusMainBodyAssembly" cdm="Health.EOIR.IBIT.MainBodyAssembly" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.Normal" value="0"/>
            <Map cdm="Health.Degraded" value="1"/>
            <Map cdm="Health.Unavailable" value="2"/>
            <Map cdm="Health.NoResponse" value="3"/>
          </ValueMap>
        </Field>
        <PackedField name="statusExternalGimbal" width="8" defaultValue="0">
          <BitMember name="externalAzimuthMotorDrive" cdm="Health.EOIR.IBIT.ExternalGimbal.ExternalAzimuthMotorDrive.Raw" offset="0"/>
          <BitMember name="externalElevationMotorDrive" cdm="Health.EOIR.IBIT.ExternalGimbal.ExternalElevationMotorDrive.Raw" offset="1"/>
          <BitMember name="externalAzimuthEncoderCommunication" cdm="Health.EOIR.IBIT.ExternalGimbal.ExternalAzimuthEncoderCommunication.Raw" offset="2"/>
          <BitMember name="externalElevationEncoderCommunication" cdm="Health.EOIR.IBIT.ExternalGimbal.ExternalElevationEncoderCommunication.Raw" offset="3"/>
        </PackedField>
        <PackedField name="statusStabilizationControlBoard" width="8" defaultValue="0">
          <BitMember name="stabilizationControlBoardControl" cdm="Health.EOIR.IBIT.StabilizationControlBoard.Control.Raw" offset="0"/>
        </PackedField>
      </Reply>
    </ControlBinding>
        <ControlBinding semantic_id="requestPbit">
      <!--전자광학장치는 equipmentType=0x03, equipmentID=0x05만으로 식별되며 별도 세부 장비 ID가 정의되어 있지 않아 dstSubEquipmentID는 미사용값 0x00을 적용한다.-->
      <DDSChannel topicName="RUSV::SO::RCU::RCUPBITControlType" typeName="RCUPBITControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="destination" sourceField="System.Target.ElectroOptical"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Reply semantic_id="requestPbitAck" required="true">
        <DDSChannel topicName="RUSV::C2::EOIR::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
      <Reply semantic_id="requestPbitResult" required="true">
        <DDSChannel topicName="RUSV::SO::EOIR::EOIRPBITReportType" typeName="EOIRPBITReportType"/>
        <Field name="usvHeader"/>
        <Field name="statusEoir" cdm="Health.EOIR.PBIT.Overall" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.Normal" value="0"/>
            <Map cdm="Health.Degraded" value="1"/>
            <Map cdm="Health.Unavailable" value="2"/>
            <Map cdm="Health.NoResponse" value="3"/>
          </ValueMap>
        </Field>
        <Field name="statusCameraAssembly" cdm="Health.EOIR.PBIT.CameraAssembly" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.Normal" value="0"/>
            <Map cdm="Health.Degraded" value="1"/>
            <Map cdm="Health.Unavailable" value="2"/>
            <Map cdm="Health.NoResponse" value="3"/>
          </ValueMap>
        </Field>
        <Field name="statusMainBodyAssembly" cdm="Health.EOIR.PBIT.MainBodyAssembly" dataType="UInt8">
          <ValueMap>
            <Map cdm="Health.Normal" value="0"/>
            <Map cdm="Health.Degraded" value="1"/>
            <Map cdm="Health.Unavailable" value="2"/>
            <Map cdm="Health.NoResponse" value="3"/>
          </ValueMap>
        </Field>
      </Reply>
    </ControlBinding>
        <ControlBinding semantic_id="setOperationMode">
      <DDSChannel topicName="RUSV::C2::RCU::EOIRModeControlType" typeName="EOIRModeControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Field name="operationMode" cdm="Control.EOIR.Mode.Command" dataType="UInt8">
