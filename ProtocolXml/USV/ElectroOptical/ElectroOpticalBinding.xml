        <ControlBinding semantic_id="controlByJoystick">
      <DDSChannel topicName="RUSV::C2::RCU::EOIRJoystickControlType" typeName="EOIRJoystickControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Field name="joystickPanResult" cdm="Control.EOIR.Joystick.Pan" dataType="Int16"/>
      <Field name="joystickTiltResult" cdm="Control.EOIR.Joystick.Tilt" dataType="Int16"/>
