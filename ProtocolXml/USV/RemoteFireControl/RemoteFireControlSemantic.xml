<?xml version='1.0' encoding='UTF-8'?>
<PayloadSpec xmlns="http://lignex1.com/mcmc2/umsSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ../../XSD/CommonSpecSchema.xsd">
  <!--원격사격통제장치(Remote Fire Control System) Semantic 명세: 원격통제장치 CSCI ↔ 원격사격통제장치 CSCI 직접 연동 기준.-->
  <!--직접 RCU 연동 대상: 원격통제 송출용 EO/IR RTP, RCWS CBIT/상세상태/사격경고, PBIT/IBIT 결과, 지향/거리측정/메뉴 결과, 공통 명령 ACK, 공통 및 RCWS 전용 제어. 중앙통제 기록저장용 RTP, 중앙통제/전자광학장치 대상 StatusType, 중앙통제 전용 HeartBeat는 제외한다.-->
  <!--공용 식별자: Weapon=0x07, RemoteFireControlSystem=0x01. 세부 장비 ID가 정의되어 있지 않으므로 공통 명령의 dstSubEquipmentID는 0x00으로 사용한다.-->
  <!--ACK 원칙: CommandStatusReportType은 비주기성 명령의 처리 ACK(required=true)이며, PBIT/IBIT·지향·거리측정·메뉴 응답은 실제 결과 Reply로 별도 처리한다.-->
  <!--MenuConfigType의 displayIRW/displayIRT/patrolMode/calTrajectory는 송신 0=켬,1=끔이지만 MenuStatusType은 0=비활성화,1=활성화이므로 Semantic은 enabled Boolean으로 정규화하고 Binding에서 송신 방향만 반전한다.-->
  <!--MenuConfigType.shutdown의 2=재부팅은 공용 restartSystem과 기능상 중복되지만 원문 물리 필드이므로 systemAction(0=None,1=Shutdown,2=Reboot)으로 보존한다.-->
  <!--ControlPanalConfigType.height/turn은 원문 물리값 0~65535를 조작반 원시 입력으로 보존한다. 비고의 ±20도와 물리값 간 변환식/중심값은 원문 미정의(TBD)이다.-->
  <ConstantSpecs id="constant">
    <TextConstantSpec id="productName" name="제품명" cdm="Product.Name">
      <Value>RemoteFireControlSystem</Value>
    </TextConstantSpec>
    <TextConstantSpec id="productDescription" name="제품 설명" cdm="Product.Description">
      <Value>원격사격통제장치 영상·상태 감시, 원격 자체점검, 포탑/카메라/접촉물/무장/조작반/지향/거리측정/메뉴 제어 인터페이스</Value>
    </TextConstantSpec>
  </ConstantSpecs>
  <MonitorSpecs id="monitor">
    <GroupSpec id="rcwsCbitStatus" name="원격사격통제장치 CBIT 상태" cdm="Health.CBIT.RCWS">
      <ValueSetSpec id="remoteControlledWeaponSystemCBIT" name="원격사격통제장치 상태" cdm="Health.RCWS.Overall">
        <Values>
          <Value cdm="Health.Normal" name="Normal"/>
          <Value cdm="Health.Degraded" name="Degraded"/>
          <Value cdm="Health.Unavailable" name="Unavailable"/>
          <Value cdm="Health.NoResponse" name="NoResponse"/>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="surveillanceAndStrikeCBIT" name="감시/타격장치 상태" cdm="Health.RCWS.SurveillanceAndStrike">
        <Values>
          <Value cdm="Health.Normal" name="Normal"/>
          <Value cdm="Health.Degraded" name="Degraded"/>
          <Value cdm="Health.Unavailable" name="Unavailable"/>
          <Value cdm="Health.NoResponse" name="NoResponse"/>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="drivingCBIT" name="구동조립체 상태" cdm="Health.RCWS.Driving">
        <Values>
          <Value cdm="Health.Normal" name="Normal"/>
          <Value cdm="Health.Degraded" name="Degraded"/>
          <Value cdm="Health.Unavailable" name="Unavailable"/>
          <Value cdm="Health.NoResponse" name="NoResponse"/>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="surveillanceCBIT" name="감시조립체 상태" cdm="Health.RCWS.Surveillance">
        <Values>
          <Value cdm="Health.Normal" name="Normal"/>
          <Value cdm="Health.Degraded" name="Degraded"/>
          <Value cdm="Health.Unavailable" name="Unavailable"/>
          <Value cdm="Health.NoResponse" name="NoResponse"/>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="strikeCBIT" name="총가조립체 상태" cdm="Health.RCWS.Strike">
        <Values>
          <Value cdm="Health.Normal" name="Normal"/>
          <Value cdm="Health.Degraded" name="Degraded"/>
          <Value cdm="Health.Unavailable" name="Unavailable"/>
          <Value cdm="Health.NoResponse" name="NoResponse"/>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="controlCBIT" name="통제장치 상태" cdm="Health.RCWS.Control">
        <Values>
          <Value cdm="Health.Normal" name="Normal"/>
          <Value cdm="Health.Degraded" name="Degraded"/>
          <Value cdm="Health.Unavailable" name="Unavailable"/>
          <Value cdm="Health.NoResponse" name="NoResponse"/>
        </Values>
      </ValueSetSpec>
    </GroupSpec>
    <GroupSpec id="weaponDetailStatus" name="RCWS 무장 상세 상태" cdm="Weapon.RCWS.DetailStatus">
      <ValueSetSpec id="firingMode" name="안전/사격 모드" cdm="Weapon.RCWS.FiringMode">
        <Values>
          <Value cdm="Weapon.RCWS.FiringMode.Safe" name="Safe"/>
          <Value cdm="Weapon.RCWS.FiringMode.Fire" name="Fire"/>
        </Values>
      </ValueSetSpec>
      <!--DetailStatusType의 firingMode Range 0~3은 동일 CSCI의 HeartBeat firingMode Range 0~1 및 동일 코드표(0=안전,1=사격)와 충돌한다. 동일 의미 필드의 교차검증에 따라 유효 코드는 0/1로 확정하고 2/3은 표기 오류로 처리한다.-->
      <BooleanSpec id="protectedStatus" name="보호상태 활성화" cdm="Weapon.RCWS.Protected.Enabled"/>
      <ValueSetSpec id="bulletLoadingMode" name="급탄 운용모드" cdm="Weapon.RCWS.BulletLoadingMode">
        <Values>
          <Value cdm="Weapon.RCWS.BulletLoadingMode.RemoteControl" name="RemoteControl"/>
          <Value cdm="Weapon.RCWS.BulletLoadingMode.Maintenance" name="Maintenance"/>
        </Values>
      </ValueSetSpec>
      <BooleanSpec id="autoDetect" name="자동탐지 상태" cdm="Weapon.RCWS.AutoDetect.Enabled"/>
      <BooleanSpec id="objectTracking" name="접촉물 추적 상태" cdm="Weapon.RCWS.ObjectTracking.Enabled"/>
      <BooleanSpec id="eoirAiming" name="전자광학장치 지향 상태" cdm="Weapon.RCWS.Aiming.EOIR.Active"/>
      <BooleanSpec id="cipeAiming" name="항해용레이더 지향 상태" cdm="Weapon.RCWS.Aiming.NavigationRadar.Active"/>
      <ValueSetSpec id="triggeredMode" name="발사 모드" cdm="Weapon.RCWS.TriggerMode">
        <Values>
          <Value cdm="Weapon.RCWS.TriggerMode.FullAuto" name="FullAuto"/>
          <Value cdm="Weapon.RCWS.TriggerMode.Single" name="Single"/>
          <Value cdm="Weapon.RCWS.TriggerMode.ThreeRoundBurst" name="ThreeRoundBurst"/>
          <Value cdm="Weapon.RCWS.TriggerMode.FiveRoundBurst" name="FiveRoundBurst"/>
          <Value cdm="Weapon.RCWS.TriggerMode.TenRoundBurst" name="TenRoundBurst"/>
        </Values>
      </ValueSetSpec>
      <QuantitySpec id="turningAngle" name="포탑구동 선회각" cdm="Weapon.RCWS.Turret.TraverseAngle">
        <Unit>deg</Unit>
        <Range min="-180" max="180"/>
      </QuantitySpec>
      <!--DetailStatusType Range 셀의 "0~360-180~180"은 동일 RCWS CSCI의 StatusType.turningAngle이 명시한 -180~180 deg와 교차검증하여 표기 오염으로 정리한다.-->
      <QuantitySpec id="elevationAngle" name="포탑구동 고저각" cdm="Weapon.RCWS.Turret.ElevationAngle">
        <Unit>deg</Unit>
        <Range min="-20" max="60"/>
      </QuantitySpec>
      <QuantitySpec id="firingCount" name="탄 카운팅 정보" cdm="Weapon.RCWS.Ammunition.FiringCount">
        <Unit>num</Unit>
        <Range min="0" max="2000"/>
        <Resolution>1</Resolution>
      </QuantitySpec>
      <BooleanSpec id="autoReload" name="자동장전 이벤트" cdm="Weapon.RCWS.AutoReload.Event"/>
      <BooleanSpec id="manualLeadCompensation" name="수동 선보상 전환 이벤트" cdm="Weapon.RCWS.ManualLeadCompensation.ToggleEvent"/>
      <QuantitySpec id="cameraFOV" name="메인 카메라 FOV" cdm="Weapon.RCWS.Camera.MainFOV">
        <Range min="0" max="60"/>
      </QuantitySpec>
      <!--autoReload/manualLeadCompensation는 원문상 이벤트 필드이며 값 1 발생 후 다시 0으로 초기화된다.-->
    </GroupSpec>
    <BooleanSpec id="firingAlarm" name="150발 지속사격 경고" cdm="Weapon.RCWS.FireWarning.Active"/>
  </MonitorSpecs>
  <ControlSpecs id="control">
    <ControlSpec id="startIntegration" name="원격사격통제장치 연동 개시" cdm="Control.Integration.Start">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply id="startIntegrationAck" name="Start Integration Ack" bindRef="startIntegrationAck" cdm="Command.ProcessingStatus.Response" required="true">
      <Results><Result id="status" name="commandStatusReport.status" cdm="Control.Response.Status"/></Results>
    </Reply>
    </ControlSpec>
    <ControlSpec id="restartSystem" name="원격사격통제장치 시스템 재시작" cdm="Control.System.Restart">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply id="restartSystemAck" name="Restart System Ack" bindRef="restartSystemAck" cdm="Command.ProcessingStatus.Response" required="true">
      <Results><Result id="status" name="commandStatusReport.status" cdm="Control.Response.Status"/></Results>
    </Reply>
    </ControlSpec>
    <ControlSpec id="requestPbit" name="원격사격통제장치 PBIT 요청" cdm="Request.Health.PBIT">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply id="requestPbitAck" name="Request Pbit Ack" bindRef="requestPbitAck" cdm="Command.ProcessingStatus.Response" required="true">
        <Results><Result id="status" name="commandStatusReport.status" cdm="Control.Response.Status"/></Results>
      </Reply>
      <Reply id="requestPbitResult" name="Request Pbit Result" bindRef="requestPbitResult" cdm="Request.Health.PBIT.Response" required="true">
      <Results><ValueSetResult id="overall" name="remoteControlledWeaponSystemPBIT" cdm="Health.RCWS.Overall"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult id="surveillanceAndStrike" name="surveillanceAndStrikePBIT" cdm="Health.RCWS.SurveillanceAndStrike"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult id="driving" name="drivingPBIT" cdm="Health.RCWS.Driving"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult id="surveillance" name="surveillancePBIT" cdm="Health.RCWS.Surveillance"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult id="strike" name="strikePBIT" cdm="Health.RCWS.Strike"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult id="control" name="controlPBIT" cdm="Health.RCWS.Control"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult></Results>
    </Reply>
    </ControlSpec>
    <ControlSpec id="requestIbit" name="원격사격통제장치 IBIT 요청" cdm="Request.Health.IBIT">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply id="requestIbitAck" name="Request Ibit Ack" bindRef="requestIbitAck" cdm="Command.ProcessingStatus.Response" required="true">
        <Results><Result id="status" name="commandStatusReport.status" cdm="Control.Response.Status"/></Results>
      </Reply>
      <Reply id="requestIbitResult" name="Request Ibit Result" bindRef="requestIbitResult" cdm="Request.Health.IBIT.Response" required="true">
      <Results><ValueSetResult id="overall" name="remoteControlledWeaponSystemIBIT" cdm="Health.RCWS.Overall"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult id="surveillanceAndStrike" name="surveillanceAndStrikeIBIT" cdm="Health.RCWS.SurveillanceAndStrike"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult id="driving" name="drivingIBIT" cdm="Health.RCWS.Driving"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult id="surveillance" name="surveillanceIBIT" cdm="Health.RCWS.Surveillance"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult id="strike" name="strikeIBIT" cdm="Health.RCWS.Strike"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><ValueSetResult id="control" name="controlIBIT" cdm="Health.RCWS.Control"><Values><Value name="Normal" cdm="Health.Normal"/><Value name="Degraded" cdm="Health.Degraded"/><Value name="Unavailable" cdm="Health.Unavailable"/><Value name="NoResponse" cdm="Health.NoResponse"/></Values></ValueSetResult><GroupResult id="detail" name="drivingIBIT_Detail" cdm="Health.RCWS.Driving.IBIT.Detail"><Result id="raw" name="horizontalMotorIBIT" cdm="Health.RCWS.Driving.IBIT.Detail.Bit0.Raw"/><Result id="raw2" name="verticalMorotIBIT" cdm="Health.RCWS.Driving.IBIT.Detail.Bit1.Raw"/><Result id="raw3" name="reloadMotorIBIT" cdm="Health.RCWS.Driving.IBIT.Detail.Bit2.Raw"/><Result id="raw4" name="inertialMeasurementUnitCommunicationIBIT" cdm="Health.RCWS.Driving.IBIT.Detail.Bit3.Raw"/></GroupResult><GroupResult id="detail2" name="surveillanceIBIT_Detail" cdm="Health.RCWS.Surveillance.IBIT.Detail"><Result id="raw5" name="dayCameraIBIT" cdm="Health.RCWS.Surveillance.IBIT.Detail.Bit0.Raw"/><Result id="raw6" name="nightWideAngleCameraIBIT" cdm="Health.RCWS.Surveillance.IBIT.Detail.Bit1.Raw"/><Result id="raw7" name="nighttelephotoCameraIBIT" cdm="Health.RCWS.Surveillance.IBIT.Detail.Bit2.Raw"/><Result id="raw8" name="distanceMeasurementIBIT" cdm="Health.RCWS.Surveillance.IBIT.Detail.Bit3.Raw"/><Result id="raw9" name="atmosphericPressureIBIT" cdm="Health.RCWS.Surveillance.IBIT.Detail.Bit4.Raw"/><Result id="raw10" name="surveillanceTemperatureIBIT" cdm="Health.RCWS.Surveillance.IBIT.Detail.Bit5.Raw"/></GroupResult><GroupResult id="detail3" name="strikeIBIT_Detail" cdm="Health.RCWS.Strike.IBIT.Detail"><Result id="raw11" name="autoReloadAssemblyIBIT" cdm="Health.RCWS.Strike.IBIT.Detail.Bit0.Raw"/><Result id="raw12" name="fireAssemblyIBIT" cdm="Health.RCWS.Strike.IBIT.Detail.Bit1.Raw"/><Result id="raw13" name="weaponControlBoardIBIT" cdm="Health.RCWS.Strike.IBIT.Detail.Bit2.Raw"/></GroupResult><GroupResult id="detail4" name="controlIBIT_Detail" cdm="Health.RCWS.Control.IBIT.Detail"><Result id="raw14" name="controlAssemblyIBIT" cdm="Health.RCWS.Control.IBIT.Detail.Bit0.Raw"/><Result id="raw15" name="controlPowerIBIT" cdm="Health.RCWS.Control.IBIT.Detail.Bit1.Raw"/><Result id="raw16" name="fireControlBoardIBIT" cdm="Health.RCWS.Control.IBIT.Detail.Bit2.Raw"/><Result id="raw17" name="communicationControlBoardIBIT" cdm="Health.RCWS.Control.IBIT.Detail.Bit3.Raw"/><Result id="raw18" name="driveControlBoardIBIT" cdm="Health.RCWS.Control.IBIT.Detail.Bit4.Raw"/></GroupResult></Results>
    </Reply>
    </ControlSpec>
    <ControlSpec id="configureDriving" name="RCWS 구동 설정" cdm="Control.RCWS.Driving.Configure">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Parameters>
        <QuantityProfile id="elevationAngle" name="Elevation Angle" cdm="Control.RCWS.Driving.ElevationAngle">
          <Unit>deg</Unit>
          <Range min="-20" max="60"/>
        </QuantityProfile>
        <QuantityProfile id="traverseAngle" name="Traverse Angle" cdm="Control.RCWS.Driving.TraverseAngle">
          <Unit>deg</Unit>
          <Range min="-180" max="180"/>
        </QuantityProfile>
        <BooleanProfile id="protectedModeEvent" name="Protected Mode Event" cdm="Control.RCWS.Driving.ProtectedModeEvent"/>
        <ValueSetProfile id="autoOrientationAction" name="Auto Orientation Action" cdm="Control.RCWS.Driving.AutoOrientationAction"><Values><Value name="Initial" cdm="Control.RCWS.Driving.AutoOrientationAction.Initial"/><Value name="AutoAim" cdm="Control.RCWS.Driving.AutoOrientationAction.AutoAim"/><Value name="SaveCurrentAngle" cdm="Control.RCWS.Driving.AutoOrientationAction.SaveCurrentAngle"/></Values></ValueSetProfile>
      </Parameters>
      <!--autoOrientationAction 물리값: 0=초기상태, 1=자동지향, 2=현재 포탑 선회/고저각 저장. protectedMode는 1 발생 후 0으로 초기화되는 이벤트이다.-->
      <Reply id="configureDrivingAck" name="Configure Driving Ack" bindRef="configureDrivingAck" cdm="Command.ProcessingStatus.Response" required="true">
      <Results><Result id="status" name="commandStatusReport.status" cdm="Control.Response.Status"/></Results>
    </Reply>
    </ControlSpec>
    <ControlSpec id="configureCamera" name="RCWS 영상 설정" cdm="Control.RCWS.Camera.Configure">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Parameters>
        <ValueSetProfile id="cameraType" name="Camera Type" cdm="Control.RCWS.Camera.Type"><Values><Value name="Day" cdm="Control.RCWS.Camera.Type.Day"/><Value name="IRWide" cdm="Control.RCWS.Camera.Type.IRWide"/><Value name="IRTele" cdm="Control.RCWS.Camera.Type.IRTele"/></Values></ValueSetProfile>
        <BooleanProfile id="zoomInEvent" name="Zoom In Event" cdm="Control.RCWS.Camera.ZoomInEvent"/>
        <BooleanProfile id="zoomOutEvent" name="Zoom Out Event" cdm="Control.RCWS.Camera.ZoomOutEvent"/>
      </Parameters>
      <!--cameraType 물리값: 0=주간, 1=야간(광각), 2=야간(협각). zoomIn/zoomOut은 1 발생 후 0으로 초기화되는 이벤트이다.-->
      <Reply id="configureCameraAck" name="Configure Camera Ack" bindRef="configureCameraAck" cdm="Command.ProcessingStatus.Response" required="true">
      <Results><Result id="status" name="commandStatusReport.status" cdm="Control.Response.Status"/></Results>
    </Reply>
    </ControlSpec>
    <ControlSpec id="configureContact" name="RCWS 접촉물 설정" cdm="Control.RCWS.Contact.Configure">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Parameters>
        <BooleanProfile id="selectEvent" name="Select Event" cdm="Control.RCWS.Contact.SelectEvent"/>
        <BooleanProfile id="leftEvent" name="Left Event" cdm="Control.RCWS.Contact.LeftEvent"/>
        <BooleanProfile id="rightEvent" name="Right Event" cdm="Control.RCWS.Contact.RightEvent"/>
        <BooleanProfile id="manualLeadCompensationToggleEvent" name="Manual Lead Compensation Toggle Event" cdm="Control.RCWS.Contact.ManualLeadCompensationToggleEvent"/>
        <ValueSetProfile id="horizontalChange" name="Horizontal Change" cdm="Control.RCWS.Contact.ManualLead.HorizontalChange"><Values><Value name="Initial" cdm="Control.RCWS.Contact.ManualLead.HorizontalChange.Initial"/><Value name="Right" cdm="Control.RCWS.Contact.ManualLead.HorizontalChange.Right"/><Value name="Left" cdm="Control.RCWS.Contact.ManualLead.HorizontalChange.Left"/></Values></ValueSetProfile>
        <ValueSetProfile id="verticalChange" name="Vertical Change" cdm="Control.RCWS.Contact.ManualLead.VerticalChange"><Values><Value name="Initial" cdm="Control.RCWS.Contact.ManualLead.VerticalChange.Initial"/><Value name="Up" cdm="Control.RCWS.Contact.ManualLead.VerticalChange.Up"/><Value name="Down" cdm="Control.RCWS.Contact.ManualLead.VerticalChange.Down"/></Values></ValueSetProfile>
        <BooleanProfile id="crossHairInitializeEvent" name="Cross Hair Initialize Event" cdm="Control.RCWS.Contact.CrossHairInitializeEvent"/>
        <BooleanProfile id="distanceMeasureEvent" name="Distance Measure Event" cdm="Control.RCWS.Contact.DistanceMeasureEvent"/>
      </Parameters>
      <!--접촉물/수동선보상/조준점/거리측정 항목은 원문상 이벤트 입력이며 1 또는 방향값 발생 후 0으로 초기화된다. 좌우조정: 0=초기,1=오른쪽,2=왼쪽; 상하조정: 0=초기,1=위,2=아래.-->
      <Reply id="configureContactAck" name="Configure Contact Ack" bindRef="configureContactAck" cdm="Command.ProcessingStatus.Response" required="true">
      <Results><Result id="status" name="commandStatusReport.status" cdm="Control.Response.Status"/></Results>
    </Reply>
    </ControlSpec>
    <ControlSpec id="configureWeapon" name="RCWS 총기 설정" cdm="Control.RCWS.Weapon.Configure">
      <Target cdm="Platform.Identifier.Numeric"/>
