<?xml version='1.0' encoding='UTF-8'?>
<PayloadBinding xmlns="http://lignex1.com/mcmc2/umsSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ../../XSD/CommonBindingSchema.xsd">
  <!--원격사격통제장치 Binding: 원격사격통제장치 CSCI + 원격통제장치 CSCI 직접 연동 기준.-->
  <!--공용 명령 목적지: equipmentType=0x07(Weapon), equipmentID=0x01(RemoteFireControlSystem), dstSubEquipmentID=0x00.-->
  <!--CommandStatusReportType은 모든 ACK=O 비주기 명령의 처리 ACK이며, 전용 PBIT/IBIT/지향/거리측정/메뉴 결과와 구분한다.-->
  <!--중앙통제 기록저장용 EO/IR RTP, 중앙통제/전자광학장치 대상 StatusType, 중앙통제 전용 RCWSHeartBeatReportType은 직접 RCU Binding에서 제외한다.-->
  <Monitors semantic_id="monitor">
    <MonitorBinding semantic_id="rcwsCbitStatus">
      <DDSChannel topicName="RUSV::SO::RCWS::RCWSCBITReportType" typeName="RCWSCBITReportType"/>
      <Field name="usvHeader"/>
      <Field name="remoteControlledWeaponSystemCBIT" cdm="Health.RCWS.Overall" dataType="UInt8">
        <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
      </Field>
      <Field name="surveillanceAndStrikeCBIT" cdm="Health.RCWS.SurveillanceAndStrike" dataType="UInt8">
        <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
      </Field>
      <Field name="drivingCBIT" cdm="Health.RCWS.Driving" dataType="UInt8">
        <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
      </Field>
      <Field name="surveillanceCBIT" cdm="Health.RCWS.Surveillance" dataType="UInt8">
        <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
      </Field>
      <Field name="strikeCBIT" cdm="Health.RCWS.Strike" dataType="UInt8">
        <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
      </Field>
      <Field name="controlCBIT" cdm="Health.RCWS.Control" dataType="UInt8">
      <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
    </Field>
    </MonitorBinding>
    <MonitorBinding semantic_id="weaponDetailStatus">
      <DDSChannel topicName="RUSV::MM::RCWS::DetailStatusType" typeName="DetailStatusType"/>
      <Field name="usvHeader"/>
      <Field name="firingMode" cdm="Weapon.RCWS.FiringMode" dataType="UInt8">
        <ValueMap><Map cdm="Weapon.RCWS.FiringMode.Safe" value="0"/><Map cdm="Weapon.RCWS.FiringMode.Fire" value="1"/></ValueMap>
      </Field>
      <Field name="protectedStatus" cdm="Weapon.RCWS.Protected.Enabled" dataType="UInt8"/>
      <Field name="bulletLoadingMode" cdm="Weapon.RCWS.BulletLoadingMode" dataType="UInt8">
        <ValueMap><Map cdm="Weapon.RCWS.BulletLoadingMode.RemoteControl" value="0"/><Map cdm="Weapon.RCWS.BulletLoadingMode.Maintenance" value="1"/></ValueMap>
      </Field>
      <Field name="autoDetect" cdm="Weapon.RCWS.AutoDetect.Enabled" dataType="UInt8"/>
      <Field name="objectTracking" cdm="Weapon.RCWS.ObjectTracking.Enabled" dataType="UInt8"/>
      <Field name="eoirAiming" cdm="Weapon.RCWS.Aiming.EOIR.Active" dataType="UInt8"/>
      <Field name="cipeAming" cdm="Weapon.RCWS.Aiming.NavigationRadar.Active" dataType="UInt8"/>
      <Field name="triggeredMode" cdm="Weapon.RCWS.TriggerMode" dataType="UInt8">
        <ValueMap><Map cdm="Weapon.RCWS.TriggerMode.FullAuto" value="0"/><Map cdm="Weapon.RCWS.TriggerMode.Single" value="1"/><Map cdm="Weapon.RCWS.TriggerMode.ThreeRoundBurst" value="2"/><Map cdm="Weapon.RCWS.TriggerMode.FiveRoundBurst" value="3"/><Map cdm="Weapon.RCWS.TriggerMode.TenRoundBurst" value="4"/></ValueMap>
      </Field>
      <Field name="turningAngle" cdm="Weapon.RCWS.Turret.TraverseAngle" dataType="Float32"/>
      <Field name="elevationAngle" cdm="Weapon.RCWS.Turret.ElevationAngle" dataType="Float32"/>
      <Field name="firingCount" cdm="Weapon.RCWS.Ammunition.FiringCount" dataType="UInt16"/>
      <Field name="autoReload" cdm="Weapon.RCWS.AutoReload.Event" dataType="UInt8"/>
      <Field name="manualLeadCompensation" cdm="Weapon.RCWS.ManualLeadCompensation.ToggleEvent" dataType="UInt8"/>
      <Field name="cameraFOV" cdm="Weapon.RCWS.Camera.MainFOV" dataType="Float32"/>
      <!--물리 필드명 cipeAming은 원문 오탈자를 그대로 유지하며 Semantic CDM에서는 NavigationRadar Aiming으로 정규화한다.-->
    </MonitorBinding>
    <MonitorBinding semantic_id="firingAlarm">
      <DDSChannel topicName="RUSV::MM::RCWS::FireWarningReportType" typeName="FireWarningReportType"/>
      <Field name="usvHeader"/>
      <Field name="firingAlarm" cdm="Weapon.RCWS.FireWarning.Active" dataType="UInt8"/>
    </MonitorBinding>
  </Monitors>
  <Controls semantic_id="control">
    <ControlBinding semantic_id="startIntegration">
      <DDSChannel topicName="RUSV::C2::RCU::IntegrationControlType" typeName="IntegrationControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <DerivedField name="destination" sourceField="System.Target.RemoteFireControl"/>
      <Reply semantic_id="startIntegrationAck" required="true">
        <DDSChannel topicName="RUSV::C2::RCWS::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="restartSystem">
      <DDSChannel topicName="RUSV::C2::RCU::SystemRebootControlType" typeName="SystemRebootControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <DerivedField name="destination" sourceField="System.Target.RemoteFireControl"/>
      <Reply semantic_id="restartSystemAck" required="true">
        <DDSChannel topicName="RUSV::C2::RCWS::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="requestPbit">
      <DDSChannel topicName="RUSV::SO::RCU::RCUPBITControlType" typeName="RCUPBITControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <DerivedField name="destination" sourceField="System.Target.RemoteFireControl"/>
      <Reply semantic_id="requestPbitAck" required="true">
        <DDSChannel topicName="RUSV::C2::RCWS::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
      <Reply semantic_id="requestPbitResult">
        <DDSChannel topicName="RUSV::SO::RCWS::RCWSPBITReportType" typeName="RCWSPBITReportType"/>
        <Field name="usvHeader"/>
        <Field name="remoteControlledWeaponSystemPBIT" cdm="Health.RCWS.Overall" dataType="UInt8">
          <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
        </Field>
        <Field name="surveillanceAndStrikePBIT" cdm="Health.RCWS.SurveillanceAndStrike" dataType="UInt8">
          <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
        </Field>
        <Field name="drivingPBIT" cdm="Health.RCWS.Driving" dataType="UInt8">
          <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
        </Field>
        <Field name="surveillancePBIT" cdm="Health.RCWS.Surveillance" dataType="UInt8">
          <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
        </Field>
        <Field name="strikePBIT" cdm="Health.RCWS.Strike" dataType="UInt8">
          <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
        </Field>
        <Field name="controlPBIT" cdm="Health.RCWS.Control" dataType="UInt8">
        <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
      </Field>
      </Reply>
      <!--PBIT 명령 처리 ACK은 공용 CommandStatusReportType으로 수신하고 RCWSPBITReportType은 실제 점검 결과 Reply로 처리한다. 결과 Report에는 commandID가 없어 추가 상관관계를 임의로 만들지 않는다.-->
    </ControlBinding>
    <ControlBinding semantic_id="requestIbit">
      <DDSChannel topicName="RUSV::SO::RCU::RCUIBITControlType" typeName="RCUIBITControlType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <DerivedField name="destination" sourceField="System.Target.RemoteFireControl"/>
      <Reply semantic_id="requestIbitAck" required="true">
        <DDSChannel topicName="RUSV::C2::RCWS::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
      <Reply semantic_id="requestIbitResult">
        <DDSChannel topicName="RUSV::SO::RCWS::RCWSIBITReportType" typeName="RCWSIBITReportType"/>
        <Field name="usvHeader"/>
        <Field name="remoteControlledWeaponSystemIBIT" cdm="Health.RCWS.Overall" dataType="UInt8">
          <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
        </Field>
        <Field name="surveillanceAndStrikeIBIT" cdm="Health.RCWS.SurveillanceAndStrike" dataType="UInt8">
          <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
        </Field>
        <Field name="drivingIBIT" cdm="Health.RCWS.Driving" dataType="UInt8">
          <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
        </Field>
        <Field name="drivingIBIT_Detail" cdm="Health.RCWS.Driving.IBIT.Detail.Raw" dataType="UInt8"/>
        <Field name="surveillanceIBIT" cdm="Health.RCWS.Surveillance" dataType="UInt8">
          <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
        </Field>
        <Field name="surveillanceIBIT_Detail" cdm="Health.RCWS.Surveillance.IBIT.Detail.Raw" dataType="UInt8"/>
        <Field name="strikeIBIT" cdm="Health.RCWS.Strike" dataType="UInt8">
          <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
        </Field>
        <Field name="strikeIBIT_Detail" cdm="Health.RCWS.Strike.IBIT.Detail.Raw" dataType="UInt8"/>
        <Field name="controlIBIT" cdm="Health.RCWS.Control" dataType="UInt8">
          <ValueMap><Map cdm="Health.Normal" value="0"/><Map cdm="Health.Degraded" value="1"/><Map cdm="Health.Unavailable" value="2"/><Map cdm="Health.NoResponse" value="3"/></ValueMap>
        </Field>
        <Field name="controlIBIT_Detail" cdm="Health.RCWS.Control.IBIT.Detail.Raw" dataType="UInt8"/>
        <!--IBIT Detail raw bit 정의: driving Bit0=선회모터, Bit1=고각모터, Bit2=급탄모터, Bit3=관성센서 통신; surveillance Bit0=주간카메라, Bit1=야간(협각)카메라, Bit2=야간(광각)카메라, Bit3=거리측정기, Bit4=기압, Bit5=감시조립체 온도; strike Bit0=자동장전조립체 통신, Bit1=격발조립체, Bit2=무장제어보드; control Bit0=통합제어기, Bit1=통합제어기전원, Bit2=사격통제보드, Bit3=통신제어보드, Bit4=구동제어보드. 원문은 각 bit의 0/1 정상/이상 극성을 별도로 명시하지 않아 raw octet으로 유지한다.-->
      </Reply>
      <!--IBIT 명령 처리 ACK은 공용 CommandStatusReportType으로 수신하고 RCWSIBITReportType은 실제 점검 결과 Reply로 처리한다. 결과 Report에는 commandID가 없다.-->
    </ControlBinding>
    <ControlBinding semantic_id="configureDriving">
      <DDSChannel topicName="RUSV::C2::RCU::DrivingConfigType" typeName="DrivingConfigType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Field name="height" cdm="Control.RCWS.Driving.ElevationAngle" dataType="Int32"/>
      <Field name="turn" cdm="Control.RCWS.Driving.TraverseAngle" dataType="Int32"/>
      <DerivedField name="protectedMode" cdm="Control.RCWS.Driving.ProtectedModeEvent" sourceField="Control.RCWS.Driving.ProtectedModeEvent" dataType="UInt8"><SourceValueMap><Map sourceValue="false" value="0"/><Map sourceValue="true" value="1"/></SourceValueMap></DerivedField>
      <Field name="autoOrientaion" cdm="Control.RCWS.Driving.AutoOrientationAction" dataType="UInt8">
        <ValueMap><Map cdm="Control.RCWS.Driving.AutoOrientationAction.Initial" value="0"/><Map cdm="Control.RCWS.Driving.AutoOrientationAction.AutoAim" value="1"/><Map cdm="Control.RCWS.Driving.AutoOrientationAction.SaveCurrentAngle" value="2"/></ValueMap>
      </Field>
      <!--물리 필드명 autoOrientaion은 원문 철자를 그대로 유지한다.-->
      <Reply semantic_id="configureDrivingAck" required="true">
        <DDSChannel topicName="RUSV::C2::RCWS::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="configureCamera">
      <DDSChannel topicName="RUSV::C2::RCU::CameraConfigType" typeName="CameraConfigType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <Field name="cameraType" cdm="Control.RCWS.Camera.Type" dataType="UInt8">
        <ValueMap><Map cdm="Control.RCWS.Camera.Type.Day" value="0"/><Map cdm="Control.RCWS.Camera.Type.IRWide" value="1"/><Map cdm="Control.RCWS.Camera.Type.IRTele" value="2"/></ValueMap>
      </Field>
      <DerivedField name="zoomIn" cdm="Control.RCWS.Camera.ZoomInEvent" sourceField="Control.RCWS.Camera.ZoomInEvent" dataType="UInt8"><SourceValueMap><Map sourceValue="false" value="0"/><Map sourceValue="true" value="1"/></SourceValueMap></DerivedField>
      <DerivedField name="zoomOut" cdm="Control.RCWS.Camera.ZoomOutEvent" sourceField="Control.RCWS.Camera.ZoomOutEvent" dataType="UInt8"><SourceValueMap><Map sourceValue="false" value="0"/><Map sourceValue="true" value="1"/></SourceValueMap></DerivedField>
      <Reply semantic_id="configureCameraAck" required="true">
        <DDSChannel topicName="RUSV::C2::RCWS::CommandStatusReportType" typeName="CommandStatusReportType"/>
        <Field name="usvHeader"/>
        <Field name="commandStatusReport.dstEquipmentType" cdm="Control.Response.Destination.EquipmentType" dataType="UInt8"/>
        <Field name="commandStatusReport.dstEquipmentID" cdm="Control.Response.Destination.EquipmentID" dataType="UInt8"/>
        <Field name="commandStatusReport.status" cdm="Control.Response.Status" dataType="UInt8"/>
        <Field name="commandID" cdm="Message.Correlation.NumericID" dataType="UInt16"/>
      </Reply>
    </ControlBinding>
    <ControlBinding semantic_id="configureContact">
      <DDSChannel topicName="RUSV::C2::RCU::ContactConfigType" typeName="ContactConfigType"/>
      <DerivedField name="usvHeader" sourceField="System.Generated.USVMessageBase"/>
      <DerivedField name="commandID" sourceField="System.Generated.CommandSequence" dataType="UInt16"/>
      <DerivedField name="select" cdm="Control.RCWS.Contact.SelectEvent" sourceField="Control.RCWS.Contact.SelectEvent" dataType="UInt8"><SourceValueMap><Map sourceValue="false" value="0"/><Map sourceValue="true" value="1"/></SourceValueMap></DerivedField>
      <DerivedField name="left" cdm="Control.RCWS.Contact.LeftEvent" sourceField="Control.RCWS.Contact.LeftEvent" dataType="UInt8"><SourceValueMap><Map sourceValue="false" value="0"/><Map sourceValue="true" value="1"/></SourceValueMap></DerivedField>
      <DerivedField name="right" cdm="Control.RCWS.Contact.RightEvent" sourceField="Control.RCWS.Contact.RightEvent" dataType="UInt8"><SourceValueMap><Map sourceValue="false" value="0"/><Map sourceValue="true" value="1"/></SourceValueMap></DerivedField>
      <DerivedField name="manualLeadCompensation" cdm="Control.RCWS.Contact.ManualLeadCompensationToggleEvent" sourceField="Control.RCWS.Contact.ManualLeadCompensationToggleEvent" dataType="UInt8"><SourceValueMap><Map sourceValue="false" value="0"/><Map sourceValue="true" value="1"/></SourceValueMap></DerivedField>
      <Field name="leftAndRightManualLeadChange" cdm="Control.RCWS.Contact.ManualLead.HorizontalChange" dataType="UInt8">
        <ValueMap><Map cdm="Control.RCWS.Contact.ManualLead.HorizontalChange.Initial" value="0"/><Map cdm="Control.RCWS.Contact.ManualLead.HorizontalChange.Right" value="1"/><Map cdm="Control.RCWS.Contact.ManualLead.HorizontalChange.Left" value="2"/></ValueMap>
      </Field>
      <Field name="upAndDownManualLeadChange" cdm="Control.RCWS.Contact.ManualLead.VerticalChange" dataType="UInt8">
        <ValueMap><Map cdm="Control.RCWS.Contact.ManualLead.VerticalChange.Initial" value="0"/><Map cdm="Control.RCWS.Contact.ManualLead.VerticalChange.Up" value="1"/><Map cdm="Control.RCWS.Contact.ManualLead.VerticalChange.Down" value="2"/></ValueMap>
      </Field>
      <DerivedField name="initCrossHair" cdm="Control.RCWS.Contact.CrossHairInitializeEvent" sourceField="Control.RCWS.Contact.CrossHairInitializeEvent" dataType="UInt8"><SourceValueMap><Map sourceValue="false" value="0"/><Map sourceValue="true" value="1"/></SourceValueMap></DerivedField>
      <DerivedField name="measurement" cdm="Control.RCWS.Contact.DistanceMeasureEvent" sourceField="Control.RCWS.Contact.DistanceMeasureEvent" dataType="UInt8"><SourceValueMap><Map sourceValue="false" value="0"/><Map sourceValue="true" value="1"/></SourceValueMap></DerivedField>
      <Reply semantic_id="configureContactAck" required="true">
        <DDSChannel topicName="RUSV::C2::RCWS::CommandStatusReportType" typeName="CommandStatusReportType"/>
