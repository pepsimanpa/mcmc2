<?xml version='1.0' encoding='UTF-8'?>
<PlatformSpec xmlns="http://lignex1.com/mcmc2/umsSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ./CommonSpecSchema.xsd">
  <!--자율운항장치(Autonomous Navigation Unit) Semantic 명세: 원격통제장치 CSCI ↔ 자율운항장치 CSCI 직접 연동 기준.-->
  <!--설계 결정: missionStateID wire 1~8은 공통 Mission.Type 0~7로 정규화한다. PBIT operationalStatus의 Range 0~1은 비고/CBIT/IBIT와 충돌하므로 0~3 오기로 본다.-->
  <!--설계 결정: headingAcheived/hoverRadiusAcheived/targetTrackingAcheived는 원문 상세값 미기재이나 0=NotAchieved, 1=Achieved로 잠정 정의한다.-->
  <!--설계 결정: AutonomousDocking distanceRemaining은 동일 의미의 AutonomousNavigation distanceRemaining을 근거로 m를 적용한다.-->
  <!--TBD: DP distancePointRemaining/errorYawAngle, TargetTracking distanceTargetRemaining은 원문에 단위 근거가 없어 Unit을 비워 둔다. Fuel fuelQuantityRemain과 시간 인코딩도 원문 확인 전 임의 단위를 부여하지 않는다.-->
  <!--중요: RecordCommand 계열은 RCU/ANU 메시지의 Size 열과 공용 구조체 내용이 불일치한다. 동일 타입명을 참조하므로 공용 구조체 정의를 기준으로 Semantic/Binding을 작성하고 Size 불일치는 TBD로 남긴다.-->
  <ConstantSpecs id="constant">
    <TextConstantSpec id="productName" name="제품명" cdm="Product.Name">
      <Value>AutonomousNavigation</Value>
    </TextConstantSpec>
    <TextConstantSpec id="productDescription" name="제품 설명" cdm="Product.Description">
      <Value>자율운항장치 임무계획, 임무수행 상태, BIT 및 원격 제어 인터페이스</Value>
    </TextConstantSpec>
  </ConstantSpecs>
  <MonitorSpecs id="monitor">
    <GroupSpec id="missionExecutionStatus" name="자율운항 임무 수행 상태" cdm="Autonomy.Mission.Execution">
      <ValueSetSpec id="operationMode" name="무인수상정 운용 모드" cdm="Autonomy.OperationMode">
        <Values>
          <Value cdm="Platform.OperationMode.LocalManual">0</Value>
          <Value cdm="Platform.OperationMode.RemoteManual">1</Value>
          <Value cdm="Platform.OperationMode.Autonomous">2</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="missionType" name="자율운항 임무 종류" cdm="Autonomy.Mission.Type">
        <Values>
          <Value cdm="Autonomy.Mission.Type.Waypoint">0</Value>
          <Value cdm="Autonomy.Mission.Type.GlobalHover">1</Value>
          <Value cdm="Autonomy.Mission.Type.TargetTracking">2</Value>
          <Value cdm="Autonomy.Mission.Type.PointAndGo">3</Value>
          <Value cdm="Autonomy.Mission.Type.AutonomousNavigation">4</Value>
          <Value cdm="Autonomy.Mission.Type.SurfaceReconnaissance">5</Value>
          <Value cdm="Autonomy.Mission.Type.UnderwaterReconnaissance">6</Value>
          <Value cdm="Autonomy.Mission.Type.AutonomousDocking">7</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="missionState" name="임무 진행 상태" cdm="Autonomy.Mission.Execution.State">
        <Values>
          <Value cdm="Mission.Execution.Executing">0</Value>
          <Value cdm="Mission.Execution.Ended">1</Value>
          <Value cdm="Mission.Execution.Standby">2</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="missionPossible" name="임무 수행 가능 여부" cdm="Autonomy.Mission.Execution.Possible">
        <Values>
          <Value cdm="Mission.Availability.Possible">0</Value>
          <Value cdm="Mission.Availability.Impossible">1</Value>
        </Values>
      </ValueSetSpec>
      <QuantitySpec id="waypointRepeatNumber" name="구간 내 정찰 횟수" cdm="Autonomy.Waypoint.RepeatNumber">
        <Range min="0" max="255"/>
      </QuantitySpec>
      <QuantitySpec id="waypointMissionID" name="미션 ID" cdm="Autonomy.Waypoint.MissionID"/>
      <QuantitySpec id="totalWaypoint" name="전체 경로점 개수" cdm="Autonomy.Waypoint.TotalCount"/>
      <QuantitySpec id="waypointID" name="현재 추종 경로점 ID" cdm="Autonomy.Waypoint.CurrentID"/>
      <QuantitySpec id="waypointRemaining" name="남은 경로점 개수" cdm="Autonomy.Waypoint.RemainingCount"/>
      <QuantitySpec id="waypointLatitude" name="현재 경로점 위도" cdm="Autonomy.Waypoint.Position.Latitude">
        <Unit>deg</Unit>
        <Range min="-90" max="90"/>
      </QuantitySpec>
      <QuantitySpec id="waypointLongitude" name="현재 경로점 경도" cdm="Autonomy.Waypoint.Position.Longitude">
        <Unit>deg</Unit>
        <Range min="-180" max="180"/>
      </QuantitySpec>
      <QuantitySpec id="waypointArrivalTime" name="마지막 경로점 도착시간" cdm="Autonomy.Waypoint.ArrivalTime"/>
      <QuantitySpec id="crossTrackError" name="경로 오차 거리" cdm="Autonomy.Waypoint.CrossTrackError">
        <Unit>m</Unit>
      </QuantitySpec>
      <QuantitySpec id="cumulativeDistance" name="축적 거리" cdm="Autonomy.Waypoint.CumulativeDistance">
        <Unit>m</Unit>
      </QuantitySpec>
      <QuantitySpec id="waypointDistanceRemaining" name="전체 남은 거리" cdm="Autonomy.Waypoint.DistanceRemaining">
        <Unit>m</Unit>
      </QuantitySpec>
      <QuantitySpec id="distanceToWaypoint" name="현재 경로점 남은 거리" cdm="Autonomy.Waypoint.DistanceToCurrent">
        <Unit>m</Unit>
      </QuantitySpec>
      <ValueSetSpec id="positionAchieved" name="경로 오차 만족 여부" cdm="Autonomy.Waypoint.PositionAchieved">
        <Values>
          <Value cdm="Condition.NotAchieved">0</Value>
          <Value cdm="Condition.Achieved">1</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="speedAchieved" name="목표 속도 오차 만족 여부" cdm="Autonomy.Waypoint.SpeedAchieved">
        <Values>
          <Value cdm="Condition.NotAchieved">0</Value>
          <Value cdm="Condition.Achieved">1</Value>
        </Values>
      </ValueSetSpec>
      <!--WaypointTrackingExecutionStatus.arrivalTime은 unsigned long long이지만 원문에 시간 인코딩/기준이 없어 Unit/Converter를 정의하지 않는다.-->
    </GroupSpec>
    <GroupSpec id="globalHoverExecutionStatus" name="목표해점위치고정 수행 상태" cdm="Autonomy.GlobalHover.Execution">
      <ValueSetSpec id="globalHoverState" name="DP 상태" cdm="Autonomy.GlobalHover.State">
        <Values>
          <Value cdm="Autonomy.GlobalHover.State.Preparing">0</Value>
          <Value cdm="Autonomy.GlobalHover.State.Started">1</Value>
          <Value cdm="Autonomy.GlobalHover.State.Completed">2</Value>
        </Values>
      </ValueSetSpec>
      <QuantitySpec id="firstAchievedTime" name="첫 도달시간" cdm="Autonomy.GlobalHover.FirstAchievedTime"/>
      <QuantitySpec id="expectedCompletionTime" name="예상 완료시간" cdm="Autonomy.GlobalHover.ExpectedCompletionTime"/>
      <ValueSetSpec id="headingAchieved" name="선수각 만족 여부" cdm="Autonomy.GlobalHover.HeadingAchieved">
        <Values>
          <Value cdm="Condition.NotAchieved">0</Value>
          <Value cdm="Condition.Achieved">1</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="hoverRadiusAchieved" name="반경 만족 여부" cdm="Autonomy.GlobalHover.RadiusAchieved">
        <Values>
          <Value cdm="Condition.NotAchieved">0</Value>
          <Value cdm="Condition.Achieved">1</Value>
        </Values>
      </ValueSetSpec>
      <QuantitySpec id="distancePointRemaining" name="목표해점과의 떨어진 거리" cdm="Autonomy.GlobalHover.DistanceToPoint"/>
      <QuantitySpec id="errorYawAngle" name="목표 선수각과의 오차" cdm="Autonomy.GlobalHover.YawError"/>
      <ValueSetSpec id="possible" name="임무 수행 가능 여부" cdm="Autonomy.GlobalHover.Possible">
        <Values>
          <Value cdm="Mission.Availability.Possible">0</Value>
          <Value cdm="Mission.Availability.Impossible">1</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="missionState" name="임무 진행 상태" cdm="Autonomy.GlobalHover.MissionState">
        <Values>
          <Value cdm="Mission.Execution.Executing">0</Value>
          <Value cdm="Mission.Execution.Ended">1</Value>
          <Value cdm="Mission.Execution.Standby">2</Value>
        </Values>
      </ValueSetSpec>
      <!--timeHoverCompleted는 설명의 "유지 시간"과 비고의 "완료될 것으로 추정되는 절대 시간"이 충돌한다. 본 Semantic에서는 expectedCompletionTime 의미로 두되 인코딩/단위는 확정하지 않는다.-->
      <!--distancePointRemaining 및 errorYawAngle은 원문 Unit 미기재. m/deg/rad를 추정하지 않고 Unit 미지정으로 유지한다.-->
      <!--headingAchieved/hoverRadiusAchieved 0/1 의미는 필드 의미에 따라 0=NotAchieved, 1=Achieved로 잠정 정의하며 원작자 확인 시 수정 가능하다.-->
    </GroupSpec>
    <GroupSpec id="targetTrackingExecutionStatus" name="표적 추종 수행 상태" cdm="Autonomy.TargetTracking.Execution">
      <QuantitySpec id="distanceTargetRemaining" name="표적과의 이격 거리" cdm="Autonomy.TargetTracking.DistanceToTarget"/>
      <ValueSetSpec id="targetTrackingAchieved" name="표적 이격거리 도달 여부" cdm="Autonomy.TargetTracking.Achieved">
        <Values>
          <Value cdm="Condition.NotAchieved">0</Value>
          <Value cdm="Condition.Achieved">1</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="possible" name="임무 수행 가능 여부" cdm="Autonomy.TargetTracking.Possible">
        <Values>
          <Value cdm="Mission.Availability.Possible">0</Value>
          <Value cdm="Mission.Availability.Impossible">1</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="missionState" name="임무 진행 상태" cdm="Autonomy.TargetTracking.MissionState">
        <Values>
          <Value cdm="Mission.Execution.Executing">0</Value>
          <Value cdm="Mission.Execution.Ended">1</Value>
          <Value cdm="Mission.Execution.Standby">2</Value>
        </Values>
      </ValueSetSpec>
      <!--distanceTargetRemaining은 원문 Unit 미기재이므로 Unit을 비워 둔다.-->
      <!--targetTrackingAchieved 0/1 의미는 0=NotAchieved, 1=Achieved로 잠정 정의한다.-->
    </GroupSpec>
    <GroupSpec id="pointAndGoExecutionStatus" name="Point &amp; Go 수행 상태" cdm="Autonomy.PointAndGo.Execution">
      <ValueSetSpec id="missionState" name="임무 진행 상태" cdm="Autonomy.PointAndGo.MissionState">
        <Values>
          <Value cdm="Mission.Execution.Executing">0</Value>
          <Value cdm="Mission.Execution.Ended">1</Value>
          <Value cdm="Mission.Execution.Standby">2</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="possible" name="임무 수행 가능 여부" cdm="Autonomy.PointAndGo.Possible">
        <Values>
          <Value cdm="Mission.Availability.Possible">0</Value>
          <Value cdm="Mission.Availability.Impossible">1</Value>
        </Values>
      </ValueSetSpec>
      <QuantitySpec id="distanceToWaypoint" name="현재 경로점 남은 거리" cdm="Autonomy.PointAndGo.DistanceToWaypoint">
        <Unit>m</Unit>
      </QuantitySpec>
    </GroupSpec>
    <GroupSpec id="autonomousNavigationExecutionStatus" name="자동운항 수행 상태" cdm="Autonomy.Navigation.Execution">
      <ValueSetSpec id="missionState" name="임무 진행 상태" cdm="Autonomy.Navigation.MissionState">
        <Values>
          <Value cdm="Mission.Execution.Executing">0</Value>
          <Value cdm="Mission.Execution.Ended">1</Value>
          <Value cdm="Mission.Execution.Standby">2</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="possible" name="임무 수행 가능 여부" cdm="Autonomy.Navigation.Possible">
        <Values>
          <Value cdm="Mission.Availability.Possible">0</Value>
          <Value cdm="Mission.Availability.Impossible">1</Value>
        </Values>
      </ValueSetSpec>
      <QuantitySpec id="distanceRemaining" name="전체 남은 거리" cdm="Autonomy.Navigation.DistanceRemaining">
        <Unit>m</Unit>
      </QuantitySpec>
    </GroupSpec>
    <GroupSpec id="autonomousDockingExecutionStatus" name="자동접안 수행 상태" cdm="Autonomy.Docking.Execution">
      <ValueSetSpec id="missionState" name="임무 진행 상태" cdm="Autonomy.Docking.MissionState">
        <Values>
          <Value cdm="Mission.Execution.Executing">0</Value>
          <Value cdm="Mission.Execution.Ended">1</Value>
          <Value cdm="Mission.Execution.Standby">2</Value>
        </Values>
      </ValueSetSpec>
      <ValueSetSpec id="possible" name="임무 수행 가능 여부" cdm="Autonomy.Docking.Possible">
        <Values>
          <Value cdm="Mission.Availability.Possible">0</Value>
          <Value cdm="Mission.Availability.Impossible">1</Value>
        </Values>
      </ValueSetSpec>
      <QuantitySpec id="distanceRemaining" name="전체 남은 거리" cdm="Autonomy.Docking.DistanceRemaining">
        <Unit>m</Unit>
      </QuantitySpec>
      <!--원문 AutonomousDocking distanceRemaining의 Unit은 미기재이나 동일 필드명/설명/비고의 AutonomousNavigation distanceRemaining이 m로 정의되어 있어 m를 적용한다.-->
    </GroupSpec>
    <GroupSpec id="anuCbitStatus" name="자율운항제어카드 CBIT 상태" cdm="Health.CBIT.AutonomousNavigation">
      <ValueSetSpec id="operationalStatus" name="자율운항제어카드 작동 상태" cdm="Health.CBIT.AutonomousNavigation.Status">
        <Values>
          <Value cdm="Health.Status.Normal">0</Value>
          <Value cdm="Health.Status.Degraded">1</Value>
          <Value cdm="Health.Status.Unavailable">2</Value>
          <Value cdm="Health.Status.NoResponse">3</Value>
        </Values>
      </ValueSetSpec>
    </GroupSpec>
    <GroupSpec id="collisionUnavoidable" name="충돌회피 불가 상태" cdm="Autonomy.CollisionAvoidance">
      <ValueSetSpec id="collisionAvoidanceFail" name="충돌회피 가능 여부" cdm="Autonomy.CollisionAvoidance.Status">
        <Values>
          <Value cdm="Autonomy.CollisionAvoidance.Possible">0</Value>
          <Value cdm="Autonomy.CollisionAvoidance.Impossible">1</Value>
        </Values>
      </ValueSetSpec>
    </GroupSpec>
    <GroupSpec id="fuelLowWarning" name="잔여연료 부족 경고" cdm="Platform.Fuel.Warning">
      <ValueSetSpec id="alertFuel" name="연료 부족 상태" cdm="Platform.Fuel.Alert">
        <Values>
          <Value cdm="Platform.Fuel.Alert.Low">0</Value>
          <Value cdm="Platform.Fuel.Alert.Critical">1</Value>
        </Values>
      </ValueSetSpec>
      <QuantitySpec id="fuelQuantityRemain" name="잔여연료 정량적 수치" cdm="Platform.Fuel.QuantityRemaining"/>
      <QuantitySpec id="fuelQuantityPercent" name="잔여연료 비율" cdm="Platform.Fuel.PercentRemaining">
        <Range min="0" max="100"/>
      </QuantitySpec>
      <QuantitySpec id="alertTime" name="경고시간" cdm="Platform.Fuel.AlertTime"/>
      <!--fuelQuantityRemain 및 fuelQuantityPercent는 원문 Unit 미기재. fuelQuantityPercent는 Range 0~100만 반영한다. alertTime은 unsigned long long이며 비고에 년/월/일/시/분/초만 기재되어 인코딩 방식이 불명확하므로 Unit/Converter 미정.-->
    </GroupSpec>
    <CollectionSpec id="allMissionWaypointData" name="전체 임무계획 경로점 정보" cdm="Autonomy.Mission.Plan.AllPoints" minOccurs="0" maxOccurs="512">
      <ElementSpec id="commonMissionData" name="공용 임무 데이터" cdm="Autonomy.Mission.Plan.Point">
        <QuantitySpec id="missionID" name="미션 ID" cdm="Autonomy.Mission.Plan.MissionID"/>
        <ValueSetSpec id="missionType" name="임무 종류" cdm="Autonomy.Mission.Type">
          <Values>
            <Value cdm="Autonomy.Mission.Type.Waypoint">0</Value>
            <Value cdm="Autonomy.Mission.Type.GlobalHover">1</Value>
            <Value cdm="Autonomy.Mission.Type.TargetTracking">2</Value>
            <Value cdm="Autonomy.Mission.Type.PointAndGo">3</Value>
            <Value cdm="Autonomy.Mission.Type.AutonomousNavigation">4</Value>
            <Value cdm="Autonomy.Mission.Type.SurfaceReconnaissance">5</Value>
            <Value cdm="Autonomy.Mission.Type.UnderwaterReconnaissance">6</Value>
            <Value cdm="Autonomy.Mission.Type.AutonomousDocking">7</Value>
          </Values>
        </ValueSetSpec>
        <QuantitySpec id="latitude" name="경로점 위도" cdm="Autonomy.Mission.Plan.Point.Latitude">
          <Unit>deg</Unit>
          <Range min="-90" max="90"/>
        </QuantitySpec>
        <QuantitySpec id="longitude" name="경로점 경도" cdm="Autonomy.Mission.Plan.Point.Longitude">
          <Unit>deg</Unit>
          <Range min="-180" max="180"/>
        </QuantitySpec>
        <QuantitySpec id="desiredVelocity" name="운용속도" cdm="Autonomy.Mission.Plan.Point.DesiredVelocity">
          <Unit>m/s</Unit>
        </QuantitySpec>
        <QuantitySpec id="goalErrorTolerance" name="목표점 허용오차" cdm="Autonomy.Mission.Plan.Point.GoalErrorTolerance">
          <Unit>m</Unit>
        </QuantitySpec>
        <QuantitySpec id="pointIndex" name="포인트 번호" cdm="Autonomy.Mission.Plan.Point.Index"/>
        <QuantitySpec id="totalPointNum" name="미션 내 총 포인트 개수" cdm="Autonomy.Mission.Plan.TotalPointCount"/>
      </ElementSpec>
    </CollectionSpec>
  </MonitorSpecs>
  <ControlSpecs id="control">
    <ControlSpec id="startIntegration" name="연동 개시" cdm="Control.Autonomy.Integration.Start">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply bindRef="startIntegrationAck" cdm="Control.Autonomy.Integration.Start.Response" required="true"/>
    </ControlSpec>
    <ControlSpec id="restartSystem" name="자율운항장치 시스템 재시작" cdm="Control.Autonomy.System.Restart">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply bindRef="restartSystemAck" cdm="Control.Autonomy.System.Restart.Response" required="true"/>
    </ControlSpec>
    <ControlSpec id="requestPbit" name="자율운항장치 PBIT 요청" cdm="Control.Autonomy.PBIT.Request">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply bindRef="requestPbitAck" cdm="Control.Autonomy.PBIT.Request.Response" required="true"/>
      <Reply bindRef="requestPbitResult" cdm="Control.Autonomy.PBIT.Result"/>
    </ControlSpec>
    <ControlSpec id="requestIbit" name="자율운항장치 IBIT 요청" cdm="Control.Autonomy.IBIT.Request">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Reply bindRef="requestIbitAck" cdm="Control.Autonomy.IBIT.Request.Response" required="true"/>
      <Reply bindRef="requestIbitResult" cdm="Control.Autonomy.IBIT.Result"/>
    </ControlSpec>
    <ControlSpec id="recordWaypointMission" name="경로점 레코드 설정" cdm="Control.Autonomy.Mission.Record.Waypoint">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Parameters>
        <CollectionProfile cdm="Autonomy.Mission.Record.CommonMissionDataSequence" minOccurs="0" maxOccurs="256">
          <ElementProfile cdm="Autonomy.Mission.Record.CommonMissionData">
            <QuantityProfile cdm="Autonomy.Mission.Record.MissionID"/>
            <QuantityProfile cdm="Autonomy.Mission.Record.Latitude">
              <Unit>deg</Unit>
              <Range min="-90" max="90"/>
            </QuantityProfile>
            <QuantityProfile cdm="Autonomy.Mission.Record.Longitude">
              <Unit>deg</Unit>
              <Range min="-180" max="180"/>
            </QuantityProfile>
            <QuantityProfile cdm="Autonomy.Mission.Record.DesiredVelocity">
              <Unit>m/s</Unit>
            </QuantityProfile>
            <QuantityProfile cdm="Autonomy.Mission.Record.GoalErrorTolerance">
              <Unit>m</Unit>
            </QuantityProfile>
            <QuantityProfile cdm="Autonomy.Mission.Record.PointIndex"/>
            <QuantityProfile cdm="Autonomy.Mission.Record.TotalPointCount"/>
          </ElementProfile>
        </CollectionProfile>
        <QuantityProfile cdm="Autonomy.Mission.Record.EndAction">
          <Range min="0" max="1"/>
        </QuantityProfile>
        <QuantityProfile cdm="Autonomy.Mission.Record.LateralErrorTolerance">
          <Unit>m</Unit>
        </QuantityProfile>
      </Parameters>
      <!--missionType은 HMI 입력값이 아니며 이 Control에 대응하는 고정값 0을 Binding에서 설정한다.-->
      <Reply bindRef="recordWaypointMissionAck" cdm="Control.Autonomy.Mission.Record.Waypoint.CommandStatus" required="true"/>
      <Reply bindRef="recordWaypointMissionRecordAck" cdm="Control.Autonomy.Mission.Record.Waypoint.RecordEcho" required="true"/>
    </ControlSpec>
    <ControlSpec id="recordGlobalHoverMission" name="목표해점위치고정 레코드 설정" cdm="Control.Autonomy.Mission.Record.GlobalHover">
      <Target cdm="Platform.Identifier.Numeric"/>
      <Parameters>
        <QuantityProfile cdm="Autonomy.Mission.Record.MissionID"/>
        <QuantityProfile cdm="Autonomy.Mission.Record.Latitude">
          <Unit>deg</Unit>
          <Range min="-90" max="90"/>
        </QuantityProfile>
        <QuantityProfile cdm="Autonomy.Mission.Record.Longitude">
          <Unit>deg</Unit>
          <Range min="-180" max="180"/>
        </QuantityProfile>
        <QuantityProfile cdm="Autonomy.Mission.Record.DesiredVelocity">
