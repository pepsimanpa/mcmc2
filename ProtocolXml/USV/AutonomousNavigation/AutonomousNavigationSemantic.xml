      <Reply bindRef="recordTargetTrackingMissionAck" cdm="Control.Autonomy.Mission.Record.TargetTracking.CommandStatus" required="true"/>
      <Reply bindRef="recordTargetTrackingMissionRecordAck" cdm="Control.Autonomy.Mission.Record.TargetTracking.RecordEcho" required="true"/>
