        <ControlBindingDDS semantic_id="enterCommandStandby">
            <Channel topicName="RUSV::C2::RCU::OperationModeControlType" typeName="OperationModeControlType"/>
            <Field name="usvHeader"/>
            <!--
                OperationModeControl은 1-byte 공용 구조체이다.
                TBD: 현재 Binding XSD에 일반 struct 중첩 표현이 없어 "operationModeControlStatus.operationMode" dotted path를 잠정 사용한다.
