<?xml version="1.0" encoding="UTF-8"?>
<!--
    원격통제장치(HMI CSC/운용관리 CSC)에서 접근하는 중앙통제장치 원격 기능 Semantic.

    설계 범위
    - Semantic은 운용자가 중앙통제장치를 통해 수행/조회하는 기능 의미를 정의한다.
    - DDS Topic/Type, usvHeader, commandID, DestinationType 같은 물리/시스템 항목은 Binding 책임으로 둔다.
    - 중앙통제가 USV 내부 장치로 다시 배포하는 DDS는 본 파일의 원통↔중통 경계에서 제외한다.
    - RCUHeartBeatReportType(원통→중통 5 Hz)은 원격통제장치 생존정보이므로 중앙통제의 HMI 기능으로 노출하지 않는다.

    확정 사항
    - 운용모드 0~7은 각각 독립 Semantic Control로 노출한다. EA(비상조치)도 독립 Control이다.
    - 통제권 command 0~4는 각각 독립 Semantic Control로 노출한다.
    - PBIT/IBIT는 요청-결과 Reply로 표현한다.
    - USV HeartBeat, 중앙통제 CBIT, 통제권 소유정보는 Monitor로 표현한다.
    - CommandStatusReport는 실제 장비 동작 완료가 아니라 비주기 명령의 처리 상태로 해석한다.

    미확정 사항은 각 위치의 TBD 주석과 CentralControl_OpenIssues.md를 함께 참조한다.
-->
<PayloadSpec xmlns="http://lignex1.com/mcmc2/umsSchema"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://lignex1.com/mcmc2/umsSchema ../../XSD/CommonSpecSchema.xsd">
    <ConstantSpecs id="constant">
        <TextConstantSpec id="productName" name="제품명" cdm="Product.Name">
            <Value>USV Central Control Interface</Value>
        </TextConstantSpec>
        <TextConstantSpec id="productDescription" name="제품 설명" cdm="Product.Description">
            <Value>원격통제장치와 중앙통제장치 간 원격 제어·감시 Semantic</Value>
        </TextConstantSpec>
    </ConstantSpecs>

    <MonitorSpecs id="monitor">
        <!-- 중앙통제가 5 Hz로 제공하는 USV 종합 운용상태. 개별 장비 Semantic의 상세 상태와 중복될 수 있으나, 본 항목은 중통이 제공하는 플랫폼 종합 뷰이다. -->
        <GroupSpec id="usvOperationalStatus" name="무인수상정 종합 운용상태" cdm="Platform.OperationalStatus">
            <!-- CSV Range는 0~7이지만 의미가 명시된 값은 0=정상, 1=비정상 경고뿐이다. 2~7 의미는 정의하지 않는다. -->
            <ValueSetSpec id="operationalState" name="무인수상정 운용상태" cdm="Platform.OperationalState">
                <Values>
                    <Value name="Normal" cdm="Platform.OperationalState.Normal"/>
                    <Value name="Warning" cdm="Platform.OperationalState.Warning"/>
                </Values>
            </ValueSetSpec>
            <ValueSetSpec id="currentOperationMode" name="무인수상정 운용모드" cdm="Platform.OperationMode">
                <Values>
                    <Value name="EmergencyStop" cdm="Platform.OperationMode.EmergencyStop"/>
                    <Value name="EmergencyReturn" cdm="Platform.OperationMode.EmergencyReturn"/>
                    <Value name="RemoteManual" cdm="Platform.OperationMode.RemoteManual"/>
                    <Value name="LocalManual" cdm="Platform.OperationMode.LocalManual"/>
                    <Value name="Autonomous" cdm="Platform.OperationMode.Autonomous"/>
                    <Value name="CommandStandby" cdm="Platform.OperationMode.CommandStandby"/>
                    <Value name="Maintenance" cdm="Platform.OperationMode.Maintenance"/>
                    <Value name="EmergencyAction" cdm="Platform.OperationMode.EmergencyAction"/>
                </Values>
            </ValueSetSpec>
            <QuantitySpec id="latitude" name="무인수상정 위도" cdm="Navigation.Position.Latitude">
                <Unit>deg</Unit>
            </QuantitySpec>
            <QuantitySpec id="longitude" name="무인수상정 경도" cdm="Navigation.Position.Longitude">
                <Unit>deg</Unit>
            </QuantitySpec>
            <QuantitySpec id="course" name="무인수상정 침로" cdm="Navigation.Course">
                <Unit>rad</Unit>
            </QuantitySpec>
            <QuantitySpec id="groundSpeed" name="무인수상정 이동속력" cdm="Motion.GroundSpeed">
                <Unit>m/s</Unit>
            </QuantitySpec>
            <QuantitySpec id="roll" name="무인수상정 Roll" cdm="Attitude.Roll">
                <Unit>rad</Unit>
            </QuantitySpec>
            <QuantitySpec id="pitch" name="무인수상정 Pitch" cdm="Attitude.Pitch">
                <Unit>rad</Unit>
            </QuantitySpec>
            <ValueSetSpec id="autonomousMissionMode" name="자율운항 임무모드" cdm="Autonomy.Mission.Mode">
                <Values>
                    <Value name="WaypointNavigation" cdm="Autonomy.Mission.Mode.WaypointNavigation"/>
                    <Value name="TargetPointHold" cdm="Autonomy.Mission.Mode.TargetPointHold"/>
                    <Value name="TargetTracking" cdm="Autonomy.Mission.Mode.TargetTracking"/>
                    <Value name="PointAndGo" cdm="Autonomy.Mission.Mode.PointAndGo"/>
                    <Value name="AutomaticNavigation" cdm="Autonomy.Mission.Mode.AutomaticNavigation"/>
                    <Value name="SurfaceISR" cdm="Autonomy.Mission.Mode.SurfaceISR"/>
                    <Value name="UnderwaterISR" cdm="Autonomy.Mission.Mode.UnderwaterISR"/>
                    <Value name="AutomaticDocking" cdm="Autonomy.Mission.Mode.AutomaticDocking"/>
                </Values>
            </ValueSetSpec>
            <ValueSetSpec id="eoirOperationMode" name="전자광학장치 운용모드" cdm="Sensor.EOIR.OperationMode">
                <Values>
                    <Value name="Standby" cdm="Sensor.EOIR.OperationMode.Standby"/>
                    <Value name="ManualTracking" cdm="Sensor.EOIR.OperationMode.ManualTracking"/>
                    <Value name="AutomaticTracking" cdm="Sensor.EOIR.OperationMode.AutomaticTracking"/>
                    <Value name="RadarSlave" cdm="Sensor.EOIR.OperationMode.RadarSlave"/>
                    <Value name="BowPointing" cdm="Sensor.EOIR.OperationMode.BowPointing"/>
                    <Value name="SwingGuard" cdm="Sensor.EOIR.OperationMode.SwingGuard"/>
                    <Value name="RCWSLinked" cdm="Sensor.EOIR.OperationMode.RCWSLinked"/>
                    <Value name="StowProtect" cdm="Sensor.EOIR.OperationMode.StowProtect"/>
                    <Value name="BuiltInTest" cdm="Sensor.EOIR.OperationMode.BuiltInTest"/>
                </Values>
            </ValueSetSpec>
            <ValueSetSpec id="towedSonarOperationMode" name="예인형수중탐색장치 운용모드" cdm="Sensor.TowedSonar.OperationMode">
                <Values>
                    <Value name="Automatic" cdm="Sensor.TowedSonar.OperationMode.Automatic"/>
                    <Value name="Standby" cdm="Sensor.TowedSonar.OperationMode.Standby"/>
                    <Value name="ManualLaunch" cdm="Sensor.TowedSonar.OperationMode.ManualLaunch"/>
                    <Value name="ManualRecovery" cdm="Sensor.TowedSonar.OperationMode.ManualRecovery"/>
                    <Value name="ManualPayOut" cdm="Sensor.TowedSonar.OperationMode.ManualPayOut"/>
                    <Value name="EmergencyStop" cdm="Sensor.TowedSonar.OperationMode.EmergencyStop"/>
                    <Value name="CableRelease" cdm="Sensor.TowedSonar.OperationMode.CableRelease"/>
                </Values>
            </ValueSetSpec>
            <ValueSetSpec id="rcwsOperationMode" name="원격사격통제장치 운용모드" cdm="Weapon.RCWS.OperationMode">
                <Values>
                    <Value name="Safe" cdm="Weapon.RCWS.OperationMode.Safe"/>
                    <Value name="Fire" cdm="Weapon.RCWS.OperationMode.Fire"/>
                    <Value name="Feed" cdm="Weapon.RCWS.OperationMode.Feed"/>
                    <Value name="Protect" cdm="Weapon.RCWS.OperationMode.Protect"/>
                </Values>
            </ValueSetSpec>
        </GroupSpec>

        <GroupSpec id="centralControlHealth" name="중앙통제장치 상태" cdm="Health.CBIT.CentralControl">
            <ValueSetSpec id="operationalStatus" name="중앙통제장치 운용상태" cdm="Health.OperationalStatus">
                <Values>
                    <Value name="Normal" cdm="OperationalState.Normal"/>
                    <Value name="Degraded" cdm="OperationalState.Degraded"/>
                    <Value name="Unavailable" cdm="OperationalState.Unavailable"/>
                    <Value name="NoResponse" cdm="OperationalState.NoResponse"/>
                </Values>
            </ValueSetSpec>
        </GroupSpec>

        <GroupSpec id="controlAuthorityStatus" name="현재 통제권 소유정보" cdm="Control.Authority.Status">
            <ValueSetSpec id="currentController" name="현재 통제권 소유주체" cdm="Control.Authority.Owner">
                <Values>
                    <Value name="USV" cdm="Control.Authority.Owner.USV"/>
                    <Value name="FixedRemoteControl" cdm="Control.Authority.Owner.FixedRemoteControl"/>
                    <Value name="MobileRemoteControl" cdm="Control.Authority.Owner.MobileRemoteControl"/>
                    <Value name="PortAssistControl" cdm="Control.Authority.Owner.PortAssistControl"/>
                    <Value name="MaintenanceLaptop" cdm="Control.Authority.Owner.MaintenanceLaptop"/>
                </Values>
            </ValueSetSpec>
        </GroupSpec>
    </MonitorSpecs>

    <ControlSpecs id="control">
        <ControlSpec id="startIntegration" name="연동 개시" cdm="Control.Equipment.Integration.Start">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="startIntegrationCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>

        <ControlSpec id="restartSystem" name="중앙통제장치 재시작" cdm="Control.Equipment.Restart">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="restartSystemCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>

        <!-- PBIT 요청은 원통의 비주기 RCUPBITControlType에 의해 수행된다. 중앙통제 CSCI의 MCEPBITReportType 주기가 1 Hz로 적혀 있으나, 타 장비 PBIT 패턴과 상충하므로 Request/Reply로 해석한다. -->
        <ControlSpec id="requestPbit" name="중앙통제장치 PBIT 요청" cdm="Request.Health.PBIT">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="requestPbitCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
            <Reply cdm="Request.Health.PBIT.Response" bindRef="requestPbitResultReply" required="true">
                <Results>
                    <ValueSetResult name="operationalStatus" cdm="Health.OperationalStatus">
                        <Values>
                            <Value name="Normal" cdm="OperationalState.Normal"/>
                            <Value name="Degraded" cdm="OperationalState.Degraded"/>
                            <Value name="Unavailable" cdm="OperationalState.Unavailable"/>
                            <Value name="NoResponse" cdm="OperationalState.NoResponse"/>
                        </Values>
                    </ValueSetResult>
                </Results>
            </Reply>
        </ControlSpec>

        <ControlSpec id="requestIbit" name="중앙통제장치 IBIT 요청" cdm="Request.Health.IBIT">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="requestIbitCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
            <Reply cdm="Request.Health.IBIT.Response" bindRef="requestIbitResultReply" required="true">
                <Results>
                    <GroupResult name="mceIbit" cdm="Health.IBIT.CentralControl">
                        <ValueSetResult name="operationalStatus" cdm="Health.OperationalStatus">
                            <Values>
                                <Value name="Normal" cdm="OperationalState.Normal"/>
                                <Value name="Degraded" cdm="OperationalState.Degraded"/>
                                <Value name="Unavailable" cdm="OperationalState.Unavailable"/>
                                <Value name="NoResponse" cdm="OperationalState.NoResponse"/>
                            </Values>
                        </ValueSetResult>
                        <QuantityResult name="cpuTemperature" cdm="Health.Processor.CPU.Temperature">
                            <Unit>degC</Unit>
                            <Range min="20" max="100"/>
                        </QuantityResult>
                        <QuantityResult name="cpuLoad" cdm="Health.Processor.CPU.Load">
                            <Unit>percent</Unit>
                            <Range min="0" max="100"/>
                        </QuantityResult>
                    </GroupResult>
                </Results>
            </Reply>
        </ControlSpec>

        <!--
            Preset 의미값과 물리 위치를 분리한다.
            topology: 고송신/저송신, mission: 탐지/소나/무장/중계.
            각 1-byte 물리 필드의 Bit 7~6 매핑은 Binding의 PackedField/BitMember로 선언한다.
        -->
        <ControlSpec id="configureWirelessPreset" name="무선통신 Preset 설정" cdm="Control.Communication.WirelessPreset">
            <Parameters>
                <ValueSetProfile cdm="Communication.WirelessPreset.TopologyMode">
                    <Values>
                        <Value name="HighTransmit" cdm="Communication.WirelessPreset.TopologyMode.HighTransmit"/>
                        <Value name="LowTransmit" cdm="Communication.WirelessPreset.TopologyMode.LowTransmit"/>
                    </Values>
                </ValueSetProfile>
                <ValueSetProfile cdm="Communication.WirelessPreset.MissionMode">
                    <Values>
                        <Value name="Detection" cdm="Communication.WirelessPreset.MissionMode.Detection"/>
                        <Value name="Sonar" cdm="Communication.WirelessPreset.MissionMode.Sonar"/>
                        <Value name="Weapon" cdm="Communication.WirelessPreset.MissionMode.Weapon"/>
                        <Value name="Relay" cdm="Communication.WirelessPreset.MissionMode.Relay"/>
                    </Values>
                </ValueSetProfile>
            </Parameters>
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="configureWirelessPresetCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>

        <!-- OperationModeControl.operationMode 0~7을 서로 다른 운용자 동작으로 분리한다. -->
        <ControlSpec id="emergencyStop" name="무인수상정 비상정지" cdm="Control.Platform.EmergencyStop">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="emergencyStopCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
        <ControlSpec id="emergencyReturn" name="무인수상정 비상복귀" cdm="Control.Platform.EmergencyReturn">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="emergencyReturnCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
        <ControlSpec id="enterRemoteManualMode" name="원격수동조작 모드 진입" cdm="Control.Platform.OperationMode.RemoteManual">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="enterRemoteManualModeCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
        <ControlSpec id="enterLocalManualMode" name="근거리수동조작 모드 진입" cdm="Control.Platform.OperationMode.LocalManual">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="enterLocalManualModeCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
        <ControlSpec id="enterAutonomousMode" name="자율운항 모드 진입" cdm="Control.Platform.OperationMode.Autonomous">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="enterAutonomousModeCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
        <ControlSpec id="enterCommandStandby" name="명령대기 모드 진입" cdm="Control.Platform.OperationMode.CommandStandby">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="enterCommandStandbyCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
        <ControlSpec id="enterMaintenanceMode" name="정비 모드 진입" cdm="Control.Platform.OperationMode.Maintenance">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="enterMaintenanceModeCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
        <ControlSpec id="executeEmergencyAction" name="비상조치 수행" cdm="Control.Platform.EmergencyAction">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="executeEmergencyActionCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>

        <!--
            AuthorityControl.command 0~4를 기능별로 분리한다.
            commandTarget은 command=0(통제권 전환 대기)에서만 의미 있는 운용자 입력으로 노출한다.
            AuthorityControl.destination의 정확한 명령별 값 결정 규칙은 미확정이며 HMI 입력으로 노출하지 않는다.
        -->
        <ControlSpec id="prepareAuthorityTransfer" name="통제권 전환 대기" cdm="Control.Authority.Transfer.Prepare">
            <Parameters>
                <ValueSetProfile cdm="Control.Authority.TargetControlStation">
                    <Values>
                        <Value name="FixedRemoteControl" cdm="Control.Authority.TargetControlStation.FixedRemoteControl"/>
                        <Value name="MobileRemoteControl" cdm="Control.Authority.TargetControlStation.MobileRemoteControl"/>
                        <Value name="PortAssistControl" cdm="Control.Authority.TargetControlStation.PortAssistControl"/>
                    </Values>
                </ValueSetProfile>
            </Parameters>
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="prepareAuthorityTransferCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
        <ControlSpec id="requestControlAuthority" name="통제권 요청" cdm="Request.Control.Authority">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="requestControlAuthorityCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
        <ControlSpec id="approveControlAuthorityRequest" name="통제권 요청 승인" cdm="Control.Authority.Request.Approve">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="approveControlAuthorityRequestCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
        <ControlSpec id="rejectControlAuthorityRequest" name="통제권 요청 거절" cdm="Control.Authority.Request.Reject">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="rejectControlAuthorityRequestCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
        <ControlSpec id="reclaimControlAuthority" name="통제권 회수" cdm="Control.Authority.Reclaim">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="reclaimControlAuthorityCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>

        <!-- rxChannel의 허용 채널/주파수 범위와 단위가 CSV에 없어 Range/Unit을 지정하지 않는다. -->
        <ControlSpec id="controlVhf" name="음성송수신기 VHF 제어" cdm="Control.Communication.VHF">
            <Parameters>
                <ValueSetProfile cdm="Communication.VHF.TransmitCommand">
                    <Values>
                        <Value name="Stop" cdm="Communication.VHF.TransmitCommand.Stop"/>
                        <Value name="Transmit" cdm="Communication.VHF.TransmitCommand.Transmit"/>
                    </Values>
                </ValueSetProfile>
                <QuantityProfile cdm="Communication.VHF.Channel">
                    <Resolution>1</Resolution>
                </QuantityProfile>
            </Parameters>
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="controlVhfCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>

        <ControlSpec id="setVoiceVolume" name="음성송수신기 볼륨 설정" cdm="Control.Communication.Voice.Volume">
            <Parameters>
                <QuantityProfile cdm="Communication.Voice.Volume.Percent">
                    <Unit>percent</Unit>
                    <Range min="0" max="100"/>
                    <Resolution>1</Resolution>
                </QuantityProfile>
            </Parameters>
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="setVoiceVolumeCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>

        <ControlSpec id="setVhfSquelch" name="음성송수신기 VHF 스퀄치 설정" cdm="Control.Communication.VHF.Squelch">
            <Parameters>
                <QuantityProfile cdm="Communication.VHF.Squelch.Percent">
                    <Unit>percent</Unit>
                    <Range min="0" max="100"/>
                    <Resolution>1</Resolution>
                </QuantityProfile>
            </Parameters>
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="setVhfSquelchCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>

        <!-- voiceRxControl은 필드명/설명이 '음성수신명령'이지만 CSV 비고는 raw 1을 '송신'으로 적고 있어 논리 의미를 확정하지 않는다. -->
        <ControlSpec id="configureVoiceCommunication" name="음성 송수신 제어" cdm="Control.Communication.Voice">
            <Parameters>
                <ValueSetProfile cdm="Communication.Voice.AlarmTransmit">
                    <Values>
                        <Value name="Stop" cdm="Communication.Voice.AlarmTransmit.Stop"/>
                        <Value name="Transmit" cdm="Communication.Voice.AlarmTransmit.Transmit"/>
                    </Values>
                </ValueSetProfile>
                <ValueSetProfile cdm="Communication.Voice.Transmit">
                    <Values>
                        <Value name="Stop" cdm="Communication.Voice.Transmit.Stop"/>
                        <Value name="Transmit" cdm="Communication.Voice.Transmit.Transmit"/>
                    </Values>
                </ValueSetProfile>
                <Profile cdm="Communication.Voice.Receive"/>
            </Parameters>
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="configureVoiceCommunicationCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>

        <!-- videoTransmitType: 0=중지, 1~4=감시#1~#4. 중지는 선택 제어와 분리한다. -->
        <ControlSpec id="stopVideoDistribution" name="영상분배 중지" cdm="Control.Video.Distribution.Stop">
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="stopVideoDistributionCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>

        <ControlSpec id="selectVideoDistribution" name="영상분배 선택" cdm="Control.Video.Distribution">
            <Parameters>
                <ValueSetProfile cdm="Video.Distribution.Selection">
                    <Values>
                        <Value name="Monitor1" cdm="Video.Distribution.Selection.Monitor1"/>
                        <Value name="Monitor2" cdm="Video.Distribution.Selection.Monitor2"/>
                        <Value name="Monitor3" cdm="Video.Distribution.Selection.Monitor3"/>
                        <Value name="Monitor4" cdm="Video.Distribution.Selection.Monitor4"/>
                    </Values>
                </ValueSetProfile>
            </Parameters>
            <Reply cdm="Command.ProcessingStatus.Response" bindRef="selectVideoDistributionCommandStatusReply" required="true">
                <Results>
                    <Result name="commandStatusReport.status" cdm="Control.Response.Status"/>
                </Results>
            </Reply>
        </ControlSpec>
    </ControlSpecs>
</PayloadSpec>