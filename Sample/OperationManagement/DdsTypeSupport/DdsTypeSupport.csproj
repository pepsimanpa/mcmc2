<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <Version>0.0.1.0</Version>
  </PropertyGroup>

  <Target Name="RunRtiddsgen" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="call &quot;$(ProjectDir)gen_all_idl.bat&quot;" />
  </Target>

  <ItemGroup>
    <Compile Remove="AutoGenerated\**\*.cs" />
    <Compile Include="AutoGenerated\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rti.ConnextDds" Version="7.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="AutoGenerated\" />
  </ItemGroup>

</Project>
