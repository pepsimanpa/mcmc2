 module Types
 {
    const string REGISTER_PRODUCER_CONTRACT_SERVICE = "RegisterProducerContract";
    const string COMMAND_REGISTER_PRODUCER_CONTRACT_TOPIC = "commandRegisterProducerContract";
    const string RESPONSE_REGISTER_PRODUCER_CONTRACT_TOPIC = "responseRegisterProducerContract";

    enum SensorProductKind {
        SideScanSonarRaw,
        SideScanSonarProcessed
    };

    enum ResponseCode {
        OK,
        Failed
    };

    struct RegisterCommandType {
        @key
        int32 messageId;
        @key
        int32 producerId;
        SensorProductKind serviceSensorProduct;
    };

    struct RegisterResponseType {
        @key
        int32 messageId;
        @key
        int32 producerId;
        ResponseCode responseCode;
    };
 };


